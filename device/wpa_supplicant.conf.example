# WiFi configuration template (NO credentials included).
# Copy to /etc/wpa_supplicant/wpa_supplicant.conf and add your own network.
# The sterile ROM ships this EMPTY template only.

ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev
update_config=1
country=IT

