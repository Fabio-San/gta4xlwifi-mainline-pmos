# Power bring-up: suspend-to-idle, SM5713 and real battery thermistor.
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_I2C=y
CONFIG_I2C_GPIO=y
CONFIG_I2C_CHARDEV=y
CONFIG_IIO=y
CONFIG_EXYNOS9610_ADC=y
CONFIG_EXYNOS9610_CHUB=m
CONFIG_POWER_SUPPLY=y
CONFIG_GTA4XL_SM5713_POWER=y

# CPU DVFS: ACPM performs coordinated clock/voltage transitions.
CONFIG_EXYNOS_ACPM_CLK=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
