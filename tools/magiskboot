#!/usr/bin/env python3
"""Minimal magiskboot-compatible unpack/repack using AOSP boot tools."""
import sys, os, subprocess, shutil, shlex

AOSP = os.path.expanduser("~/gta4xl-build/workdir/downloads/android_system_tools_mkbootimg")
UNPACK = os.path.join(AOSP, "unpack_bootimg.py")
MK = os.path.join(AOSP, "mkbootimg.py")
REPL = {"--kernel": "kernel", "--ramdisk": "ramdisk.cpio", "--dtb": "dtb"}

def unpack(img):
    subprocess.run([sys.executable, UNPACK, "--boot_img", img, "--out", "."],
                   check=True, stdout=subprocess.DEVNULL)
    for name in ("ramdisk", "ramdisk.cpio", "ramdisk.gz"):
        if os.path.exists(name):
            if name != "ramdisk.cpio":
                shutil.copy2(name, "ramdisk.cpio")
            break
    out = subprocess.run([sys.executable, UNPACK, "--boot_img", img, "--format=mkbootimg"],
                         capture_output=True, text=True, check=True).stdout
    line = next((l for l in out.splitlines() if l.strip().startswith("--")), "")
    if not line:
        raise SystemExit("no mkbootimg args found")
    open("header.mkbootimg", "w").write(line.strip())

def repack(orig, out):
    args = shlex.split(open("header.mkbootimg").read().strip())
    newargs = [sys.executable, MK, "-o", out]
    i = 0
    while i < len(args):
        a = args[i]
        if a in REPL:
            newargs += [a, REPL[a]]
            i += 2          # consume the old value
        else:
            newargs.append(a)
            i += 1
    subprocess.run(newargs, check=True)

if __name__ == "__main__":
    if sys.argv[1] == "unpack": unpack(sys.argv[2])
    elif sys.argv[1] == "repack": repack(sys.argv[2], sys.argv[3])
    else: raise SystemExit("unknown cmd")
