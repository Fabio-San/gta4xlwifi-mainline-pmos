#!/bin/busybox sh
# Self-contained, bounded diagnostic boot; SD remains read-only.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
echo 'gta4xl-upstream: SCRIPT_ENTER' >/dev/kmsg
/bin/busybox --install -s /bin
# The native supervisor has mounted proc, sysfs and devtmpfs.
mkdir -p /dev/pts /run /tmp /sys/fs/pstore /sys/kernel/config
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
# keep this diagnostic boot alive (no ADB placeholder in our test build)
touch /run/keep-upstream
mount -t tmpfs tmpfs /tmp
mount -t pstore pstore /sys/fs/pstore
# Keep stdout/stderr on the supervisor's kernel log, including failed commands.
say() { echo "gta4xl-upstream: $*" >/dev/kmsg; }
say "INIT_REACHED $(uname -a)"
# Start the deadline before any potentially blocking peripheral setup.
(
    sleep 60
    while [ -e /run/keep-upstream ]; do sleep 5; done
    say 'SETUP_DEADLINE; resetting through syscon.'
    # reboot -f  # disabled for keep-alive test
) &
if [ -c /dev/watchdog0 ]; then
    watchdog -T 60 -t 5 /dev/watchdog0
fi
say "CPUs: $(cat /sys/devices/system/cpu/online)"
say "Block devices: $(ls /sys/class/block)"
say "USB controllers: $(ls /sys/class/udc 2>/dev/null)"
cat /proc/meminfo | head -5
cat /proc/interrupts | while IFS= read -r line; do echo "$line"; done
# Keep this test independent of the installed SD/cache filesystems.
# The dual-payload test image selects Alpine after this diagnostic's reset.
if [ -n "$(ls /sys/class/mmc_host 2>/dev/null)" ]; then
    for i in $(seq 1 100); do
        [ -b /dev/mmcblk0 ] && break
        sleep 0.1
    done
    if [ -b /dev/mmcblk0 ]; then
        blockdev --setro /dev/mmcblk0
        say "SD_FOUND $(blkid /dev/mmcblk0)"
        if dd if=/dev/mmcblk0 of=/dev/null bs=1048576 count=8; then
            say 'SD_READ_8M_OK'
        fi
    else
        say 'SD_NOT_DISCOVERED'
    fi
fi
if [ -n "$(ls /sys/class/udc 2>/dev/null)" ]; then
    mount -t configfs configfs /sys/kernel/config
    say 'USB_CONFIGFS_READY'
    g=/sys/kernel/config/usb_gadget/upstream
    mkdir -p "$g"
    echo 0x18d1 >"$g/idVendor"
    echo 0x4ee7 >"$g/idProduct"
    mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409"
    echo R52R50FM53D >"$g/strings/0x409/serialnumber"
    echo Samsung >"$g/strings/0x409/manufacturer"
    echo gta4xl-upstream-diagnostic >"$g/strings/0x409/product"
    echo 'Upstream diagnostic ADB' >"$g/configs/c.1/strings/0x409/configuration"
    echo 100 >"$g/configs/c.1/MaxPower"
    mkdir -p "$g/functions/ffs.adb" /dev/usb-ffs/adb
    mount -t functionfs adb /dev/usb-ffs/adb
    say 'USB_FUNCTIONFS_READY'
    /usr/sbin/adbd >/run/adbd.log 2>&1 &
    say "ADBD_STARTED $!"
    for i in $(seq 1 50); do
        [ -e /dev/usb-ffs/adb/ep1 ] && break
        sleep 0.1
    done
    if [ -e /dev/usb-ffs/adb/ep1 ]; then
        say 'ADB_ENDPOINTS_READY'
        ln -s "$g/functions/ffs.adb" "$g/configs/c.1/adb"
        udc=$(ls /sys/class/udc | head -1)
        say "USB_BIND_START $udc"
        echo "$udc" >"$g/UDC"
        say "USB_BOUND $udc"
    else
        say "ADB FunctionFS did not become ready"
    fi
fi
if [ -e /etc/gta4xl-upstream-desktop-test ]; then
    /usr/local/sbin/desktop-test >/run/desktop-setup.log 2>&1 &
fi
say 'Diagnostic boot will restart in 45 seconds unless /run/keep-upstream exists.' 
sleep 45
while [ -e /run/keep-upstream ]; do sleep 5; done
say 'TEST_COMPLETE; returning to normal boot.'
sync
# reboot -f  # disabled for keep-alive test
say 'RESET_FAILED'
while :; do sleep 60; done
