+
+properties:
+  compatible:
+    const: himax,hx83102e
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  spi-max-frequency:
+    maximum: 7000000
+
+  spi-cpol: true
+  spi-cpha: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - reset-gpios
+  - touchscreen-size-x
+  - touchscreen-size-y
+  - spi-cpol
+  - spi-cpha
+
+unevaluatedProperties: false
