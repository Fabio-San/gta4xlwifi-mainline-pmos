@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Himax HX83102E SPI touchscreen.
+ * SPI protocol and reset timing from Himax's GPLv2 Android driver (2019).
+ * Event layout and reporting adapted from himax_hx83112b.c:
+ * Copyright (C) 2022 Job Noorman <job@noorman.info>
+ * Copyright (C) 2024 Felix Kaechele <felix@kaechele.ca>
+ * This driver uses the controller's existing flash firmware.
+ */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pm.h>
+#include <linux/spi/spi.h>
+#include <linux/unaligned.h>
+
+#define HX83102E_ID		0x83102e
+#define HX83102E_POINTS		10
+#define HX83102E_ICID		0x900000d0
+#define HX83102E_EVENT_STACK	0x30
+
+struct hx83102e_point {
+	__be16 x;
+	__be16 y;
+} __packed;
+
+struct hx83102e_event {
+	struct hx83102e_point points[HX83102E_POINTS];
+	u8 width[HX83102E_POINTS];
+	u8 reserved[2];
+	u8 count;
+	u8 reserved1[2];
+	u8 checksum;
+} __packed;
+
+static_assert(sizeof(struct hx83102e_event) == 56);
+
+struct hx83102e {
+	struct spi_device *spi;
+	struct gpio_desc *reset;
+	struct input_dev *input;
+	struct touchscreen_properties props;
+};
+
+static int hx83102e_read(struct hx83102e *ts, u8 reg, void *data, size_t len)
+{
+	u8 header[] = { 0xf3, reg, 0 };
+
+	return spi_write_then_read(ts->spi, header, sizeof(header), data, len);
+}
+
+static int hx83102e_write(struct hx83102e *ts, u8 reg, const void *data, size_t len)
+{
+	u8 packet[10] = { 0xf2, reg };
+
+	if (len > sizeof(packet) - 2)
+		return -EINVAL;
+	memcpy(packet + 2, data, len);
+	return spi_write_then_read(ts->spi, packet, len + 2, NULL, 0);
+}
+
+static int hx83102e_write_byte(struct hx83102e *ts, u8 reg, u8 value)
+{
+	return hx83102e_write(ts, reg, &value, sizeof(value));
+}
+
+static int hx83102e_read_ahb(struct hx83102e *ts, u32 addr, u32 *value)
+{
+	__le32 data = cpu_to_le32(addr);
+	int ret;
+
+	ret = hx83102e_write_byte(ts, 0x13, 0x31);
+	if (ret)
+		return ret;
+	ret = hx83102e_write_byte(ts, 0x0d, 0x10);
+	if (ret)
+		return ret;
+	ret = hx83102e_write(ts, 0x00, &data, sizeof(data));
+	if (ret)
+		return ret;
+	ret = hx83102e_write_byte(ts, 0x0c, 0);
+	if (ret)
+		return ret;
+	ret = hx83102e_read(ts, 0x08, &data, sizeof(data));
+	if (!ret)
+		*value = le32_to_cpu(data);
+	return ret;
+}
+
+static void hx83102e_reset(struct hx83102e *ts)
+{
+	gpiod_set_value_cansleep(ts->reset, 1);
+	msleep(20);
+	gpiod_set_value_cansleep(ts->reset, 0);
+	msleep(50);
+}
+
+static irqreturn_t hx83102e_irq(int irq, void *data)
+{
+	struct hx83102e *ts = data;
+	struct hx83102e_event event;
+	const u8 *bytes = (const u8 *)&event;
+	u8 sum = 0;
+	bool nonzero = false;
+	unsigned int count, x, y;
+	int i, ret;
+
+	ret = hx83102e_read(ts, HX83102E_EVENT_STACK, &event, sizeof(event));
+	if (ret) {
+		dev_err_ratelimited(&ts->spi->dev, "Event read failed: %d\n", ret);
+		return IRQ_HANDLED;
+	}
+	for (i = 0; i < sizeof(event); i++) {
+		sum += bytes[i];
+		nonzero |= bytes[i] != 0;
+	}
+	if (sum || !nonzero)
+		return IRQ_HANDLED;
+
+	count = event.count == 0xff ? 0 : event.count & 0x0f;
+	if (count > HX83102E_POINTS)
+		return IRQ_HANDLED;
+	for (i = 0; i < HX83102E_POINTS && count; i++) {
+		x = be16_to_cpu(event.points[i].x);
+		y = be16_to_cpu(event.points[i].y);
+		if (x == 0xffff || y == 0xffff ||
+		    x > ts->props.max_x || y > ts->props.max_y)
+			continue;
+		input_mt_slot(ts->input, i);
+		input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, true);
+		touchscreen_report_pos(ts->input, &ts->props, x, y, true);
+		input_report_abs(ts->input, ABS_MT_TOUCH_MAJOR, event.width[i]);
+		count--;
+	}
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+	return IRQ_HANDLED;
+}
+
+static int hx83102e_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct hx83102e *ts;
+	u32 id;
+	int ret;
+
+	if (spi->irq <= 0)
+		return dev_err_probe(dev, -EINVAL, "Missing interrupt\n");
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+	ts->spi = spi;
+	spi_set_drvdata(spi, ts);
+	spi->bits_per_word = 8;
+	ret = spi_setup(spi);
+	if (ret)
+		return ret;
+	ts->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ts->reset))
+		return dev_err_probe(dev, PTR_ERR(ts->reset), "Reset GPIO unavailable\n");
+	hx83102e_reset(ts);
+	ret = hx83102e_read_ahb(ts, HX83102E_ICID, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "Product ID read failed\n");
+	if ((id >> 8) != HX83102E_ID)
+		return dev_err_probe(dev, -ENODEV, "Unexpected product ID: %#x\n", id);
+	dev_info(dev, "HX83102E identified: %#x\n", id);
+
+	ts->input = devm_input_allocate_device(dev);
+	if (!ts->input)
+		return -ENOMEM;
+	ts->input->name = "Himax HX83102E Touchscreen";
+	ts->input->id.bustype = BUS_SPI;
+	input_set_capability(ts->input, EV_ABS, ABS_MT_POSITION_X);
+	input_set_capability(ts->input, EV_ABS, ABS_MT_POSITION_Y);
+	input_set_abs_params(ts->input, ABS_MT_TOUCH_MAJOR, 0, 255, 0, 0);
+	touchscreen_parse_properties(ts->input, true, &ts->props);
+	ret = input_mt_init_slots(ts->input, HX83102E_POINTS,
+				 INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ret)
+		return ret;
+	ret = input_register_device(ts->input);
+	if (ret)
+		return ret;
+	return devm_request_threaded_irq(dev, spi->irq, NULL, hx83102e_irq,
+					 IRQF_ONESHOT, dev_name(dev), ts);
+}
+
+static int hx83102e_suspend(struct device *dev)
+{
+	struct hx83102e *ts = dev_get_drvdata(dev);
+
+	disable_irq(ts->spi->irq);
+	gpiod_set_value_cansleep(ts->reset, 1);
+	return 0;
+}
+
+static int hx83102e_resume(struct device *dev)
+{
+	struct hx83102e *ts = dev_get_drvdata(dev);
+
+	hx83102e_reset(ts);
+	enable_irq(ts->spi->irq);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(hx83102e_pm, hx83102e_suspend, hx83102e_resume);
+
+static const struct of_device_id hx83102e_of_match[] = {
+	{ .compatible = "himax,hx83102e" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hx83102e_of_match);
+
+static const struct spi_device_id hx83102e_spi_ids[] = {
+	{ "hx83102e" },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, hx83102e_spi_ids);
+
+static struct spi_driver hx83102e_driver = {
+	.probe = hx83102e_probe,
+	.id_table = hx83102e_spi_ids,
+	.driver = {
+		.name = "himax-hx83102e",
+		.of_match_table = hx83102e_of_match,
+		.pm = pm_sleep_ptr(&hx83102e_pm),
+	},
+};
+module_spi_driver(hx83102e_driver);
+
+MODULE_DESCRIPTION("Himax HX83102E SPI touchscreen driver");
+MODULE_LICENSE("GPL");
