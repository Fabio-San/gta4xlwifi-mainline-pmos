diff --git a/arch/aarch64/load-kernel.c b/arch/aarch64/load-kernel.c
index 8eee041..7833f4a 100644
--- a/arch/aarch64/load-kernel.c
+++ b/arch/aarch64/load-kernel.c
@@ -9,6 +9,16 @@
 
 void arch_load_kernel(void* kernel, void* dt, void* ramdisk)
 {
+#ifdef CONFIG_GTA4XL_DUAL_BOOT
+	if (gta4xl_use_fallback) {
+		/* This 4.14 Image has text_offset=0x80000, unlike the 7.3 Image. */
+		memcpy((void *)0x80080000, kernel, (unsigned long)&fallback_kernel_size);
+		__optimized_memcpy((void *)CONFIG_RAMDISK_ENTRY, ramdisk,
+				   (unsigned long)&fallback_ramdisk_size);
+		load_kernel_and_jump(dt, 0, 0, 0, (void *)0x80080000);
+		return;
+	}
+#endif
 	memcpy((void*)CONFIG_PAYLOAD_ENTRY, kernel, (unsigned long) &kernel_size);
 #ifndef CONFIG_RAMDISK_NO_COPY
 	__optimized_memcpy((void*)CONFIG_RAMDISK_ENTRY, ramdisk, (unsigned long) &ramdisk_size);
