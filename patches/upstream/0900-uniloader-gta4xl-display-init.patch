diff --git a/board/samsung/board-gta4xl.c b/board/samsung/board-gta4xl.c
index dd896e3..846f387 100644
--- a/board/samsung/board-gta4xl.c
+++ b/board/samsung/board-gta4xl.c
@@ -7,6 +7,7 @@
 #include <util.h>
 #include <drivers/framework.h>
 #include <lib/simplefb.h>
+#include <soc/exynos9610.h>
 
 static struct video_info gta4xl_fb = {
 	.format = FB_FORMAT_ARGB8888,
@@ -20,8 +21,55 @@ static const struct device gta4xl_devices[] = {
 	{ "simplefb", &gta4xl_fb, "fb" },
 };
 
+#ifdef CONFIG_GTA4XL_DUAL_BOOT
+int gta4xl_use_fallback;
+#endif
+#ifndef CONFIG_GTA4XL_ATTEMPT_ID
+#define CONFIG_GTA4XL_ATTEMPT_ID 0x1
+#endif
+#define ATTEMPT_TAG (0x4754413400000000UL | CONFIG_GTA4XL_ATTEMPT_ID)
+/* Last 16 bytes of reserved pmsg RAM; survives a warm reset. The tag is
+ * published on every boot so upstream-init can validate the attempt even
+ * when this image has no embedded fallback payload.
+ */
+static void gta4xl_publish_attempt(void)
+{
+	volatile unsigned long *tag = (void *)0xf9f0fff0;
+#ifdef CONFIG_GTA4XL_DUAL_BOOT
+	gta4xl_use_fallback = tag[0] == ATTEMPT_TAG && tag[1] == ~ATTEMPT_TAG;
+#ifdef CONFIG_GTA4XL_FORCE_FALLBACK
+	gta4xl_use_fallback = 1;
+#endif
+#endif
+	tag[0] = ATTEMPT_TAG;
+	tag[1] = ~ATTEMPT_TAG;
+	asm volatile("dsb sy" ::: "memory");
+}
+
+static int gta4xl_early_init(void)
+{
+	gta4xl_publish_attempt();
+	/* Keep DECON scanning the bootloader framebuffer during Linux handoff. */
+	*(volatile unsigned int *)(DECON_F_BASE + HW_SW_TRIG_CONTROL) = 0x1281;
+#ifdef CONFIG_GTA4XL_FALLBACK_RECOVERY
+	/* One-shot BOOT tests must return to the untouched recovery image. */
+	*(volatile unsigned int *)0x11860808 =
+		(*(volatile unsigned int *)0x11860808 & ~0x00ff0000U) | 0x004e0000;
+	*(volatile unsigned int *)0x1186080c = 0x12345674;
+	*(volatile unsigned int *)0x11860810 = 0xff;
+#else
+	/* Consume the one-shot recovery request before entering a diagnostic kernel. */
+	if (*(volatile unsigned int *)0x1186080c == 0x12345674)
+		*(volatile unsigned int *)0x1186080c = 0x12345670;
+	if (*(volatile unsigned int *)0x11860810 == 0xff)
+		*(volatile unsigned int *)0x11860810 = 0;
+#endif
+	return 0;
+}
+
 struct board_data board_ops = {
 	.name = "samsung-gta4xl",
+	.ops = { .early_init = gta4xl_early_init },
 	.devices = gta4xl_devices,
 	.num_devices = ARRAY_SIZE(gta4xl_devices),
 	.quirks = 0
diff --git a/drivers/ramdisk-handler.c b/drivers/ramdisk-handler.c
index b38aa1d..5d8b2bf 100644
--- a/drivers/ramdisk-handler.c
+++ b/drivers/ramdisk-handler.c
@@ -6,12 +6,17 @@
 #include <drivers/ramdisk-handler.h>
 #include <lib/debug.h>
 #include <lib/libfdt/libfdt.h>
+#include <main/boot.h>
 
 int ramdisk_handler_patch_dtb(const void *fdt, void *buf, int bufsize)
 {
 	int ret, dtb_chosen_offset;
 #ifdef __aarch64__
 	void *ramdisk_end = (void*)CONFIG_RAMDISK_ENTRY + (unsigned long)&ramdisk_size;
+#ifdef CONFIG_GTA4XL_DUAL_BOOT
+	if (gta4xl_use_fallback)
+		ramdisk_end = (void *)CONFIG_RAMDISK_ENTRY + (unsigned long)&fallback_ramdisk_size;
+#endif
 #elif __arm__
 	void *ramdisk_end = (void*)CONFIG_RAMDISK_ENTRY + ramdisk_size;
 #endif
