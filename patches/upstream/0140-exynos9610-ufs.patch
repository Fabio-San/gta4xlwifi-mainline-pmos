--- /dev/null
+++ b/drivers/ufs/host/ufs-exynos9610.c
@@ -0,0 +1,305 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Exynos9610/9611 glue for upstream UFSHCD and Samsung's PHY calibration.
+ * Register sequences adapted from Samsung's GPL SM-P615 UFS driver.
+ */
+#include <linux/clk.h>
+#include <linux/arm-smccc.h>
+#include <linux/delay.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <ufs/ufshcd.h>
+#include <ufs/unipro.h>
+#include "ufshcd-pltfrm.h"
+#include "ufs-cal-9610.h"
+
+struct ufs9610 {
+	struct ufs_hba *hba;
+	void __iomem *hci, *unipro, *pma;
+	struct clk *mclk;
+	struct ufs_cal_param cal;
+	struct uic_pwr_mode pmd;
+	int cal_error;
+	int hce_error;
+};
+
+static inline struct ufs9610 *priv(struct ufs_hba *hba)
+{
+	return ufshcd_get_variant(hba);
+}
+
+void ufs_lld_dme_set(void *h, u32 addr, u32 val)
+{
+	struct ufs9610 *u = h;
+	int ret = ufshcd_dme_set(u->hba, addr, val);
+	if (ret && !u->cal_error) u->cal_error = ret;
+}
+
+void ufs_lld_dme_get(void *h, u32 addr, u32 *val)
+{
+	struct ufs9610 *u = h;
+	int ret = ufshcd_dme_get(u->hba, addr, val);
+	if (ret && !u->cal_error) u->cal_error = ret;
+}
+
+void ufs_lld_dme_peer_set(void *h, u32 addr, u32 val)
+{
+	struct ufs9610 *u = h;
+	int ret = ufshcd_dme_peer_set(u->hba, addr, val);
+	if (ret && !u->cal_error) u->cal_error = ret;
+}
+
+void ufs_lld_pma_write(void *h, u32 val, u32 addr)
+{
+	struct ufs9610 *u = h;
+	u32 stop = readl(u->hci + 0xb0);
+	writel(stop & ~BIT(3), u->hci + 0xb0);
+	writel(val, u->pma + addr);
+	writel(stop | BIT(3), u->hci + 0xb0);
+}
+
+u32 ufs_lld_pma_read(void *h, u32 addr)
+{
+	struct ufs9610 *u = h;
+	u32 stop = readl(u->hci + 0xb0), val;
+	writel(stop & ~BIT(3), u->hci + 0xb0);
+	val = readl(u->pma + addr);
+	writel(stop | BIT(3), u->hci + 0xb0);
+	return val;
+}
+
+void ufs_lld_unipro_write(void *h, u32 val, u32 addr)
+{
+	struct ufs9610 *u = h;
+	writel(val, u->unipro + addr);
+}
+
+void ufs_lld_udelay(u32 val) { udelay(val); }
+void ufs_lld_usleep_delay(u32 min, u32 max) { usleep_range(min, max); }
+unsigned long ufs_lld_get_time_count(unsigned long offset) { return jiffies; }
+unsigned long ufs_lld_calc_timeout(unsigned int ms) { return msecs_to_jiffies(ms); }
+
+static int ufs9610_init(struct ufs_hba *hba)
+{
+	struct platform_device *pdev = to_platform_device(hba->dev);
+	struct ufs9610 *u;
+	struct regmap *pmu, *sysreg;
+	struct arm_smccc_res res;
+	int ret;
+
+	u = devm_kzalloc(hba->dev, sizeof(*u), GFP_KERNEL);
+	if (!u) return -ENOMEM;
+	u->hba = hba;
+	hba->priv = u;
+#define MAP(member, name) do { \
+	u->member = devm_platform_ioremap_resource_byname(pdev, name); \
+	if (IS_ERR(u->member)) return PTR_ERR(u->member); \
+} while (0)
+	MAP(hci, "vs_hci");
+	MAP(unipro, "unipro");
+	MAP(pma, "pma");
+#undef MAP
+	u->mclk = devm_clk_get(hba->dev, "sclk_unipro_main");
+	if (IS_ERR(u->mclk)) return PTR_ERR(u->mclk);
+	if (!clk_get_rate(u->mclk))
+		return dev_err_probe(hba->dev, -EINVAL, "UFS UniPro clock has no rate\n");
+	pmu = syscon_regmap_lookup_by_phandle(hba->dev->of_node, "samsung,pmu-syscon");
+	if (IS_ERR(pmu)) return PTR_ERR(pmu);
+	sysreg = syscon_regmap_lookup_by_phandle(hba->dev->of_node, "samsung,sysreg");
+	if (IS_ERR(sysreg)) return PTR_ERR(sysreg);
+	ret = regmap_update_bits(pmu, 0x724, BIT(0), BIT(0));
+	if (ret) return ret;
+	ret = regmap_update_bits(sysreg, 0x1010, BIT(8) | BIT(9), BIT(8) | BIT(9));
+	if (ret) return ret;
+
+	/* The protector is secure firmware owned, including after warm reset.
+	 * Use Samsung's DESCTYPE_3 + SMU_INIT ABI instead of touching UFSPR.
+	 * Zero crypto fields in 128-byte descriptors select plaintext I/O;
+	 * inline encryption is not advertised to the block layer.
+	 */
+	arm_smccc_smc(0xc2001810, 0, 0, 3, 0, 0, 0, 0, &res);
+	if (res.a0) return dev_err_probe(hba->dev, -EIO,
+		"FMP security setup failed: %ld\n", res.a0);
+	ufshcd_set_sg_entry_size(hba, 128);
+	arm_smccc_smc(0xc2001850, 0, 0, 0, 0, 0, 0, 0, &res);
+	if (res.a0) return dev_err_probe(hba->dev, -EIO,
+		"SMU initialization failed: %ld\n", res.a0);
+	hba->quirks |= UFSHCD_QUIRK_PRDT_BYTE_GRAN |
+		UFSHCD_QUIRK_BROKEN_INTR_AGGR | UFSHCI_QUIRK_BROKEN_REQ_LIST_CLR |
+		UFSHCI_QUIRK_SKIP_RESET_INTR_AGGR | UFSHCD_QUIRK_BROKEN_AUTO_HIBERN8 |
+		UFSHCD_QUIRK_BROKEN_OCS_FATAL_ERROR |
+		UFSHCD_QUIRK_SKIP_DEF_UNIPRO_TIMEOUT_SETTING;
+	/* Keep clocks and the link active until runtime PM is ported/tested. */
+	hba->caps = 0;
+	u->cal.host = u;
+	u->cal.board = 0;
+	return ufs_cal_init(&u->cal, 0) ? -EINVAL : 0;
+}
+
+static int ufs9610_reset_device(struct ufs_hba *hba)
+{
+	struct ufs9610 *u = priv(hba);
+	writel(0, u->hci + 0x70);
+	udelay(5);
+	writel(1, u->hci + 0x70);
+	return 0;
+}
+
+static int ufs9610_hce(struct ufs_hba *hba, enum ufs_notify_change_status status)
+{
+	struct ufs9610 *u = priv(hba);
+	u32 val;
+	int ret;
+
+	if (status == PRE_CHANGE) {
+		u->hce_error = 0;
+		hba->host->max_segment_size = 4096;
+		hba->host->dma_alignment = 4095;
+		writel(readl(u->hci + 0xb4) & ~BIT(4), u->hci + 0xb4);
+		writel(readl(u->hci + 0xb0) & ~0x17, u->hci + 0xb0);
+		writel(readl(u->hci + 0xfc) | BIT(0), u->hci + 0xfc);
+		writel(3, u->hci + 0x50);
+		ret = readl_poll_timeout(u->hci + 0x50, val, !(val & 3), 10, 10000);
+		if (ret) return u->hce_error = ret;
+		u->cal.mclk_rate = clk_get_rate(u->mclk);
+		if (!u->cal.mclk_rate) return u->hce_error = -EINVAL;
+		writel(readl(u->hci + 0x8c) | BIT(16), u->hci + 0x8c);
+		writel((u->cal.mclk_rate / 1000000) & 0x3ff, u->hci + 0x0c);
+		writel(0xa, u->hci + 0x60);
+		writel(BIT(31) | 12, u->hci + 0x00);
+		writel(12, u->hci + 0x04);
+		writel(~0U, u->hci + 0x40);
+		writel(~0U, u->hci + 0x44);
+		writel(BIT(31) | (3 << 27) | 3, u->hci + 0x6c);
+		writel(readl(u->hci + 0x100) & ~BIT(0), u->hci + 0x100);
+		return ufs9610_reset_device(hba);
+	}
+	if (u->hce_error) return u->hce_error;
+	writel(readl(u->hci + 0xb4) | BIT(11) | BIT(10) | BIT(8) |
+	       BIT(7) | BIT(6) | BIT(5), u->hci + 0xb4);
+	writel(readl(u->hci + 0xb0) & ~0x17, u->hci + 0xb0);
+	writel(readl(u->hci + 0xfc) | BIT(0), u->hci + 0xfc);
+	ret = ufshcd_dme_get(hba, UIC_ARG_MIB(PA_AVAILRXDATALANES), &val);
+	if (ret) return ret;
+	if (!val || val > 2) return -EINVAL;
+	u->cal.available_lane = val;
+	dev_info(hba->dev, "UFS mclk=%u lanes=%u\n", u->cal.mclk_rate, val);
+	return 0;
+}
+
+static int ufs9610_link(struct ufs_hba *hba, enum ufs_notify_change_status status)
+{
+	struct ufs9610 *u = priv(hba);
+	u32 val;
+	int ret;
+	if (u->hce_error) return u->hce_error;
+	u->cal_error = 0;
+	if (status == PRE_CHANGE) {
+		writel(BIT(31) | UIC_DATA_LINK_LAYER_ERROR_RX_BUF_OF |
+		       UIC_DATA_LINK_LAYER_ERROR_PA_INIT, u->hci + 0x7c);
+		writel(BIT(31) | UIC_NETWORK_UNSUPPORTED_HEADER_TYPE |
+		       UIC_NETWORK_BAD_DEVICEID_ENC | UIC_NETWORK_LHDR_TRAP_PACKET_DROPPING,
+		       u->hci + 0x80);
+		writel(BIT(31) | UIC_TRANSPORT_UNSUPPORTED_HEADER_TYPE |
+		       UIC_TRANSPORT_UNKNOWN_CPORTID | UIC_TRANSPORT_NO_CONNECTION_RX |
+		       UIC_TRANSPORT_BAD_TC, u->hci + 0x84);
+		ret = ufs_cal_pre_link(&u->cal);
+	} else {
+		ufs_lld_dme_get(u, UIC_ARG_MIB(PA_ACTIVETXDATALANES), &val);
+		u->cal.active_tx_lane = val;
+		ufs_lld_dme_get(u, UIC_ARG_MIB(PA_ACTIVERXDATALANES), &val);
+		u->cal.active_rx_lane = val;
+		ret = ufs_cal_post_link(&u->cal);
+	}
+	dev_info(hba->dev, "UFS link %s cal=%d dme=%d\n",
+		 status == PRE_CHANGE ? "pre" : "post", ret, u->cal_error);
+	return u->cal_error ?: (ret ? -EIO : 0);
+}
+
+static int ufs9610_negotiate(struct ufs_hba *hba,
+		const struct ufs_pa_layer_attr *max, struct ufs_pa_layer_attr *p)
+{
+	*p = *max;
+	p->lane_rx = min_t(u32, max->lane_rx, 1);
+	p->lane_tx = min_t(u32, max->lane_tx, 1);
+	p->gear_rx = min_t(u32, max->gear_rx, 3);
+	p->gear_tx = min_t(u32, max->gear_tx, 3);
+	p->pwr_rx = FAST_MODE;
+	p->pwr_tx = FAST_MODE;
+	p->hs_rate = PA_HS_MODE_B;
+	return 0;
+}
+
+static int ufs9610_power(struct ufs_hba *hba,
+		enum ufs_notify_change_status status, struct ufs_pa_layer_attr *p)
+{
+	struct ufs9610 *u = priv(hba);
+	int ret;
+	u->cal_error = 0;
+	u->pmd.lane = min(p->lane_rx, p->lane_tx);
+	u->pmd.gear = min(p->gear_rx, p->gear_tx);
+	u->pmd.mode = p->pwr_rx;
+	u->pmd.hs_series = p->hs_rate;
+	u->cal.pmd = &u->pmd;
+	u->cal.connected_rx_lane = p->lane_rx;
+	u->cal.connected_tx_lane = p->lane_tx;
+	u->cal.active_rx_lane = p->lane_rx;
+	u->cal.active_tx_lane = p->lane_tx;
+	ret = status == PRE_CHANGE ? ufs_cal_pre_pmc(&u->cal) : ufs_cal_post_pmc(&u->cal);
+	dev_info(hba->dev, "UFS power %s G%u L%u cal=%d dme=%d\n",
+		 status == PRE_CHANGE ? "pre" : "post", u->pmd.gear, u->pmd.lane,
+		 ret, u->cal_error);
+	return u->cal_error ?: (ret ? -EIO : 0);
+}
+
+static void ufs9610_xfer(struct ufs_hba *hba, int tag, bool scsi)
+{
+	struct ufs9610 *u = priv(hba);
+	u32 val = readl(u->hci + 0x40);
+	writel(scsi ? val | BIT(tag) : val & ~BIT(tag), u->hci + 0x40);
+}
+
+static void ufs9610_task(struct ufs_hba *hba, int tag, u8 func)
+{
+	struct ufs9610 *u = priv(hba);
+	u32 val = readl(u->hci + 0x44);
+	bool single = func == UFS_ABORT_TASK || func == UFS_QUERY_TASK;
+	writel(single ? val | BIT(tag) : val & ~BIT(tag), u->hci + 0x44);
+}
+
+static const struct ufs_hba_variant_ops ufs9610_ops = {
+	.name = "exynos9610",
+	.init = ufs9610_init,
+	.hce_enable_notify = ufs9610_hce,
+	.link_startup_notify = ufs9610_link,
+	.negotiate_pwr_mode = ufs9610_negotiate,
+	.pwr_change_notify = ufs9610_power,
+	.setup_xfer_req = ufs9610_xfer,
+	.setup_task_mgmt = ufs9610_task,
+	.device_reset = ufs9610_reset_device,
+};
+
+static int ufs9610_probe(struct platform_device *pdev)
+{
+	int ret = ufshcd_pltfrm_init(pdev, &ufs9610_ops);
+	if (!ret) pm_runtime_forbid(&pdev->dev);
+	return ret;
+}
+
+static const struct of_device_id ufs9610_match[] = {
+	{ .compatible = "samsung,exynos9610-ufs" }, {}
+};
+MODULE_DEVICE_TABLE(of, ufs9610_match);
+
+static struct platform_driver ufs9610_driver = {
+	.probe = ufs9610_probe,
+	.remove = ufshcd_pltfrm_remove,
+	.driver = { .name = "exynos9610-ufs", .of_match_table = ufs9610_match },
+};
+module_platform_driver(ufs9610_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Exynos9610/9611 UFS host with Samsung PHY calibration");
--- /dev/null
+++ b/drivers/ufs/host/ufs-cal-9610.c
@@ -0,0 +1,685 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Samsung Exynos9610 calibration tables from the SM-P615 vendor kernel. */
+#if defined(__UFS_CAL_U_BOOT__)
+#include <linux/types.h>
+#include <ufs-cal-9610.h>
+#elif defined(__UFS_CAL_FW__)
+#include <types.h>
+#include <include/ufs-cal.h>
+#else
+#include <linux/types.h>
+#include "ufs-cal-9610.h"
+#endif
+
+#ifndef _UFS_CAL_
+#define _UFS_CAL_
+
+/* UFSHCI */
+#define UIC_ARG_MIB_SEL(attr, sel)	((((attr) & 0xFFFF) << 16) |\
+					 ((sel) & 0xFFFF))
+#define UIC_ARG_MIB(attr)		UIC_ARG_MIB_SEL(attr, 0)
+
+/* Unipro.h */
+#define IS_PWR_MODE_HS(m)        (((m) == FAST_MODE) || ((m) == FASTAUTO_MODE))
+#define IS_PWR_MODE_PWM(m)       (((m) == SLOW_MODE) || ((m) == SLOWAUTO_MODE))
+
+enum {
+	PA_HS_MODE_A	= 1,
+	PA_HS_MODE_B	= 2,
+};
+
+enum {
+	FAST_MODE	= 1,
+	SLOW_MODE	= 2,
+	FASTAUTO_MODE	= 4,
+	SLOWAUTO_MODE	= 5,
+	UNCHANGED	= 7,
+};
+
+/* User defined */
+#define UNIPRO_MCLK_PERIOD(p) (1000000000L / p->mclk_rate)
+
+#define PHY_PMA_COMN_ADDR(reg)		(reg)
+#define PHY_PMA_TRSV_ADDR(reg, lane)	((reg) + (0x140 * (lane)))
+
+#define NUM_OF_UFS_HOST	1
+
+enum {
+	PHY_CFG_NONE = 0,
+	PHY_PCS_COMN,
+	PHY_PCS_RXTX,
+	PHY_PMA_COMN,
+	PHY_PMA_TRSV,
+	PHY_PLL_WAIT,
+	PHY_CDR_WAIT,
+	PHY_CDR_AFC_WAIT,
+	UNIPRO_STD_MIB,
+	UNIPRO_DBG_MIB,
+	UNIPRO_DBG_APB,
+
+	/* Since exynos8895 */
+	PHY_PCS_RX,
+	PHY_PCS_TX,
+	PHY_PCS_RX_PRD,
+	PHY_PCS_TX_PRD,
+	UNIPRO_DBG_PRD,
+	PHY_PMA_TRSV_LANE1_SQ_OFF,
+	COMMON_WAIT,
+};
+
+enum {
+	TX_LANE_0 = 0,
+	TX_LANE_1 = 1,
+	TX_LANE_2 = 2,
+	TX_LANE_3 = 3,
+	RX_LANE_0 = 4,
+	RX_LANE_1 = 5,
+	RX_LANE_2 = 6,
+	RX_LANE_3 = 7,
+};
+
+enum {
+	__PMD_PWM_G1_L1,
+	__PMD_PWM_G1_L2,
+	__PMD_PWM_G2_L1,
+	__PMD_PWM_G2_L2,
+	__PMD_PWM_G3_L1,
+	__PMD_PWM_G3_L2,
+	__PMD_PWM_G4_L1,
+	__PMD_PWM_G4_L2,
+	__PMD_PWM_G5_L1,
+	__PMD_PWM_G5_L2,
+	__PMD_HS_G1_L1,
+	__PMD_HS_G1_L2,
+	__PMD_HS_G2_L1,
+	__PMD_HS_G2_L2,
+	__PMD_HS_G3_L1,
+	__PMD_HS_G3_L2,
+};
+
+#define PMD_PWM_G1_L1	(1U << __PMD_PWM_G1_L1)
+#define PMD_PWM_G1_L2	(1U << __PMD_PWM_G1_L2)
+#define PMD_PWM_G2_L1	(1U << __PMD_PWM_G2_L1)
+#define PMD_PWM_G2_L2	(1U << __PMD_PWM_G2_L2)
+#define PMD_PWM_G3_L1	(1U << __PMD_PWM_G3_L1)
