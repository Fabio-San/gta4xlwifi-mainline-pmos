--- a/arch/arm64/boot/dts/exynos/exynos9610-gta4xl-peripherals.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9610-gta4xl-peripherals.dts
@@ -16,6 +16,20 @@
 		clock-output-names = "dll_dco";
 	};
 
+	/*
+	 * The bootloader leaves the GPU rail enabled; upstream does not yet
+	 * drive the S2MPU09 GPU buck through ACPM. This fixed supply only
+	 * satisfies the Panfrost regulator lookup.
+	 */
+	vdd_g3d: regulator-vdd-g3d {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_g3d";
+		regulator-min-microvolt = <800000>;
+		regulator-max-microvolt = <800000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
 	acpm: power-management {
 		compatible = "samsung,exynos9610-acpm-ipc";
 		mboxes = <&apm_mailbox>;
@@ -123,6 +137,46 @@
 		clock-names = "oscclk";
 	};
 
+	cmu_g3d: clock-controller@11430000 {
+		compatible = "samsung,exynos9610-cmu-g3d";
+		reg = <0x11430000 0x8000>;
+		#clock-cells = <1>;
+		clocks = <&oscclk>, <&cmu_top CLK_DOUT_CMU_G3D_SWITCH>,
+			 <&cmu_top CLK_DOUT_CMU_HPM>;
+		clock-names = "oscclk", "dout_cmu_g3d_switch", "dout_cmu_hpm";
+		power-domains = <&pd_g3d>;
+	};
+
+	/*
+	 * PMU G3D domain. Configuration is at PMU+0x4060 and the status
+	 * register is PMU+0x4064, using the same four-bit layout as the
+	 * vendor PMUCAL sequence. Keep it always on until the CMU_G3D clock
+	 * provider can save and restore its PLL state across domain power
+	 * cycles.
+	 */
+	pd_g3d: power-domain@11864060 {
+		compatible = "samsung,exynos9610-pd";
+		reg = <0x11864060 0x20>;
+		#power-domain-cells = <0>;
+		label = "pd-g3d";
+		samsung,always-on;
+	};
+
+	gpu: gpu@11500000 {
+		compatible = "arm,mali-bifrost";
+		reg = <0x11500000 0x5000>;
+		interrupts = <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "job", "mmu", "gpu";
+		clocks = <&cmu_g3d CLK_GOUT_CLK_G3D_G3D_CLK>,
+			 <&cmu_g3d CLK_GOUT_G3D_BUSP_CLK>,
+			 <&cmu_g3d CLK_GOUT_G3D_BUSD_CLK>;
+		clock-names = "core", "bus", "bus_ace";
+		power-domains = <&pd_g3d>;
+		mali-supply = <&vdd_g3d>;
+	};
+
 	cmu_usb: clock-controller@13030000 {
 		compatible = "samsung,exynos9610-cmu-usb";
 		reg = <0x13030000 0x10000>;
