+	{ .compatible = "samsung,exynos9610-csis" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cam_csi_of_match);
+
+static struct platform_driver cam_csi_driver = {
+	.probe = cam_csi_probe,
+	.remove = cam_csi_remove,
+	.driver = {
+		.name = "exynos9610-csis",
+		.of_match_table = cam_csi_of_match,
+	},
+};
+
+static int __init cam_init(void)
+{
+	int ret;
+
+	ret = i2c_add_driver(&cam_sensor_i2c_driver);
+	if (ret)
+		return ret;
+	ret = platform_driver_register(&cam_csi_driver);
+	if (ret)
+		i2c_del_driver(&cam_sensor_i2c_driver);
+	return ret;
+}
+
+static void __exit cam_exit(void)
+{
+	platform_driver_unregister(&cam_csi_driver);
+	i2c_del_driver(&cam_sensor_i2c_driver);
+}
+
+module_init(cam_init);
+module_exit(cam_exit);
