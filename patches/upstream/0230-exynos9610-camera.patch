+	bool			usi_v2;
 };
 
 /**
@@ -239,6 +248,12 @@
 static const struct exynos_hsi2c_variant exynosautov9_hsi2c_data = {
 	.fifo_depth	= 64,
 	.hw		= I2C_TYPE_EXYNOSAUTOV9,
+};
+
+/* USI-2 I2C block: 64-byte FIFOs and the TRANS_DONE interrupt group. */
+static const struct exynos_hsi2c_variant exynos9610_hsi2c_data = {
+	.fifo_depth	= 64,
+	.hw		= I2C_TYPE_EXYNOS7,
 };
 
 static const struct exynos_hsi2c_variant exynos8895_hsi2c_data = {
@@ -512,6 +527,13 @@
 	int_status = readl(i2c->regs + HSI2C_INT_STATUS);
 	writel(int_status, i2c->regs + HSI2C_INT_STATUS);
 
+	if (i2c->usi_v2)
+		dev_info_ratelimited(i2c->dev,
+			"irq int=%08x trans=%08x fifo=%08x ptr=%u/%u state=%d\n",
+			int_status, readl(i2c->regs + HSI2C_TRANS_STATUS),
+			readl(i2c->regs + HSI2C_FIFO_STATUS),
+			i2c->msg_ptr, i2c->msg ? i2c->msg->len : 0, i2c->state);
+
 	/* handle interrupt related to the transfer status */
 	switch (i2c->variant->hw) {
 	case I2C_TYPE_EXYNOSAUTOV9:
@@ -750,6 +772,10 @@
 		i2c_addr |= HSI2C_MASTER_ID(MASTER_ID(i2c->adap.nr));
 
 	writel(i2c_addr, i2c->regs + HSI2C_ADDR);
+	if (i2c->usi_v2)
+		dev_info_ratelimited(i2c->dev,
+			"addr write %08x read %08x\n", i2c_addr,
+			readl(i2c->regs + HSI2C_ADDR));
 
 	writel(fifo_ctl, i2c->regs + HSI2C_FIFO_CTL);
 	writel(i2c_ctl, i2c->regs + HSI2C_CTL);
@@ -884,6 +910,32 @@
 	.functionality = exynos5_i2c_func,
 };
 
+/*
+ * The dedicated USI-2 blocks (PERI CAMI2C, SPI, ...) start in reset.  The
+ * protocol selection is left to the bootloader, but the reset line has to be
+ * released before the underlying IP can be accessed.
+ */
+static void exynos5_i2c_usi_release(struct exynos5_i2c *i2c)
+{
+	u32 val;
+
+	if (!i2c->usi_v2)
+		return;
+
+	writel(0, i2c->regs + EXYNOS5_USI_CON);
+
+	/*
+	 * The HS-I2C IP clock is auto-gated by the CMU.  The USI wrapper
+	 * has to keep its clock request asserted for the controller to be
+	 * able to complete a transfer.
+	 */
+	val = readl(i2c->regs + EXYNOS5_USI_OPTION);
+	val |= EXYNOS5_USI_CLKREQ_ON;
+	val &= ~EXYNOS5_USI_CLKSTOP_ON;
+	writel(val, i2c->regs + EXYNOS5_USI_OPTION);
+	udelay(1);
+}
+
 static int exynos5_i2c_probe(struct platform_device *pdev)
 {
 	struct device_node *np = pdev->dev.of_node;
@@ -929,6 +981,9 @@
 		goto err_clk;
 	}
 
+	i2c->usi_v2 = of_property_read_bool(np, "samsung,usi-i2c-v2");
+	exynos5_i2c_usi_release(i2c);
+
 	i2c->adap.dev.of_node = np;
 	i2c->adap.algo_data = i2c;
 	i2c->adap.dev.parent = &pdev->dev;
@@ -951,11 +1006,20 @@
 	}
 
 	i2c->variant = of_device_get_match_data(&pdev->dev);
+	/*
+	 * USI-2 based instances do not generate the legacy INT_I2C bit;
+	 * they report completion through the TRANS_DONE interrupt group.
+	 */
+	if (i2c->usi_v2)
+		i2c->variant = &exynos9610_hsi2c_data;
 
 	ret = exynos5_hsi2c_clock_setup(i2c);
 	if (ret)
 		goto err_clk;
 
+	dev_info(&pdev->dev, "clkin %lu Hz, op %u Hz\n",
+		 clk_get_rate(i2c->clk), i2c->op_clock);
+
 	exynos5_i2c_reset(i2c);
 
 	ret = i2c_add_adapter(&i2c->adap);
@@ -1015,6 +1079,7 @@
 	if (ret)
 		goto err_clk;
 
+	exynos5_i2c_usi_release(i2c);
 	exynos5_i2c_init(i2c);
 	clk_disable(i2c->clk);
 	clk_disable(i2c->pclk);
