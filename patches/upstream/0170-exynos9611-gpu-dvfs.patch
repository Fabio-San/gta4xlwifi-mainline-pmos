+/* Refuse GPU scaling if the live calibrated firmware table is unexpected. */
+static int exynos9610_validate_g3d(struct device *dev)
+{
+	void __iomem *fvmap;
+	u32 header, offset, count, khz, uv, members, pll, pms, p, m, shift;
+	unsigned long actual;
+	unsigned int i, j;
+	bool found;
+	int ret = -EINVAL;
+
+	/* Boot DVFS plugin base 0xc400 + downstream fvmap_offset 0x6000. */
+	fvmap = ioremap(0x0204b400, SZ_8K);
+	if (!fvmap)
+		return -ENOMEM;
+	header = readl(fvmap + 4 * 24);
+	count = (header >> 8) & 0xff;
+	offset = readl(fvmap + 4 * 24 + 20) & 0xffff;
+	if ((header & 0xff) != 4 || !count || count > 32 ||
+	    (offset & 3) || offset + count * 8 > SZ_8K)
+		goto out;
+
+	members = readl(fvmap + 4 * 24 + 16) >> 16;
+	if ((members & 3) || members + 4 > SZ_8K)
+		goto out;
+	pll = readl(fvmap + members) & 0xffff;
+	if ((pll & 3) || pll + 8 + count * 4 > SZ_8K ||
+	    readl(fvmap + pll) != 0xa1430120 ||
+	    (readl(fvmap + pll + 4) >> 16) != count)
+		goto out;
+
+	for (i = 0; i < ARRAY_SIZE(exynos9610_g3d_rates); i++) {
+		found = false;
+		for (j = 0; j < count; j++) {
+			khz = readl(fvmap + offset + j * 8);
+			uv = readl(fvmap + offset + j * 8 + 4);
+			pms = readl(fvmap + pll + 8 + j * 4);
+			p = FIELD_GET(GENMASK(13, 8), pms);
+			m = FIELD_GET(GENMASK(25, 16), pms);
+			shift = FIELD_GET(GENMASK(2, 0), pms);
+			actual = p ? div_u64(26000000ULL * m, p << shift) : 0;
+			if (khz == exynos9610_g3d_rates[i].nominal / 1000 &&
+			    actual == exynos9610_g3d_rates[i].actual &&
+			    uv >= 500000 && uv <= 1200000) {
+				found = true;
+				break;
+			}
+		}
+		if (!found)
+			goto out;
+	}
+	ret = 0;
+out:
+	iounmap(fvmap);
+	if (ret)
+		dev_err(dev, "GPU firmware OPP validation failed\n");
+	return ret;
+}
