+		if (i == ARRAY_SIZE(exynos9610_g3d_rates))
+			return -EINVAL;
+		expected = exynos9610_g3d_rates[i].actual;
+	}
 
 	ret = acpm_clk_set_rate(hw, rate, parent_rate);
 	if (ret)
 		return ret;
 
-	actual = exynos9610_cpu_recalc_rate(hw, parent_rate);
