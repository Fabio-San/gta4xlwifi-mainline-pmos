+/*
+ * Exynos9610 uses the v3.0 HS block at 0x131d0000. Unlike Exynos850,
+ * its USB device PHY and TCXO buffer share PMU offset 0x704. The tablet
+ * routes USB 2.0 only; the separate SuperSpeed block is left isolated.
+ */
+static void exynos9610_usbdrd_phy_isol(struct phy_usb_instance *inst,
+				     bool isolate)
+{
+	u32 mask = BIT(0) | BIT(1) | BIT(16);
+
+	regmap_update_bits(inst->reg_pmu, inst->pmu_offset,
+			   mask, isolate ? 0 : mask);
+}
+
+static void exynos9610_usbdrd_utmi_init(struct exynos5_usbdrd_phy *phy_drd)
+{
+	void __iomem *regs = phy_drd->reg_phy;
+	u32 reg;
+
+	/* De-isolate before touching the PHY, matching the downstream order. */
+	exynos9610_usbdrd_phy_isol(&phy_drd->phys[EXYNOS5_DRDPHY_UTMI], false);
+
+	/* v3.0 Q-channel workaround from Samsung's calibration driver. */
+	reg = readl(regs + EXYNOS850_DRD_LINKCTRL);
+	reg |= BIT(9) | BIT(10) | BIT(11) | BIT(12);
+	reg &= ~LINKCTRL_FORCE_QACT;
+	udelay(500);
+	writel(reg, regs + EXYNOS850_DRD_LINKCTRL);
+	udelay(500);
+	writel(reg | LINKCTRL_FORCE_QACT, regs + EXYNOS850_DRD_LINKCTRL);
+
+	reg = readl(regs + EXYNOS850_DRD_CLKRST);
+	writel(reg | CLKRST_LINK_SW_RST, regs + EXYNOS850_DRD_CLKRST);
+	udelay(10);
+	writel(reg & ~CLKRST_LINK_SW_RST, regs + EXYNOS850_DRD_CLKRST);
+
+	exynos850_usbdrd_utmi_init(phy_drd);
+
+	/* Internal over-current inputs are used when the external pad is absent. */
+	reg = readl(regs + EXYNOS850_DRD_LINKPORT);
+	reg |= BIT(2) | BIT(3);
+	writel(reg, regs + EXYNOS850_DRD_LINKPORT);
+}
