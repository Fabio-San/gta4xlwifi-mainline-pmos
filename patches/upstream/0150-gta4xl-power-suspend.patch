From: gta4xl upstream bring-up
Subject: [PATCH] gta4xl: SM5713 power, ADC v3 and suspend-to-idle wakeup

Port the board power interfaces from Samsung 4.14 to standard IIO and
power_supply APIs. Enable touch wake and display system sleep callbacks.

---

diff --git a/drivers/pinctrl/samsung/pinctrl-exynos-arm64.c b/drivers/pinctrl/samsung/pinctrl-exynos-arm64.c
--- a/drivers/pinctrl/samsung/pinctrl-exynos-arm64.c
+++ b/drivers/pinctrl/samsung/pinctrl-exynos-arm64.c
@@ -1999,14 +1999,12 @@
 		/* pin-controller instance 3 FSYS data */
 		.pin_banks	= exynos9610_pin_banks3,
 		.nr_banks	= ARRAY_SIZE(exynos9610_pin_banks3),
-		.suspend	= exynos_pinctrl_suspend,
-		.resume		= exynos_pinctrl_resume,
+		/* EINT state is uninitialized without eint_gpio_init. */
 	}, {
 		/* pin-controller instance 4 TOP data */
 		.pin_banks	= exynos9610_pin_banks4,
 		.nr_banks	= ARRAY_SIZE(exynos9610_pin_banks4),
-		.suspend	= exynos_pinctrl_suspend,
-		.resume		= exynos_pinctrl_resume,
+		/* EINT state is uninitialized without eint_gpio_init. */
 	}, {
 		/* pin-controller instance 5 SHUB data */
 		.pin_banks	= exynos9610_pin_banks5,
diff --git a/Documentation/devicetree/bindings/iio/adc/samsung,exynos9610-adc.yaml b/Documentation/devicetree/bindings/iio/adc/samsung,exynos9610-adc.yaml
--- /dev/null
+++ b/Documentation/devicetree/bindings/iio/adc/samsung,exynos9610-adc.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/adc/samsung,exynos9610-adc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9610 shared ADC v3
+
+maintainers:
+  - Linux IIO <linux-iio@vger.kernel.org>
+
+description: |
+  Twelve-channel 12-bit ADC shared with the sensor hub. The second register
+  range contains the AP flag, sensor hub flag and turn word used to arbitrate
+  conversions. This driver polls conversion completion.
+
+properties:
+  compatible:
+    const: samsung,exynos9610-adc
+
+  reg:
+    items:
+      - description: ADC registers
+      - description: Three arbitration words at CMGP SYSREG offset 0x3100
+
+  reg-names:
+    items:
+      - const: adc
+      - const: arbitration
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: adc
+
+  '#io-channel-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - '#io-channel-cells'
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/power/supply/samsung,gta4xl-sm5713-power.yaml b/Documentation/devicetree/bindings/power/supply/samsung,gta4xl-sm5713-power.yaml
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/samsung,gta4xl-sm5713-power.yaml
@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/samsung,gta4xl-sm5713-power.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung gta4xl SM5713 battery and USB charger
+
+maintainers:
+  - Linux Power Management <linux-pm@vger.kernel.org>
+
+description: |
+  Board power integration for the SM-P615 battery, SM5713 charger at I2C
+  address 0x49 and retained fuel gauge at 0x71 on the same bus. The driver
+  uses the gta4xl battery/charger NTC calibration. USB input is limited
+  to 500 mA on ordinary ports and 1500 mA for detected BC1.2 CDP/DCP ports.
+  It polls charger status and temperature and disables charging in sleep
+  when the software thermistor monitor cannot run. USB PD, OTG and AFC are
+  not implemented by this board integration driver.
+
+properties:
+  compatible:
+    const: samsung,gta4xl-sm5713-power
+
+  reg:
+    maxItems: 1
+
+  io-channels:
+    items:
+      - description: Battery NTC raw ADC channel
+      - description: Charger NTC raw ADC channel
+
+  io-channel-names:
+    items:
+      - const: battery-temp
+      - const: charger-temp
+
+required:
+  - compatible
+  - reg
+  - io-channels
+  - io-channel-names
+
+additionalProperties: false
