diff --git a/drivers/iio/adc/exynos9610_adc.c b/drivers/iio/adc/exynos9610_adc.c
--- /dev/null
+++ b/drivers/iio/adc/exynos9610_adc.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exynos9610 ADC v3, register protocol from Samsung's GPLv2 driver. */
+#include <linux/clk.h>
+#include <linux/iio/iio.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+
+struct exynos9610_adc {
+	void __iomem *regs;
+	void __iomem *arb;
+	struct clk *clk;
+	/* Serialize conversions and sensor-hub arbitration. */
+	struct mutex lock;
+};
+
+static int exynos9610_adc_read(struct iio_dev *indio,
+		const struct iio_chan_spec *chan, int *val, int *val2, long mask)
+{
+	struct exynos9610_adc *adc = iio_priv(indio);
+	u32 data;
+	int ret;
+
+	if (mask != IIO_CHAN_INFO_RAW)
+		return -EINVAL;
+	mutex_lock(&adc->lock);
+	ret = clk_prepare_enable(adc->clk);
+	if (ret)
+		goto unlock;
+	/* Peterson arbitration with the sensor hub, as in the vendor driver. */
+	writel(1, adc->arb);
+	writel(1, adc->arb + 8);
+	/* Publish the AP request and turn before observing the hub flag. */
+	mb();
+	ret = read_poll_timeout(readl, data,
+		!data || !readl(adc->arb + 8), 100, 100000, false,
+		adc->arb + 4);
+	if (ret)
+		goto release;
+	writel(BIT(2), adc->regs);
+	writel(BIT(1), adc->regs);
+	writel((6 << 4) | chan->channel, adc->regs + 4);
+	writel(0, adc->regs + 0x10);
+	writel(1, adc->regs + 0x14);
+	writel(BIT(1) | BIT(0), adc->regs);
+	ret = readl_poll_timeout(adc->regs + 0x14, data,
+				data & BIT(0), 10, 100000);
+	if (!ret) {
+		*val = readl(adc->regs + 8) & 0xfff;
+		ret = IIO_VAL_INT;
+	}
+	writel(1, adc->regs + 0x14);
+release:
+	writel(0, adc->arb);
+	clk_disable_unprepare(adc->clk);
+unlock:
+	mutex_unlock(&adc->lock);
+	return ret;
+}
+
+#define ADC_CHANNEL(n) { .type = IIO_VOLTAGE, .indexed = 1, .channel = (n), \
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) }
+
+static const struct iio_chan_spec exynos9610_adc_channels[] = {
+	ADC_CHANNEL(0), ADC_CHANNEL(1), ADC_CHANNEL(2), ADC_CHANNEL(3),
+	ADC_CHANNEL(4), ADC_CHANNEL(5), ADC_CHANNEL(6), ADC_CHANNEL(7),
+	ADC_CHANNEL(8), ADC_CHANNEL(9), ADC_CHANNEL(10), ADC_CHANNEL(11),
+};
+
+static const struct iio_info exynos9610_adc_info = {
+	.read_raw = exynos9610_adc_read,
+};
+
+static int exynos9610_adc_probe(struct platform_device *pdev)
+{
+	struct iio_dev *indio;
+	struct exynos9610_adc *adc;
+
+	indio = devm_iio_device_alloc(&pdev->dev, sizeof(*adc));
+	if (!indio)
+		return -ENOMEM;
+	adc = iio_priv(indio);
+	adc->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(adc->regs))
+		return PTR_ERR(adc->regs);
+	adc->arb = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(adc->arb))
+		return PTR_ERR(adc->arb);
+	adc->clk = devm_clk_get(&pdev->dev, "adc");
+	if (IS_ERR(adc->clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(adc->clk), "ADC clock\n");
+	mutex_init(&adc->lock);
+	indio->name = "exynos9610-adc";
+	indio->modes = INDIO_DIRECT_MODE;
+	indio->info = &exynos9610_adc_info;
+	indio->channels = exynos9610_adc_channels;
+	indio->num_channels = ARRAY_SIZE(exynos9610_adc_channels);
+	return devm_iio_device_register(&pdev->dev, indio);
+}
+
+static const struct of_device_id exynos9610_adc_match[] = {
+	{ .compatible = "samsung,exynos9610-adc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos9610_adc_match);
+
+static struct platform_driver exynos9610_adc_driver = {
+	.probe = exynos9610_adc_probe,
+	.driver = {
+		.name = "exynos9610-adc",
+		.of_match_table = exynos9610_adc_match,
+	},
+};
+module_platform_driver(exynos9610_adc_driver);
+MODULE_DESCRIPTION("Samsung Exynos9610 shared ADC v3");
+MODULE_LICENSE("GPL");
