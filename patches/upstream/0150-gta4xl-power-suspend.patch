+		reg = <0x11c30000 0x100>, <0x11c13100 0xc>;
+		reg-names = "adc", "arbitration";
+		clocks = <&cmu_cmgp CLK_GOUT_CMGP_ADC_PCLK_S0>;
+		clock-names = "adc";
+		#io-channel-cells = <1>;
+	};
+};
+
+&touch_spi {
