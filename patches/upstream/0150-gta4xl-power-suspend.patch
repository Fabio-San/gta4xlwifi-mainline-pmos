+
+config GTA4XL_SM5713_POWER
+	tristate "Samsung gta4xl SM5713 power support"
+	depends on I2C && IIO
+	select REGMAP_I2C
+	help
+	  Support SM5713 battery reporting and USB charging on the
+	  Samsung Galaxy Tab S6 Lite. Battery and charger thermistors
+	  are monitored through IIO. USB source classification uses the
+	  existing MUIC BC1.2 detection result. Charging pauses in sleep.
 
 config POWER_SUPPLY_DEBUG
 	bool "Power supply debug"
diff --git a/drivers/power/supply/Makefile b/drivers/power/supply/Makefile
--- a/drivers/power/supply/Makefile
+++ b/drivers/power/supply/Makefile
@@ -135,3 +135,5 @@
 obj-$(CONFIG_FUEL_GAUGE_MM8013)	+= mm8013.o
 obj-$(CONFIG_MACSMC_POWER)	+= macsmc-power.o
 obj-$(CONFIG_CHARGER_MAX77759)	+= max77759_charger.o
+
+obj-$(CONFIG_GTA4XL_SM5713_POWER) += gta4xl-sm5713.o
diff --git a/drivers/power/supply/gta4xl-sm5713.c b/drivers/power/supply/gta4xl-sm5713.c
--- /dev/null
+++ b/drivers/power/supply/gta4xl-sm5713.c
@@ -0,0 +1,520 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SM5713 power support for Samsung gta4xl.
+ * Register definitions, conversions and thermistor calibration ported from
+ * Samsung's GPLv2 SM5713/battery_v2 drivers, Copyright (C) 2017 Samsung.
+ * The fuel gauge's retained, factory-calibrated battery model is preserved.
+ */
+#include <linux/i2c.h>
+#include <linux/iio/consumer.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define SM_STATUS1	0x0d
+#define SM_STATUS2	0x0e
+#define SM_CNTL1	0x13
+#define SM_CNTL2	0x14
+#define SM_VBUSCNTL	0x15
+#define SM_CHGCNTL2	0x18
+#define SM_CHGCNTL4	0x1a
+#define SM_CHGCNTL5	0x1b
+#define SM_WDT		0x22
+#define SM_Q4		BIT(3)
+
+struct gta4xl_power {
+	struct regmap *regmap;
+	struct i2c_client *fg;
+	struct i2c_client *muic;
+	struct iio_channel *therm;
+	struct iio_channel *charger_therm;
+	struct power_supply *battery;
+	struct power_supply *usb;
+	/* Serialize policy changes and userspace register reads. */
+	struct mutex lock;
+	struct delayed_work work;
+	bool thermal_stop;
+	int health;
+	enum power_supply_usb_type usb_type;
+};
+
+/* Board battery NTC: ADC codes ascending, temperatures in 0.1 Celsius. */
+static const int gta4xl_ntc[] = {
+	314, 364, 424, 490, 571, 671, 764, 909, 1051, 1220, 1420, 1596,
+	1781, 2020, 2242, 2477, 2711, 2916, 3126, 3296, 3443, 3538, 3666,
+};
+
+static const int gta4xl_charger_ntc[] = {
+	290, 339, 415, 476, 559, 657, 752, 890, 1032, 1195, 1372, 1564,
+	1772, 1993, 2221, 2475, 2713, 2914, 3109, 3285, 3418, 3554, 3671,
+};
+
+static int gta4xl_read_ntc(struct iio_channel *channel, const int *table,
+			  int count, int *temp)
+{
+	int raw, i, ret;
+
+	ret = iio_read_channel_raw(channel, &raw);
+	if (ret < 0)
+		return ret;
+	/* Rail readings indicate a disconnected or shorted thermistor. */
+	if (raw < table[0] || raw > table[count - 1])
+		return -ERANGE;
+	for (i = 1; i < count; i++) {
+		if (raw <= table[i]) {
+			*temp = 900 - (i - 1) * 50 -
+				(raw - table[i - 1]) * 50 /
+				(table[i] - table[i - 1]);
+			return 0;
+		}
+	}
+	return -ERANGE;
+}
+
+static int gta4xl_temperature(struct gta4xl_power *p, int *temp)
+{
+	return gta4xl_read_ntc(p->therm, gta4xl_ntc, ARRAY_SIZE(gta4xl_ntc), temp);
+}
+
+/* Read the existing BC1.2 result; never initiate AFC/PD or change USB routing. */
+static int gta4xl_source_limit(struct gta4xl_power *p, bool online)
+{
+	enum power_supply_usb_type type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	int detected, input_ma = 500, charge_ma = 500, ret;
+
+	if (online) {
+		detected = i2c_smbus_read_byte_data(p->muic, 0x07);
+		if (detected >= 0) {
+			switch (detected & (BIT(1) | BIT(2) | BIT(3))) {
+			case BIT(1):
+				type = POWER_SUPPLY_USB_TYPE_SDP;
+				break;
+			case BIT(2):
+				type = POWER_SUPPLY_USB_TYPE_DCP;
+				break;
+			case BIT(3):
+				type = POWER_SUPPLY_USB_TYPE_CDP;
+				break;
+			}
+		}
+	}
+	if (type == POWER_SUPPLY_USB_TYPE_CDP || type == POWER_SUPPLY_USB_TYPE_DCP) {
+		input_ma = 1500;
+		charge_ma = 1500;
+	}
+	if (type == p->usb_type)
+		return 0;
+	ret = regmap_update_bits(p->regmap, SM_VBUSCNTL, 0x7f,
+				 (input_ma - 100) / 25);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(p->regmap, SM_CHGCNTL2, 0x7f,
+				 (charge_ma - 100) / 50);
+	if (ret)
+		return ret;
+	p->usb_type = type;
+	dev_info(&p->fg->dev, "USB type %u, input/charge limit %d mA\n", type, input_ma);
+	return 0;
+}
+
+static int gta4xl_charge_off(struct gta4xl_power *p)
+{
+	int ret;
+
+	ret = regmap_update_bits(p->regmap, SM_CNTL1, SM_Q4, 0);
+	if (ret)
+		return ret;
+	return regmap_update_bits(p->regmap, SM_WDT, BIT(0), 0);
+}
+
+static int gta4xl_policy(struct gta4xl_power *p)
+{
+	unsigned int status;
+	int temp, charger_temp, ret;
+
+	ret = gta4xl_temperature(p, &temp);
+	if (!ret)
+		ret = gta4xl_read_ntc(p->charger_therm, gta4xl_charger_ntc,
+				      ARRAY_SIZE(gta4xl_charger_ntc), &charger_temp);
+	if (ret) {
+		p->health = POWER_SUPPLY_HEALTH_UNSPEC_FAILURE;
+		p->thermal_stop = true;
+		goto stop;
+	}
+	/* Vendor limits: stop at 0/50 C, recover within 5..45 C. */
+	if (temp <= 0 || temp >= 500 || charger_temp >= 800)
+		p->thermal_stop = true;
+	else if (temp >= 50 && temp <= 450 && charger_temp <= 770)
+		p->thermal_stop = false;
+	p->health = temp <= 0 ? POWER_SUPPLY_HEALTH_COLD :
+		(temp >= 500 || charger_temp >= 800) ? POWER_SUPPLY_HEALTH_OVERHEAT :
+		POWER_SUPPLY_HEALTH_GOOD;
+	ret = regmap_read(p->regmap, SM_STATUS1, &status);
+	if (ret)
+		goto stop;
+	ret = gta4xl_source_limit(p, status & BIT(0));
+	if (ret)
+		goto stop;
+	if (status & BIT(2))
+		p->health = POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+	if (!(status & BIT(0)) || (status & BIT(2)) || p->thermal_stop)
+		goto stop;
+	ret = regmap_read(p->regmap, SM_STATUS2, &status);
+	if (ret)
+		goto stop;
+	if (status & BIT(7)) {
+		ret = regmap_update_bits(p->regmap, SM_WDT, BIT(6), BIT(6));
+		if (ret)
+			goto stop;
+	}
+	/* Hardware watchdog disables charging if monitoring ever stops. */
+	ret = regmap_update_bits(p->regmap, SM_WDT, 0x0f, BIT(3) | (2 << 1) | 1);
+	if (ret)
+		goto stop;
+	ret = regmap_update_bits(p->regmap, SM_CNTL1, SM_Q4, SM_Q4);
+	if (!ret)
+		return 0;
+stop:
+	if (gta4xl_charge_off(p))
+		return -EIO;
+	return ret;
+}
+
+static int gta4xl_status(struct gta4xl_power *p, int *result)
+{
+	unsigned int s1, s2;
+	int ret;
+
+	ret = regmap_read(p->regmap, SM_STATUS1, &s1);
+	if (ret)
+		return ret;
+	ret = regmap_read(p->regmap, SM_STATUS2, &s2);
+	if (ret)
+		return ret;
+	*result = !(s1 & BIT(0)) ? POWER_SUPPLY_STATUS_DISCHARGING :
+		(s2 & BIT(5)) ? POWER_SUPPLY_STATUS_FULL :
+		(s2 & BIT(3)) ? POWER_SUPPLY_STATUS_CHARGING :
+		POWER_SUPPLY_STATUS_NOT_CHARGING;
+	return 0;
+}
+
+static int gta4xl_battery_get(struct power_supply *psy,
+		enum power_supply_property prop, union power_supply_propval *val)
+{
+	struct gta4xl_power *p = power_supply_get_drvdata(psy);
+	unsigned int status = 0;
+	int raw, ret = 0;
+
+	mutex_lock(&p->lock);
+	switch (prop) {
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = gta4xl_status(p, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		val->intval = p->health;
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		ret = regmap_read(p->regmap, SM_STATUS2, &status);
+		val->intval = !(status & BIT(2));
+		break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		raw = i2c_smbus_read_word_data(p->fg, 0x10);
+		if (raw < 0) {
+			ret = raw;
+			break;
+		}
+		if (!(raw & BIT(4))) {
+			ret = -ENODATA;
+			break;
+		}
+		raw = i2c_smbus_read_word_data(p->fg, 0x05);
+		if (raw < 0)
+			ret = raw;
+		else
+			val->intval = raw & BIT(15) ? 0 : min(raw >> 8, 100);
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
+		raw = i2c_smbus_read_word_data(p->fg,
+			prop == POWER_SUPPLY_PROP_VOLTAGE_NOW ? 0x07 : 0x06);
+		if (raw < 0)
+			ret = raw;
+		else
+			val->intval = (raw & 0x3fff) * 1000000LL / 2048;
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		raw = i2c_smbus_read_word_data(p->fg, 0x08);
+		if (raw < 0)
+			ret = raw;
+		else {
+			val->intval = (raw & 0x3fff) * 1000000LL / 2048;
+			if (raw & BIT(15))
+				val->intval = -val->intval;
+		}
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		ret = gta4xl_temperature(p, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = 7040000;
+		break;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = "SM5713 gta4xl";
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+static int gta4xl_usb_get(struct power_supply *psy,
+		enum power_supply_property prop, union power_supply_propval *val)
+{
+	struct gta4xl_power *p = power_supply_get_drvdata(psy);
+	unsigned int value = 0;
+	int ret;
+
+	mutex_lock(&p->lock);
+	switch (prop) {
+	case POWER_SUPPLY_PROP_USB_TYPE:
+		val->intval = p->usb_type;
+		ret = 0;
+		break;
+	case POWER_SUPPLY_PROP_ONLINE:
+		ret = regmap_read(p->regmap, SM_STATUS1, &value);
+		if (!ret)
+			val->intval = !!(value & BIT(0));
+		break;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		ret = regmap_read(p->regmap, SM_VBUSCNTL, &value);
+		if (!ret)
+			val->intval = (100 + (value & 0x7f) * 25) * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		ret = regmap_read(p->regmap, SM_CHGCNTL2, &value);
+		if (!ret)
+			val->intval = (100 + min(value & 0x7f, 0x44U) * 50) * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+		ret = regmap_read(p->regmap, SM_CHGCNTL4, &value);
+		value &= 0x3f;
+		if (!ret)
+			val->intval = (value < 4 ? 3700 + value * 50 :
+				value < 6 ? 3900 + (value - 4) * 100 :
+				4050 + (value - 6) * 10) * 1000;
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+static enum power_supply_property gta4xl_battery_props[] = {
+	POWER_SUPPLY_PROP_STATUS, POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_PRESENT, POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_CAPACITY, POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_OCV, POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_TEMP, POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+};
+
+static enum power_supply_property gta4xl_usb_props[] = {
+	POWER_SUPPLY_PROP_ONLINE, POWER_SUPPLY_PROP_USB_TYPE,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE,
+};
+
+static const struct power_supply_desc gta4xl_battery_desc = {
+	.name = "sm5713-battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = gta4xl_battery_props,
+	.num_properties = ARRAY_SIZE(gta4xl_battery_props),
+	.get_property = gta4xl_battery_get,
+};
+
+static const struct power_supply_desc gta4xl_usb_desc = {
+	.name = "sm5713-usb",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.usb_types = BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN) |
+		     BIT(POWER_SUPPLY_USB_TYPE_SDP) |
+		     BIT(POWER_SUPPLY_USB_TYPE_CDP) |
+		     BIT(POWER_SUPPLY_USB_TYPE_DCP),
+	.properties = gta4xl_usb_props,
+	.num_properties = ARRAY_SIZE(gta4xl_usb_props),
+	.get_property = gta4xl_usb_get,
+};
+
+static void gta4xl_monitor(struct work_struct *work)
+{
+	struct gta4xl_power *p = container_of(to_delayed_work(work),
+					    struct gta4xl_power, work);
+
+	mutex_lock(&p->lock);
+	if (gta4xl_policy(p))
+		dev_warn_ratelimited(&p->fg->dev, "Charge monitoring failed\n");
+	mutex_unlock(&p->lock);
+	power_supply_changed(p->battery);
+	power_supply_changed(p->usb);
+	schedule_delayed_work(&p->work, msecs_to_jiffies(5000));
+}
+
+static void gta4xl_cleanup(void *data)
+{
+	struct gta4xl_power *p = data;
+
+	cancel_delayed_work_sync(&p->work);
+	gta4xl_charge_off(p);
+}
+
+static int gta4xl_power_probe(struct i2c_client *client)
+{
+	static const struct regmap_config config = {
+		.reg_bits = 8, .val_bits = 8, .max_register = 0x50,
+	};
+	struct power_supply_config psycfg = {};
+	struct gta4xl_power *p;
+	unsigned int id;
+	int ret, fg_id, fg_status;
+
+	if (!i2c_check_functionality(client->adapter,
+		I2C_FUNC_SMBUS_BYTE_DATA | I2C_FUNC_SMBUS_WORD_DATA))
+		return -EOPNOTSUPP;
+	p = devm_kzalloc(&client->dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	mutex_init(&p->lock);
+	INIT_DELAYED_WORK(&p->work, gta4xl_monitor);
+	i2c_set_clientdata(client, p);
+	p->health = POWER_SUPPLY_HEALTH_UNKNOWN;
+	p->regmap = devm_regmap_init_i2c(client, &config);
+	if (IS_ERR(p->regmap))
+		return PTR_ERR(p->regmap);
+	ret = regmap_read(p->regmap, 0x50, &id);
+	if (ret)
+		return ret;
+	if ((id & 7) != 1)
+		return -ENODEV;
+	/* Disable charging before acquiring temperature sensors or supplies. */
+	ret = gta4xl_charge_off(p);
+	if (ret)
+		return ret;
+	p->therm = devm_iio_channel_get(&client->dev, "battery-temp");
+	if (IS_ERR(p->therm))
+		return dev_err_probe(&client->dev, PTR_ERR(p->therm), "Battery NTC\n");
+	p->charger_therm = devm_iio_channel_get(&client->dev, "charger-temp");
+	if (IS_ERR(p->charger_therm))
+		return dev_err_probe(&client->dev, PTR_ERR(p->charger_therm), "Charger NTC\n");
+	p->muic = devm_i2c_new_dummy_device(&client->dev, client->adapter, 0x25);
+	if (IS_ERR(p->muic))
+		return PTR_ERR(p->muic);
+	ret = i2c_smbus_read_byte_data(p->muic, 0);
+	if (ret < 0)
+		return ret;
+	if (ret != 1)
+		return -ENODEV;
+	p->fg = devm_i2c_new_dummy_device(&client->dev, client->adapter, 0x71);
+	if (IS_ERR(p->fg))
+		return PTR_ERR(p->fg);
+	fg_id = i2c_smbus_read_word_data(p->fg, 0);
+	if (fg_id < 0)
+		return fg_id;
+	if (fg_id > 0xff)
+		return -ENODEV;
+	fg_status = i2c_smbus_read_word_data(p->fg, 0x10);
+	if (fg_status < 0)
+		return fg_status;
+	if (!(fg_status & BIT(4)))
+		dev_warn(&client->dev, "Gauge model uninitialized; capacity unavailable\n");
+	/* USB default 500 mA. No PD/AFC negotiation or high-current claim. */
+	ret = regmap_update_bits(p->regmap, SM_VBUSCNTL, 0x7f, 16);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(p->regmap, SM_CHGCNTL2, 0x7f, 8);
+	if (ret)
+		return ret;
+	/* 4.35 V board float voltage, hardware auto-stop, 100 mA termination. */
+	ret = regmap_update_bits(p->regmap, SM_CHGCNTL4, 0x7f, 36 | BIT(6));
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(p->regmap, SM_CHGCNTL5, 0x1f, 0);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(p->regmap, SM_CNTL2, 0xf, 5);
+	if (ret)
+		return ret;
+	psycfg.drv_data = p;
+	psycfg.fwnode = dev_fwnode(&client->dev);
+	p->battery = devm_power_supply_register(&client->dev,
+					      &gta4xl_battery_desc, &psycfg);
+	if (IS_ERR(p->battery))
+		return PTR_ERR(p->battery);
+	p->usb = devm_power_supply_register(&client->dev,
+					  &gta4xl_usb_desc, &psycfg);
+	if (IS_ERR(p->usb))
+		return PTR_ERR(p->usb);
+	ret = devm_add_action_or_reset(&client->dev, gta4xl_cleanup, p);
+	if (ret)
+		return ret;
+	dev_info(&client->dev, "SM5713 charger %#x, gauge %#x (status %#x), BC1.2 source limits\n",
+		 id, fg_id, fg_status);
+	schedule_delayed_work(&p->work, 0);
+	return 0;
+}
+
+static int gta4xl_power_suspend(struct device *dev)
+{
+	struct gta4xl_power *p = dev_get_drvdata(dev);
+	int ret;
+
+	cancel_delayed_work_sync(&p->work);
+	mutex_lock(&p->lock);
+	/* Software NTC monitoring stops in sleep: stop charging, keep the buck. */
+	ret = gta4xl_charge_off(p);
+	mutex_unlock(&p->lock);
+	if (ret)
+		schedule_delayed_work(&p->work, 0);
+	return ret;
+}
+
+static int gta4xl_power_resume(struct device *dev)
+{
+	struct gta4xl_power *p = dev_get_drvdata(dev);
+
+	schedule_delayed_work(&p->work, 0);
+	return 0;
+}
+
+static void gta4xl_power_shutdown(struct i2c_client *client)
+{
+	gta4xl_cleanup(i2c_get_clientdata(client));
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(gta4xl_power_pm,
+		gta4xl_power_suspend, gta4xl_power_resume);
+
+static const struct of_device_id gta4xl_power_match[] = {
+	{ .compatible = "samsung,gta4xl-sm5713-power" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gta4xl_power_match);
+
+static struct i2c_driver gta4xl_power_driver = {
+	.probe = gta4xl_power_probe,
+	.shutdown = gta4xl_power_shutdown,
+	.driver = {
+		.name = "gta4xl-sm5713-power",
+		.of_match_table = gta4xl_power_match,
+		.pm = pm_sleep_ptr(&gta4xl_power_pm),
+	},
+};
+module_i2c_driver(gta4xl_power_driver);
+MODULE_DESCRIPTION("Samsung gta4xl SM5713 charger and fuel gauge");
+MODULE_LICENSE("GPL");
