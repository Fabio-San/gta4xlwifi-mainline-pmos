Exynos9610 CHUB sensor bring-up

Port the board firmware transport to IIO. Initialize DLL_APM before
switching the SHUB clock source; retain firmware ownership of sensor buses.

---

diff --git a/Documentation/devicetree/bindings/iio/samsung,exynos9610-chub.yaml b/Documentation/devicetree/bindings/iio/samsung,exynos9610-chub.yaml
--- a/Documentation/devicetree/bindings/iio/samsung,exynos9610-chub.yaml
+++ b/Documentation/devicetree/bindings/iio/samsung,exynos9610-chub.yaml
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/samsung,exynos9610-chub.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9610 CHUB sensor hub
+
+maintainers:
+  - Jonathan Cameron <jic23@kernel.org>
+
+description: |
+  The CHUB Cortex-M4 controls the tablet's sensor buses. The application
+  processor loads the board firmware into SRAM and exchanges SSP commands
+  and sensor reports through shared SRAM rings and a hardware mailbox.
+  This local bring-up binding also describes the SHUB bus mux and CPU QCH,
+  pending a complete CMU_SHUB clock provider.
+
+properties:
+  compatible:
+    const: samsung,exynos9610-chub
+
+  reg:
+    items:
+      - description: AP to CHUB mailbox
+      - description: CHUB SRAM
+      - description: CHUB peripheral address translation window
+      - description: CMU_SHUB Cortex-M4 Q-channel control
+      - description: CMU_SHUB bus user mux
+      - description: DLL_APM DCO registers
+      - description: SYSREG_APM DLL control and lock status
+      - description: CMU_APM bus mux for shared DLL safety check
+
+  reg-names:
+    items:
+      - const: mailbox
+      - const: sram
+      - const: baaw
+      - const: qch
+      - const: bus-mux
+      - const: dll
+      - const: sysreg
+      - const: apm-bus-mux
+
+  interrupts:
+    maxItems: 1
+
+  samsung,pmu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: PMU syscon controlling the CHUB CPU reset
+
+  clocks:
+    items:
+      - description: SHUB bus clock from CMU_APM
+      - description: CMGP I2C functional clock
+      - description: DLL user mux
+      - description: SHUB source mux
+      - description: DLL DCO clock
+
+  clock-names:
+    items:
+      - const: bus
+      - const: i2c
+      - const: dll-user
+      - const: bus-parent
+      - const: dll
+
+  sensor-enable-gpios:
+    maxItems: 1
+    description: Enable the sensor supply
+
+  sensor-3v3-enable-gpios:
+    maxItems: 1
+    description: Enable the sensor 3.3 V supply
+
+  mount-matrix:
+    description: Sensor frame relative to the native portrait panel frame
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - samsung,pmu
+  - clocks
+  - clock-names
+  - sensor-enable-gpios
+  - sensor-3v3-enable-gpios
+
+additionalProperties: false
diff --git a/drivers/iio/common/Kconfig b/drivers/iio/common/Kconfig
--- a/drivers/iio/common/Kconfig
+++ b/drivers/iio/common/Kconfig
@@ -2,6 +2,18 @@
 #
 # IIO common modules
 #
+
+config EXYNOS9610_CHUB
+	tristate "Exynos9610 CHUB sensor hub"
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	depends on OF && HAS_IOMEM
+	depends on COMMON_CLK && GPIOLIB
+	select MFD_SYSCON
+	help
+	  Samsung CHUB mailbox/SRAM transport and SSP accelerometer, gyroscope
+	  and ambient light channels, exposed through standard IIO interfaces.
+	  Requires the board-specific Samsung sensorhub firmware. The hub owns
+	  the sensor buses and communicates through a mailbox and SRAM rings.
 
 source "drivers/iio/common/cros_ec_sensors/Kconfig"
 source "drivers/iio/common/hid-sensors/Kconfig"
diff --git a/drivers/iio/common/Makefile b/drivers/iio/common/Makefile
--- a/drivers/iio/common/Makefile
+++ b/drivers/iio/common/Makefile
@@ -14,4 +14,5 @@
 obj-y += ms_sensors/
 obj-y += scmi_sensors/
 obj-y += ssp_sensors/
+obj-$(CONFIG_EXYNOS9610_CHUB) += exynos9610-chub.o
 obj-y += st_sensors/
diff --git a/drivers/clk/samsung/clk-exynos9610.c b/drivers/clk/samsung/clk-exynos9610.c
--- a/drivers/clk/samsung/clk-exynos9610.c
+++ b/drivers/clk/samsung/clk-exynos9610.c
@@ -1487,6 +1487,8 @@
 };
 
 static const struct samsung_gate_clock apm_gate_clks[] __initconst = {
+	GATE(0, "gout_cmu_shub_bus", "mout_cmu_shub_bus",
+	     CLK_CON_GAT_GATE_CLKCMU_SHUB_BUS, 21, 0, 0),
 	GATE(CLK_GOUT_CMU_CMGP_BUS, "gout_cmu_cmgp_bus", "dout_clk_apm_bus",
 	     CLK_CON_GAT_CLKCMU_CMGP_BUS, 21, 0, 0),
 	GATE(CLK_GOUT_CLK_APM_CMU_PCLK, "gout_clk_apm_cmu_pclk", "dout_clk_apm_bus",
diff --git a/arch/arm64/boot/dts/exynos/exynos9610-gta4xl-peripherals.dts b/arch/arm64/boot/dts/exynos/exynos9610-gta4xl-peripherals.dts
--- a/arch/arm64/boot/dts/exynos/exynos9610-gta4xl-peripherals.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9610-gta4xl-peripherals.dts
@@ -167,6 +167,25 @@
 		#clock-cells = <1>;
 		clocks = <&oscclk>, <&cmu_top CLK_DOUT_CMU_APM_BUS>;
 		clock-names = "oscclk", "dout_cmu_apm_bus";
+	};
+
+	sensorhub@11980000 {
+		compatible = "samsung,exynos9610-chub";
+		reg = <0x11980000 0x200>, <0x11200000 0x40000>,
+		      <0x11100000 0x10>, <0x11003018 0x4>, <0x11000100 0x4>,
+		      <0x118b0000 0x1000>, <0x11810000 0x1000>, <0x11801004 0x4>;
+		reg-names = "mailbox", "sram", "baaw", "qch", "bus-mux",
+			    "dll", "sysreg", "apm-bus-mux";
+		interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
+		samsung,pmu = <&pmu>;
+		clocks = <&cmu_apm CLK_DOUT_CMU_SHUB_BUS>,
+			 <&cmu_cmgp CLK_GOUT_CMGP_I2C_CLK>,
+			 <&cmu_apm CLK_MOUT_PLL_DLL_USER>,
+			 <&cmu_apm CLK_MOUT_CMU_SHUB_BUS>, <&dll_dco>;
+		clock-names = "bus", "i2c", "dll-user", "bus-parent", "dll";
+		sensor-enable-gpios = <&gpm21 0 GPIO_ACTIVE_HIGH>;
+		sensor-3v3-enable-gpios = <&gpm20 0 GPIO_ACTIVE_HIGH>;
+		mount-matrix = "-1", "0", "0", "0", "-1", "0", "0", "0", "1";
 	};
 
 	apm_mailbox: mailbox@11900000 {
diff --git a/drivers/iio/common/exynos9610-chub.c b/drivers/iio/common/exynos9610-chub.c
--- a/drivers/iio/common/exynos9610-chub.c
+++ b/drivers/iio/common/exynos9610-chub.c
@@ -0,0 +1,887 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Exynos9610 CHUB / Samsung SSP sensors.
+ *
+ * Mailbox, SRAM ABI and startup sequence derived from Samsung's GPL
+ * drivers/staging/nanohub/{chub,chub_ipc}.c and drivers/sensorhub/ssp_*.c.
+ * The firmware owns the sensor buses. AP clients use ordinary IIO channels.
+ */
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/iio/iio.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+#define CHUB_BL "sensorhub/shub_bl.fw"
+#define CHUB_OS "sensorhub/shub_exynos9611_gta4xl.fw"
+#define SRAM_SIZE 0x40000
+#define IPC_VERSION 181024
+#define PACKET_MAX 769
+#define CHANNELS 16
+#define EVENTS 30
+#define SSP_HEADER 13
+#define SSP_CMD_SIZE 64
+#define CMD_ADD 0
+#define CMD_REMOVE 1
+#define CMD_SET 3
+#define CMD_GET 4
+#define CMD_REPORT 5
+#define MCU 255
+#define ACCEL 1
+#define GYRO 4
+#define LIGHT 5
+#define SENSOR_COUNT 3
+#define INTGR1 0x1c
+#define INTCR0 0x0c
+#define INTMR0 0x10
+#define INTSR0 0x14
+#define INTSR1 0x28
+#define ISSR0 0x80
+#define ALIVE BIT(31)
+#define CPU_CFG 0x3d20
+#define CPU_STATUS 0x3d24
+#define CPU_OPTION 0x3d28
+
+/* These layouts are a fixed little-endian firmware ABI, including padding. */
+struct chub_bootargs {
+	u8 magic[16];
+	__le32 version, bl_start, bl_end, code_start, code_end;
+	__le32 ipc_start, ipc_end, ram_start, ram_end;
+	__le32 shared_start, shared_end, dump_start, dump_end, clock;
+	__le16 bootmode, kernel_log;
+};
+
+struct chub_channel {
+	u32 size;
+	u8 data[PACKET_MAX];
+	u8 padding[3];
+};
+
+struct chub_queue {
+	u32 eq, dq, full, empty;
+	struct chub_channel channel[CHANNELS];
+};
+
+struct chub_event {
+	u32 event, irq, status;
+};
+
+struct chub_events {
+	struct chub_event event[EVENTS];
+	u32 eq, dq, full, empty, irq;
+};
+
+struct chub_ipc {
+	struct chub_queue queue[2]; /* C2A, A2C */
+	struct chub_events events[2];
+	u32 debug[3];
+	u32 log_eq, log_dq, log_size, log_token, log_full;
+};
+
+struct chub;
+struct chub_sensor {
+	struct chub *hub;
+	struct mutex lock; /* Serializes reads, enable/disable and idle work. */
+	spinlock_t sample_lock; /* Protects the sample and validity flag. */
+	wait_queue_head_t wait;
+	struct delayed_work idle_work;
+	struct iio_mount_matrix mount;
+	u8 type, index;
+	bool enabled, valid;
+	unsigned long sample_jiffies;
+	int sample[3];
+};
+
+struct chub {
+	struct device *dev;
+	void __iomem *sram, *mailbox, *baaw, *qch, *bus_mux;
+	void __iomem *dll, *sysreg, *apm_bus_mux;
+	struct chub_ipc __iomem *ipc;
+	struct regmap *pmu;
+	struct clk_bulk_data clocks[5];
+	struct mutex command_lock; /* One SSP command in flight at a time. */
+	spinlock_t reply_lock; /* Protects IRQ replies and the pending command. */
+	struct completion alive, reply;
+	u8 pending[3], response[64];
+	size_t response_len;
+	bool waiting, suspended, started;
+	u64 sensor_mask;
+	int irq;
+	struct chub_sensor *sensors[SENSOR_COUNT];
+};
+
+static const u8 sensor_types[] = { ACCEL, GYRO, LIGHT };
+
+static_assert(sizeof(struct chub_bootargs) == 76);
+static_assert(sizeof(struct chub_channel) == 776);
+static_assert(sizeof(struct chub_queue) == 12432);
+static_assert(sizeof(struct chub_events) == 380);
+static_assert(sizeof(struct chub_ipc) == 25656);
+
+static int chub_send(struct chub *hub, const u8 *packet)
+{
+	struct chub_queue __iomem *q = &hub->ipc->queue[1];
+	struct chub_events __iomem *events = &hub->ipc->events[1];
+	struct chub_channel __iomem *channel;
+	struct chub_event __iomem *event;
+	u32 eq = readl(&q->eq), dq = readl(&q->dq);
+	u32 eeq = readl(&events->eq), edq = readl(&events->dq);
+	u32 irq = readl(&events->irq), pending;
+	u64 now = ktime_get_boottime_ns();
+	int ret;
+
+	if (eq >= CHANNELS || dq >= CHANNELS || eeq >= EVENTS ||
+	    edq >= EVENTS || irq >= 15)
+		return -EPROTO;
+	if ((eq + 1) % CHANNELS == dq || readl(&events->full))
+		return -EBUSY;
+	ret = readl_poll_timeout(hub->mailbox + INTSR1, pending,
+				 !(pending & BIT(irq)), 100, 30000);
+	if (ret)
+		return ret;
+	channel = &q->channel[eq];
+	writel(SSP_CMD_SIZE, &channel->size);
+	memcpy_toio(channel->data, packet, SSP_CMD_SIZE);
+	writel((eq + 1) % CHANNELS, &q->eq);
+	event = &events->event[eeq];
+	writel(0, &event->event);
+	writel(irq, &event->irq);
+	writel(1, &event->status);
+	/* One published event consumes one slot in the firmware ring. */
+	eeq = (eeq + 1) % EVENTS;
+	writel(eeq, &events->eq);
+	if (eeq == edq)
+		writel(1, &events->full);
+	writel(lower_32_bits(now), hub->mailbox + ISSR0 + 4);
+	writel(upper_32_bits(now), hub->mailbox + ISSR0 + 8);
+	/* Publish SRAM contents before ringing the mailbox. */
+	wmb();
+	writel(BIT(irq), hub->mailbox + INTGR1);
+	return 0;
+}
+
+static int chub_command(struct chub *hub, u8 cmd, u8 type, u8 subcmd,
+			const void *payload, size_t len, void *response,
+			size_t response_size)
+{
+	u8 packet[SSP_CMD_SIZE] = { cmd, type, subcmd };
+	unsigned long flags;
+	int ret;
+
+	if (len > SSP_CMD_SIZE - SSP_HEADER)
+		return -EINVAL;
+	put_unaligned_le16(len, packet + 3);
+	put_unaligned_le64(ktime_get_boottime_ns(), packet + 5);
+	if (len)
+		memcpy(packet + SSP_HEADER, payload, len);
+	mutex_lock(&hub->command_lock);
+	reinit_completion(&hub->reply);
+	spin_lock_irqsave(&hub->reply_lock, flags);
+	memcpy(hub->pending, packet, 3);
+	hub->waiting = !!response;
+	hub->response_len = 0;
+	spin_unlock_irqrestore(&hub->reply_lock, flags);
+	ret = chub_send(hub, packet);
+	if (!ret && response &&
+	    !wait_for_completion_timeout(&hub->reply, msecs_to_jiffies(1500)))
+		ret = -ETIMEDOUT;
+	spin_lock_irqsave(&hub->reply_lock, flags);
+	hub->waiting = false;
+	if (!ret && response) {
+		if (hub->response_len < response_size)
+			ret = -EPROTO;
+		else
+			memcpy(response, hub->response, response_size);
+	}
+	spin_unlock_irqrestore(&hub->reply_lock, flags);
+	mutex_unlock(&hub->command_lock);
+	if (ret)
+		dev_err_ratelimited(hub->dev, "command %u/%u/%u failed: %d\n",
+				    cmd, type, subcmd, ret);
+	return ret;
+}
+
+static unsigned int chub_data_size(u8 type)
+{
+	switch (type) {
+	case ACCEL: case GYRO: return 6;
+	case LIGHT: return 28;
+	default: return 0;
+	}
+}
+
+static void chub_sample(struct chub *hub, u8 type, const u8 *p)
+{
+	struct chub_sensor *sensor;
+	unsigned long flags;
+	unsigned int i, n;
+
+	for (i = 0; i < SENSOR_COUNT; i++) {
+		sensor = READ_ONCE(hub->sensors[i]);
+		if (!sensor || sensor->type != type)
+			continue;
+		spin_lock_irqsave(&sensor->sample_lock, flags);
+		if (type == LIGHT) {
+			sensor->sample[0] = get_unaligned_le32(p);
+		} else {
+			for (n = 0; n < 3; n++)
+				sensor->sample[n] = (s16)get_unaligned_le16(p + n * 2);
+		}
+		sensor->valid = true;
+		sensor->sample_jiffies = jiffies;
+		spin_unlock_irqrestore(&sensor->sample_lock, flags);
+		wake_up(&sensor->wait);
+	}
+}
+
+static void chub_report(struct chub *hub, const u8 *p, size_t len)
+{
+	unsigned int i, count, size, n;
+	u8 tag, type;
+
+	while (len) {
+		tag = *p++;
+		len--;
+		switch (tag) {
+		case 0x03: /* length-prefixed debug string */
+			if (!len || p[0] > len - 1)
+				return;
+			n = p[0];
+			dev_dbg(hub->dev, "firmware: %.*s\n", n, p + 1);
+			p += n + 1;
+			len -= n + 1;
+			break;
+		case 0x37: /* sensor type, LE16 count, samples + LE64 timestamp */
+			if (len < 3)
+				return;
+			type = p[0];
+			count = get_unaligned_le16(p + 1);
+			size = chub_data_size(type);
+			p += 3;
+			len -= 3;
+			if (!size || !count || count > len / (size + 8))
+				return;
+			for (; count; count--, p += size + 8, len -= size + 8)
+				chub_sample(hub, type, p);
+			break;
+		case 0x41: /* packed sensor specifications, 46 bytes each */
+			if (!len || p[0] > (len - 1) / 46)
+				return;
+			n = *p++;
+			len--;
+			for (i = 0; i < n; i++, p += 46, len -= 46)
+				dev_info(hub->dev, "sensor %u: %.15s\n", p[0], p + 1);
+			break;
+		case 0x05: /* flush metadata */
+			if (len < 2)
+				return;
+			p += 2;
+			len -= 2;
+			break;
+		case 0x07:
+			dev_info(hub->dev, "firmware ready\n");
+			break;
+		default:
+			/* Unknown records have no common length field. */
+			dev_dbg(hub->dev, "unhandled report tag %#x\n", tag);
+			return;
+		}
+	}
+}
+
+static void chub_receive(struct chub *hub)
+{
+	struct chub_queue __iomem *q = &hub->ipc->queue[0];
+	u32 eq = readl(&q->eq), dq = readl(&q->dq), size;
+	u8 packet[PACKET_MAX];
+	unsigned long flags;
+	size_t len;
+
+	if (eq >= CHANNELS || dq >= CHANNELS || eq == dq)
+		return;
+	size = readl(&q->channel[dq].size);
+	if (size >= SSP_HEADER && size <= PACKET_MAX)
+		memcpy_fromio(packet, q->channel[dq].data, size);
+	/* Copy before returning ownership to CHUB. */
+	writel((dq + 1) % CHANNELS, &q->dq);
+	if (size < SSP_HEADER || size > PACKET_MAX)
+		return;
+	len = get_unaligned_le16(packet + 3);
+	if (!len || len > size - SSP_HEADER)
+		return;
+	if (packet[0] == CMD_REPORT) {
+		chub_report(hub, packet + SSP_HEADER, len);
+	} else {
+		spin_lock_irqsave(&hub->reply_lock, flags);
+		if (hub->waiting && !memcmp(packet, hub->pending, 3)) {
+			hub->response_len = min(len, sizeof(hub->response));
+			memcpy(hub->response, packet + SSP_HEADER, hub->response_len);
+			hub->waiting = false;
+			complete(&hub->reply);
+		}
+		spin_unlock_irqrestore(&hub->reply_lock, flags);
+	}
+}
+
+static irqreturn_t chub_irq(int irq, void *data)
+{
+	struct chub *hub = data;
+	struct chub_events __iomem *events = &hub->ipc->events[0];
+	u32 status, eq, dq, event, line;
+	int budget = EVENTS;
+
+	status = readl(hub->mailbox + INTSR0) & 0xffff0000;
+	if (!status)
+		return IRQ_NONE;
+	if (status & ALIVE) {
+		writel(ALIVE, hub->mailbox + INTCR0);
+		complete(&hub->alive);
+		status &= ~ALIVE;
+	}
+	while (status && budget--) {
+		eq = readl(&events->eq);
+		dq = readl(&events->dq);
+		if (eq >= EVENTS || dq >= EVENTS ||
+		    (eq == dq && !readl(&events->full)))
+			break;
+		event = readl(&events->event[dq].event);
+		line = readl(&events->event[dq].irq);
+		if (line >= 15 || !(status & BIT(line + 16)))
+			break;
+		if (event < 3)
+			chub_receive(hub);
+		else if (event == 3)
+			dev_warn_ratelimited(hub->dev, "firmware debug event %#x\n",
+					     readl(&hub->ipc->debug[0]));
+		writel(0, &events->event[dq].status);
+		writel((dq + 1) % EVENTS, &events->dq);
+		writel(0, &events->full);
+		writel(BIT(line + 16), hub->mailbox + INTCR0);
+		status &= ~BIT(line + 16);
+	}
+	if (status) {
+		dev_warn_ratelimited(hub->dev, "invalid mailbox events %#x\n", status);
+		writel(status, hub->mailbox + INTCR0);
+	}
+	return IRQ_HANDLED;
+}
+
+static int chub_sensor_enable(struct chub_sensor *sensor, bool enable)
+{
+	__le32 period[2] = { cpu_to_le32(50), 0 };
+	int ret;
+
+	if (sensor->enabled == enable)
+		return 0;
+	ret = chub_command(sensor->hub, enable ? CMD_ADD : CMD_REMOVE,
+			   sensor->type, 0, period, enable ? 8 : 4, NULL, 0);
+	if (!ret)
+		sensor->enabled = enable;
+	return ret;
+}
+
+static void chub_sensor_idle(struct work_struct *work)
+{
+	struct chub_sensor *sensor = container_of(to_delayed_work(work),
+						struct chub_sensor, idle_work);
+
+	mutex_lock(&sensor->lock);
+	if (!READ_ONCE(sensor->hub->suspended))
+		chub_sensor_enable(sensor, false);
+	mutex_unlock(&sensor->lock);
+}
+
+static bool chub_sample_ready(struct chub_sensor *sensor)
+{
+	if (!READ_ONCE(sensor->valid))
+		return false;
+	/* Light is an on-change sensor; motion data must remain fresh. */
+	return sensor->type == LIGHT ||
+		time_before(jiffies, READ_ONCE(sensor->sample_jiffies) + HZ);
+}
+
+static int chub_read_raw(struct iio_dev *indio_dev,
+			 const struct iio_chan_spec *chan, int *val, int *val2,
+			 long mask)
+{
+	struct chub_sensor *sensor = iio_priv(indio_dev);
+	unsigned long flags;
+	int ret = 0;
+
+	if (mask == IIO_CHAN_INFO_SCALE) {
+		*val = 0;
+		/* Pinned ICM42605M firmware specs: 4096 LSB/g, +/-1000 dps. */
+		*val2 = sensor->type == ACCEL ? 2394202 :
+			532632;
+		return IIO_VAL_INT_PLUS_NANO;
+	}
+	if (mask != IIO_CHAN_INFO_RAW && mask != IIO_CHAN_INFO_PROCESSED)
+		return -EINVAL;
+	mutex_lock(&sensor->lock);
+	if (READ_ONCE(sensor->hub->suspended)) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (!sensor->enabled) {
+		spin_lock_irqsave(&sensor->sample_lock, flags);
+		sensor->valid = false;
+		spin_unlock_irqrestore(&sensor->sample_lock, flags);
+		ret = chub_sensor_enable(sensor, true);
+		if (ret)
+			goto out;
+	}
+	if (!wait_event_timeout(sensor->wait, chub_sample_ready(sensor),
+				msecs_to_jiffies(2000))) {
+		ret = -ETIMEDOUT;
+		goto idle;
+	}
+	spin_lock_irqsave(&sensor->sample_lock, flags);
+	*val = sensor->sample[chan->address];
+	spin_unlock_irqrestore(&sensor->sample_lock, flags);
+	ret = IIO_VAL_INT;
+idle:
+	mod_delayed_work(system_dfl_wq, &sensor->idle_work, 2 * HZ);
+out:
+	mutex_unlock(&sensor->lock);
+	return ret;
+}
+
+static const struct iio_mount_matrix *
+chub_mount(const struct iio_dev *indio_dev, const struct iio_chan_spec *chan)
+{
+	struct chub_sensor *sensor = iio_priv(indio_dev);
+
+	return &sensor->mount;
+}
+
+static const struct iio_chan_spec_ext_info chub_ext_info[] = {
+	IIO_MOUNT_MATRIX(IIO_SHARED_BY_TYPE, chub_mount),
+	{ }
+};
+
+#define CHUB_AXIS(_type, _axis, _address) { \
+	.type = _type, .modified = 1, .channel2 = IIO_MOD_##_axis, \
+	.address = _address, .info_mask_separate = BIT(IIO_CHAN_INFO_RAW), \
+	.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE), \
+	.ext_info = chub_ext_info, \
+}
+
+static const struct iio_chan_spec accel_channels[] = {
+	CHUB_AXIS(IIO_ACCEL, X, 0), CHUB_AXIS(IIO_ACCEL, Y, 1),
+	CHUB_AXIS(IIO_ACCEL, Z, 2),
+};
+
+static const struct iio_chan_spec gyro_channels[] = {
+	CHUB_AXIS(IIO_ANGL_VEL, X, 0), CHUB_AXIS(IIO_ANGL_VEL, Y, 1),
+	CHUB_AXIS(IIO_ANGL_VEL, Z, 2),
+};
+
+static const struct iio_chan_spec light_channels[] = {
+	{ .type = IIO_LIGHT, .info_mask_separate = BIT(IIO_CHAN_INFO_PROCESSED) },
+};
+
+static const struct iio_info chub_iio_info = { .read_raw = chub_read_raw };
+
+static void chub_sensor_cleanup(void *data)
+{
+	struct chub_sensor *sensor = data;
+	struct chub *hub = sensor->hub;
+
+	cancel_delayed_work_sync(&sensor->idle_work);
+	mutex_lock(&sensor->lock);
+	chub_sensor_enable(sensor, false);
+	mutex_unlock(&sensor->lock);
+	WRITE_ONCE(hub->sensors[sensor->index], NULL);
+	synchronize_irq(hub->irq);
+}
+
+static int chub_register_sensor(struct chub *hub, unsigned int index)
+{
+	struct iio_dev *indio_dev;
+	struct chub_sensor *sensor;
+	int ret;
+
+	indio_dev = devm_iio_device_alloc(hub->dev, sizeof(*sensor));
+	if (!indio_dev)
+		return -ENOMEM;
+	sensor = iio_priv(indio_dev);
+	sensor->hub = hub;
+	sensor->type = sensor_types[index];
+	sensor->index = index;
+	mutex_init(&sensor->lock);
+	spin_lock_init(&sensor->sample_lock);
+	init_waitqueue_head(&sensor->wait);
+	INIT_DELAYED_WORK(&sensor->idle_work, chub_sensor_idle);
+	ret = iio_read_mount_matrix(hub->dev, &sensor->mount);
+	if (ret)
+		return ret;
+	indio_dev->info = &chub_iio_info;
+	indio_dev->modes = INDIO_DIRECT_MODE;
+	if (sensor->type == ACCEL) {
+		indio_dev->name = "chub-accelerometer";
+		indio_dev->channels = accel_channels;
+		indio_dev->num_channels = ARRAY_SIZE(accel_channels);
+	} else if (sensor->type == GYRO) {
+		indio_dev->name = "chub-gyroscope";
+		indio_dev->channels = gyro_channels;
+		indio_dev->num_channels = ARRAY_SIZE(gyro_channels);
+	} else {
+		indio_dev->name = "chub-light";
+		indio_dev->channels = light_channels;
+		indio_dev->num_channels = ARRAY_SIZE(light_channels);
+	}
+	WRITE_ONCE(hub->sensors[index], sensor);
+	ret = devm_add_action_or_reset(hub->dev, chub_sensor_cleanup, sensor);
+	if (ret)
+		return ret;
+	return devm_iio_device_register(hub->dev, indio_dev);
+}
+
+static void chub_stop(void *data)
+{
+	struct chub *hub = data;
+	int i;
+
+	WRITE_ONCE(hub->suspended, true);
+	for (i = 0; i < SENSOR_COUNT; i++)
+		if (hub->sensors[i])
+			cancel_delayed_work_sync(&hub->sensors[i]->idle_work);
+	writel(0xffff0000, hub->mailbox + INTMR0);
+	disable_irq(hub->irq);
+	if (hub->started)
+		regmap_update_bits(hub->pmu, CPU_CFG, BIT(0), 0);
+}
+
+static void chub_clocks_disable(void *data)
+{
+	struct chub *hub = data;
+
+	clk_bulk_disable_unprepare(2, hub->clocks);
+}
+
+static int chub_clocks_enable(struct chub *hub)
+{
+	u32 status;
+	int ret;
+
+	/* The boot firmware leaves DLL_APM unlocked. Switching CMU_SHUB onto
+	 * that source first stops the bus, including accesses to CHUB SRAM.
+	 * Follow Samsung's cal_dll_apm_enable sequence before reparenting.
+	 */
+	if (!(readl(hub->sysreg + 0x444) & BIT(0))) {
+		if (readl(hub->apm_bus_mux) & BIT(0))
+			return dev_err_probe(hub->dev, -EBUSY, "APM bus uses unlocked DLL\n");
+		writel(0xc65, hub->dll + 4);
+		writel(0x111, hub->sysreg + 0x440);
+		ret = readl_poll_timeout(hub->sysreg + 0x444, status,
+					 status & BIT(0), 10, 20000);
+		if (ret)
+			return dev_err_probe(hub->dev, ret, "DLL lock timed out\n");
+	}
+	if (readl(hub->dll + 4) != 0xc65)
+		return dev_err_probe(hub->dev, -EINVAL, "unexpected DLL rate\n");
+	ret = clk_set_parent(hub->clocks[2].clk, hub->clocks[4].clk);
+	if (ret)
+		return ret;
+	ret = clk_set_parent(hub->clocks[3].clk, hub->clocks[2].clk);
+	if (ret)
+		return ret;
+	ret = clk_set_rate(hub->clocks[0].clk, 104005500);
+	if (ret)
+		return ret;
+	ret = clk_bulk_prepare_enable(2, hub->clocks);
+	if (ret)
+		return ret;
+	return devm_add_action_or_reset(hub->dev, chub_clocks_disable, hub);
+}
+
+static int chub_boot(struct chub *hub)
+{
+	const struct firmware *bl, *os;
+	struct chub_bootargs args;
+	u32 code, end, start, ipc_end, status, value;
+	unsigned int i, j;
+	int ret;
+
+	ret = request_firmware(&bl, CHUB_BL, hub->dev);
+	if (ret)
+		return ret;
+	ret = request_firmware(&os, CHUB_OS, hub->dev);
+	if (ret)
+		goto release_bl;
+	if (bl->size < 256 + sizeof(args) || bl->size > SRAM_SIZE) {
+		ret = -EINVAL;
+		goto release_os;
+	}
+	memcpy(&args, bl->data + 256, sizeof(args));
+	code = le32_to_cpu(args.code_start);
+	end = le32_to_cpu(args.code_end);
+	start = le32_to_cpu(args.ipc_start);
+	ipc_end = le32_to_cpu(args.ipc_end);
+	if (memcmp(args.magic, "Nanohub OS", sizeof("Nanohub OS")) ||
+	    le32_to_cpu(args.version) != IPC_VERSION ||
+	    code < bl->size || end < code || end > SRAM_SIZE || os->size > end - code ||
+	    start < end || ipc_end > SRAM_SIZE || ipc_end < start ||
+	    ipc_end - start < sizeof(struct chub_ipc) + 96) {
+		ret = -EINVAL;
+		goto release_os;
+	}
+	ret = regmap_read(hub->pmu, CPU_STATUS, &status);
+	if (ret)
+		goto release_os;
+	if (status & BIT(0)) {
+		dev_err(hub->dev, "hub CPU already running; refusing SRAM overwrite\n");
+		ret = -EBUSY;
+		goto release_os;
+	}
+	memcpy_toio(hub->sram, bl->data, bl->size);
+	memcpy_toio(hub->sram + code, os->data, os->size);
+	hub->ipc = hub->sram + start;
+	for (i = 0; i < 2; i++) {
+		writel(0, &hub->ipc->queue[i].eq);
+		writel(0, &hub->ipc->queue[i].dq);
+		writel(0, &hub->ipc->queue[i].full);
+		writel(1, &hub->ipc->queue[i].empty);
+		memset_io(&hub->ipc->events[i], 0, sizeof(struct chub_events));
+		writel(1, &hub->ipc->events[i].empty);
+		for (j = 0; j < EVENTS; j++) {
+			writel(0xff, &hub->ipc->events[i].event[j].event);
+			writel(0xff, &hub->ipc->events[i].event[j].irq);
+		}
+	}
+	writel(0, &hub->ipc->log_eq);
+	writel(0, &hub->ipc->log_dq);
+	writel(ipc_end - start - sizeof(struct chub_ipc) - 96,
+	       &hub->ipc->log_size);
+	writel(clk_get_rate(hub->clocks[0].clk),
+	       hub->sram + 256 + offsetof(struct chub_bootargs, clock));
+	writew(0x7733, hub->sram + 256 + offsetof(struct chub_bootargs, bootmode));
+	writew(0, hub->sram + 256 + offsetof(struct chub_bootargs, kernel_log));
+	writel(0x40300, hub->baaw);
+	writel(0x40800, hub->baaw + 4);
+	writel(0x11900, hub->baaw + 8);
+	writel(0x80000003, hub->baaw + 12);
+	writel(0xffff0000, hub->mailbox + INTCR0);
+	writel(0, hub->mailbox + INTMR0);
+	writel(1, hub->mailbox + ISSR0); /* bootloader must run the supplied OS */
+	value = readl(hub->qch) & ~7;
+	writel(value | 4, hub->qch);
+	/* CMU_SHUB user mux: select the APM bus clock, rather than OSCCLK. */
+	writel(readl(hub->bus_mux) | BIT(4), hub->bus_mux);
+	ret = readl_poll_timeout(hub->bus_mux, status, !(status & BIT(7)), 10, 10000);
+	if (ret)
+		goto release_os;
+	/* Complete firmware and bootarg writes before releasing the CPU. */
+	wmb();
+	ret = regmap_update_bits(hub->pmu, CPU_CFG, BIT(0), BIT(0));
+	if (ret)
+		goto release_os;
+	hub->started = true;
+	ret = regmap_update_bits(hub->pmu, CPU_OPTION, BIT(15), BIT(15));
+	if (ret)
+		goto release_os;
+	/* Boot ROM releases CPU_CFG after RESET_RELEASE is requested. */
+	ret = regmap_read_poll_timeout(hub->pmu, CPU_CFG, status,
+				       status & BIT(0), 1000, 20000);
+	writel(value | 6, hub->qch);
+	writel(value | 2, hub->qch);
+	if (ret)
+		goto release_os;
+	for (i = 0; i < 4; i++) {
+		msleep(50);
+		reinit_completion(&hub->alive);
+		writel(BIT(15), hub->mailbox + INTGR1);
+		if (wait_for_completion_timeout(&hub->alive, msecs_to_jiffies(200)))
+			break;
+	}
+	ret = i == 4 ? -ETIMEDOUT : 0;
+	if (!ret)
+		dev_info(hub->dev, "CHUB alive, clock %lu Hz, IPC %#x-%#x\n",
+			 clk_get_rate(hub->clocks[0].clk), start, ipc_end);
+release_os:
+	release_firmware(os);
+release_bl:
+	release_firmware(bl);
+	return ret;
+}
+
+static int chub_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct gpio_desc *gpio;
+	struct chub *hub;
+	__le64 mask;
+	__le32 position = 0, revision;
+	int ret, i;
+
+	hub = devm_kzalloc(dev, sizeof(*hub), GFP_KERNEL);
+	if (!hub)
+		return -ENOMEM;
+	hub->dev = dev;
+	dev_info(dev, "initializing CHUB transport\n");
+	platform_set_drvdata(pdev, hub);
+	mutex_init(&hub->command_lock);
+	spin_lock_init(&hub->reply_lock);
+	init_completion(&hub->alive);
+	init_completion(&hub->reply);
+	hub->pmu = syscon_regmap_lookup_by_phandle(dev->of_node, "samsung,pmu");
+	if (IS_ERR(hub->pmu))
+		return dev_err_probe(dev, PTR_ERR(hub->pmu), "PMU unavailable\n");
+	hub->sram = devm_platform_ioremap_resource_byname(pdev, "sram");
+	if (IS_ERR(hub->sram))
+		return PTR_ERR(hub->sram);
+	hub->mailbox = devm_platform_ioremap_resource_byname(pdev, "mailbox");
+	if (IS_ERR(hub->mailbox))
+		return PTR_ERR(hub->mailbox);
+	hub->baaw = devm_platform_ioremap_resource_byname(pdev, "baaw");
+	if (IS_ERR(hub->baaw))
+		return PTR_ERR(hub->baaw);
+	hub->qch = devm_platform_ioremap_resource_byname(pdev, "qch");
+	if (IS_ERR(hub->qch))
+		return PTR_ERR(hub->qch);
+	hub->bus_mux = devm_platform_ioremap_resource_byname(pdev, "bus-mux");
+	if (IS_ERR(hub->bus_mux))
+		return PTR_ERR(hub->bus_mux);
+	hub->dll = devm_platform_ioremap_resource_byname(pdev, "dll");
+	if (IS_ERR(hub->dll))
+		return PTR_ERR(hub->dll);
+	hub->sysreg = devm_platform_ioremap_resource_byname(pdev, "sysreg");
+	if (IS_ERR(hub->sysreg))
+		return PTR_ERR(hub->sysreg);
+	hub->apm_bus_mux = devm_platform_ioremap_resource_byname(pdev, "apm-bus-mux");
+	if (IS_ERR(hub->apm_bus_mux))
+		return PTR_ERR(hub->apm_bus_mux);
+	hub->clocks[0].id = "bus";
+	hub->clocks[1].id = "i2c";
+	hub->clocks[2].id = "dll-user";
+	hub->clocks[3].id = "bus-parent";
+	hub->clocks[4].id = "dll";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(hub->clocks), hub->clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "clocks unavailable\n");
+	ret = chub_clocks_enable(hub);
+	if (ret)
+		return ret;
+	dev_info(dev, "DLL locked; bus %lu Hz\n", clk_get_rate(hub->clocks[0].clk));
+	gpio = devm_gpiod_get(dev, "sensor-enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(gpio))
+		return dev_err_probe(dev, PTR_ERR(gpio), "sensor supply unavailable\n");
+	gpio = devm_gpiod_get(dev, "sensor-3v3-enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(gpio))
+		return dev_err_probe(dev, PTR_ERR(gpio), "3V3 supply unavailable\n");
+	usleep_range(5000, 6000);
+	hub->irq = platform_get_irq(pdev, 0);
+	if (hub->irq < 0)
+		return hub->irq;
+	/* Until firmware supplies the map, keep mailbox interrupts masked. */
+	writel(0xffff0000, hub->mailbox + INTMR0);
+	ret = devm_request_threaded_irq(dev, hub->irq, NULL, chub_irq,
+					IRQF_ONESHOT, dev_name(dev), hub);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, chub_stop, hub);
+	if (ret)
+		return ret;
+	ret = chub_boot(hub);
+	if (ret)
+		return dev_err_probe(dev, ret, "hub startup failed\n");
+	ret = chub_command(hub, CMD_GET, MCU, 27, NULL, 0, &mask, sizeof(mask));
+	if (ret)
+		return ret;
+	hub->sensor_mask = le64_to_cpu(mask);
+	dev_info(dev, "sensor mask %#llx\n", hub->sensor_mask);
+	ret = chub_command(hub, CMD_GET, MCU, 12, NULL, 0, &revision, sizeof(revision));
+	if (ret)
+		return ret;
+	dev_info(dev, "firmware revision %u\n", le32_to_cpu(revision));
+	for (i = 0; i < SENSOR_COUNT; i++) {
+		if (!(hub->sensor_mask & BIT_ULL(sensor_types[i])))
+			continue;
+		if (sensor_types[i] != LIGHT) {
+			ret = chub_command(hub, CMD_SET, sensor_types[i], 26,
+					   &position, sizeof(position), NULL, 0);
+			if (ret)
+				return ret;
+		}
+		ret = chub_register_sensor(hub, i);
+		if (ret)
+			return ret;
+	}
+	return chub_command(hub, CMD_SET, MCU, 1, NULL, 0, NULL, 0);
+}
+
+static int chub_suspend(struct device *dev)
+{
+	struct chub *hub = dev_get_drvdata(dev);
+	struct chub_sensor *sensor;
+	int i, ret;
+
+	WRITE_ONCE(hub->suspended, true);
+	for (i = 0; i < SENSOR_COUNT; i++) {
+		sensor = hub->sensors[i];
+		if (!sensor)
+			continue;
+		cancel_delayed_work_sync(&sensor->idle_work);
+		mutex_lock(&sensor->lock);
+		ret = chub_sensor_enable(sensor, false);
+		mutex_unlock(&sensor->lock);
+		if (ret) {
+			WRITE_ONCE(hub->suspended, false);
+			return ret;
+		}
+	}
+	ret = chub_command(hub, CMD_SET, MCU, 2, NULL, 0, NULL, 0);
+	if (ret)
+		WRITE_ONCE(hub->suspended, false);
+	return ret;
+}
+
+static int chub_resume(struct device *dev)
+{
+	struct chub *hub = dev_get_drvdata(dev);
+	int ret = chub_command(hub, CMD_SET, MCU, 1, NULL, 0, NULL, 0);
+
+	if (!ret)
+		WRITE_ONCE(hub->suspended, false);
+	return ret;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(chub_pm, chub_suspend, chub_resume);
+
+static void chub_shutdown(struct platform_device *pdev)
+{
+	chub_stop(platform_get_drvdata(pdev));
+}
+
+static const struct of_device_id chub_of_match[] = {
+	{ .compatible = "samsung,exynos9610-chub" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, chub_of_match);
+
+static struct platform_driver chub_driver = {
+	.probe = chub_probe,
+	.shutdown = chub_shutdown,
+	.driver = {
+		.name = "exynos9610-chub",
+		.of_match_table = chub_of_match,
+		.pm = pm_sleep_ptr(&chub_pm),
+	},
+};
+module_platform_driver(chub_driver);
+
+MODULE_DESCRIPTION("Exynos9610 CHUB SSP IIO sensors");
+MODULE_LICENSE("GPL");
+MODULE_FIRMWARE(CHUB_BL);
+MODULE_FIRMWARE(CHUB_OS);
