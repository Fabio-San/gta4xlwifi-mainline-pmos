+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/samsung,exynos9610-boot-tmu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9610 bootloader-initialized thermal probes
+
+maintainers:
+  - linux-samsung-soc@vger.kernel.org
+
+description: |
+  Handover of an enabled, calibrated TMU. The bootloader configuration,
+  including hardware thermal trips, is retained. Sensor IDs are 0 for GPU,
+  1 for Cortex-A53 and 2 for Cortex-A73. Linux polls these probes.
+
+properties:
+  compatible:
+    const: samsung,exynos9610-boot-tmu
+
+  reg:
+    maxItems: 1
+
+  '#thermal-sensor-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - '#thermal-sensor-cells'
+
+additionalProperties: false
