@@ -10,7 +10,7 @@
   - linux-samsung-soc@vger.kernel.org
 
 description: |
-  ACPM firmware exposes a PMIC protocol through mailbox doorbells and SRAM
+  ACPM firmware exposes PMIC and DVFS protocols through mailbox doorbells and SRAM
   queues. The Exynos9610 channel table starts at SRAM offset 0x6f00.
 
 properties:
@@ -23,6 +23,25 @@
   shmem:
     maxItems: 1
 
+  '#clock-cells':
+    const: 1
+
+  samsung,enable-dvfs:
+    type: boolean
+    description: Load the downstream FVP plugin and expose firmware clocks.
+
+  samsung,thermal:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Calibrated TMU that must bind before CPU clocks are exposed.
+
+  clocks:
+    maxItems: 2
+
+  clock-names:
+    items:
+      - const: cpucl0-switch
+      - const: cpucl1-switch
+
   pmic:
     $ref: /schemas/regulator/samsung,s2mpu09.yaml#
 
@@ -31,4 +50,11 @@
   - mboxes
   - shmem
 
+dependencies:
+  samsung,enable-dvfs:
+    - '#clock-cells'
+    - samsung,thermal
+    - clocks
+    - clock-names
+
 additionalProperties: false
