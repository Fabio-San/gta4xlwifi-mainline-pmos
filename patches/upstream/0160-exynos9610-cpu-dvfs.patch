+/* Exynos9610's FREQ channel belongs to the dynamically loaded FVP plugin. */
+static int acpm_exynos9610_load_plugin(struct acpm_info *acpm, u32 id,
+					const char *name)
+{
+	const struct firmware *fw;
+	struct acpm_xfer xfer;
+	void __iomem *plugin;
+	u32 cmd[4] = { BIT(25) | (id << 26), 0, 0, 0 };
+	u32 offset, base, size;
+	u32 expected_base = id == 2 ? 0x9000 : 0xa400;
+	int ret;
+
+	if (!of_device_is_compatible(acpm->dev->of_node,
+				     "samsung,exynos9610-acpm-ipc"))
+		return -EINVAL;
+
+	/* struct plugin is twelve 32-bit words in the downstream firmware. */
+	offset = readl(&acpm->shmem->reserved[0]);
+	if (readl(&acpm->shmem->reserved[1]) <= id || (offset & 3) ||
+	    acpm->sram_size < (id + 1) * 48 ||
+	    offset > acpm->sram_size - (id + 1) * 48)
+		return -EINVAL;
+	plugin = acpm->sram_base + offset + id * 48;
+	if (readl(plugin) != id)
+		return -EINVAL;
+	base = readl(plugin + 4) & ~1U;
+	size = readl(plugin + 36);
+	if (base != expected_base || size != 0x1400 ||
+	    base >= acpm->sram_size || size > acpm->sram_size - base)
+		return -EINVAL;
+
+	if (readl(plugin + 32) & 0xff)
+		return 0;
+
+	ret = request_firmware(&fw, name, acpm->dev);
+	if (ret)
+		return ret;
+	if (fw->size != size || (fw->size & 3)) {
+		release_firmware(fw);
+		return -EINVAL;
+	}
+	/* SRAM only supports aligned word accesses. */
+	__iowrite32_copy(acpm->sram_base + base, fw->data, fw->size / 4);
+	release_firmware(fw);
+
+	acpm_set_xfer(&xfer, cmd, ARRAY_SIZE(cmd), 4, true);
+	ret = acpm_do_xfer(&acpm->handle, &xfer);
+	if (ret)
+		return ret;
+	if (((cmd[0] >> 26) & 7) != id || !(readl(plugin + 32) & 0xff))
+		return -EIO;
+
+	dev_info(acpm->dev, "Plugin %u attached: %s\n", id, name);
+	return 0;
+}
