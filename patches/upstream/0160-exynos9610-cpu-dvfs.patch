--- /dev/null
+++ b/drivers/thermal/samsung/exynos9610_boot_tmu.c
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos9610 TMU handover. The Samsung bootloader enables all three probes
+ * and programs the hardware over-temperature trips. Retain that setup;
+ * expose calibrated CPU/GPU temperatures for Linux polling and cooling.
+ * Register layout and calibration are from Samsung's downstream TMU driver.
+ */
+#include <linux/bitfield.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+
+#define TMU_CONTROL		0x20
+#define TMU_CURRENT_TEMP	0x40
+#define TMU_CORE_EN		BIT(0)
+#define TMU_TWO_POINT		BIT(23)
+#define TMU_TEMP_MASK		GENMASK(8, 0)
+#define TMU_TRIM85_MASK		GENMASK(17, 9)
+
+struct exynos9610_tmu;
+
+struct exynos9610_sensor {
+	struct exynos9610_tmu *tmu;
+	unsigned int id;
+	int error25;
+	int error85;
+};
+
+struct exynos9610_tmu {
+	void __iomem *base;
+	bool two_point;
+	struct exynos9610_sensor sensors[3];
+};
+
+static int exynos9610_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct exynos9610_sensor *sensor = thermal_zone_device_priv(tz);
+	struct exynos9610_tmu *tmu = sensor->tmu;
+	u32 val;
+	int code;
+
+	if (!(readl(tmu->base + TMU_CONTROL) & TMU_CORE_EN))
+		return -EIO;
+
+	/* P0/P1 are packed in TEMP1_0, P2 starts TEMP4_2. */
+	val = readl(tmu->base + TMU_CURRENT_TEMP + (sensor->id == 2 ? 4 : 0));
+	code = (val >> (sensor->id == 1 ? 9 : 0)) & TMU_TEMP_MASK;
+	if (!code || code == TMU_TEMP_MASK)
+		return -EIO;
+
+	if (tmu->two_point)
+		*temp = (code - sensor->error25) * 60000 /
+			(sensor->error85 - sensor->error25) + 25000;
+	else
+		*temp = (code - sensor->error25 + 25) * 1000;
+
+	return 0;
+}
+
+static const struct thermal_zone_device_ops exynos9610_tmu_ops = {
+	.get_temp = exynos9610_get_temp,
+};
+
+static int exynos9610_tmu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct thermal_zone_device *tz;
+	struct exynos9610_tmu *tmu;
+	u32 trim;
+	int i, ret, temp;
+
+	tmu = devm_kzalloc(dev, sizeof(*tmu), GFP_KERNEL);
+	if (!tmu)
+		return -ENOMEM;
+	tmu->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(tmu->base))
+		return PTR_ERR(tmu->base);
+
+	if (!(readl(tmu->base + TMU_CONTROL) & TMU_CORE_EN))
+		return dev_err_probe(dev, -ENODEV, "Bootloader TMU is disabled\n");
+
+	tmu->two_point = readl(tmu->base) & TMU_TWO_POINT;
+	for (i = 0; i < ARRAY_SIZE(tmu->sensors); i++) {
+		struct exynos9610_sensor *sensor = &tmu->sensors[i];
+
+		trim = readl(tmu->base + i * 4);
+		sensor->tmu = tmu;
+		sensor->id = i;
+		sensor->error25 = FIELD_GET(TMU_TEMP_MASK, trim);
+		sensor->error85 = FIELD_GET(TMU_TRIM85_MASK, trim);
+		if (!sensor->error25 ||
+		    (tmu->two_point && sensor->error85 <= sensor->error25))
+			return dev_err_probe(dev, -EINVAL, "Invalid TMU calibration\n");
+
+		tz = devm_thermal_of_zone_register(dev, i, sensor, &exynos9610_tmu_ops);
+		if (IS_ERR(tz))
+			return dev_err_probe(dev, PTR_ERR(tz), "Failed to register probe %d\n", i);
+		ret = exynos9610_get_temp(tz, &temp);
+		if (ret)
+			return dev_err_probe(dev, ret, "TMU probe %d is not reading\n", i);
+		dev_info(dev, "P%d calibrated temperature: %d mC\n", i, temp);
+	}
+
+	platform_set_drvdata(pdev, tmu);
+	return 0;
+}
+
+static const struct of_device_id exynos9610_tmu_match[] = {
+	{ .compatible = "samsung,exynos9610-boot-tmu" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos9610_tmu_match);
+
+static struct platform_driver exynos9610_tmu_driver = {
+	.probe = exynos9610_tmu_probe,
+	.driver = {
+		.name = "exynos9610-boot-tmu",
+		.of_match_table = exynos9610_tmu_match,
+	},
+};
+module_platform_driver(exynos9610_tmu_driver);
+
+MODULE_DESCRIPTION("Exynos9610 bootloader TMU handover");
+MODULE_LICENSE("GPL");
