 }
 
+/* Samsung's 9610 FVP ABI reserves word 3; it is not a timestamp. */
+int acpm_dvfs_set_rate_exynos9610(struct acpm_handle *handle,
+				unsigned int acpm_chan_id, unsigned int clk_id,
+				unsigned long rate)
+{
+	struct acpm_xfer xfer;
+	u32 cmd[4] = { clk_id, rate / HZ_PER_KHZ, ACPM_DVFS_FREQ_REQ, 0 };
+	int ret;
+
+	acpm_set_xfer(&xfer, cmd, ARRAY_SIZE(cmd), acpm_chan_id, true);
+	ret = acpm_do_xfer(handle, &xfer);
+	if (ret)
+		return ret;
+
+	return FIELD_GET(ACPM_DVFS_ID, cmd[0]) == clk_id ? 0 : -EIO;
+}
