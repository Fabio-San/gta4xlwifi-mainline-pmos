diff --git a/drivers/clk/samsung/clk-acpm.c b/drivers/clk/samsung/clk-acpm.c
--- a/drivers/clk/samsung/clk-acpm.c
+++ b/drivers/clk/samsung/clk-acpm.c
@@ -6,6 +6,11 @@
  */
 
 #include <linux/array_size.h>
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/math64.h>
+#include <linux/sizes.h>
 #include <linux/clk-provider.h>
 #include <linux/container_of.h>
 #include <linux/device/devres.h>
@@ -15,16 +20,28 @@
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/types.h>
+#include <linux/of_platform.h>
 
 struct acpm_clk {
 	u32 id;
 	struct clk_hw hw;
 	unsigned int mbox_chan_id;
 	struct acpm_handle *handle;
+	void __iomem *cpu_cmu;
+	struct clk *switch_clk;
+	u32 pll_offset;
+	u32 switch_offset;
+	unsigned long min_rate;
+	unsigned long max_rate;
 };
 
 struct acpm_clk_variant {
 	const char *name;
+	resource_size_t cmu_base;
+	u32 pll_offset;
+	u32 switch_offset;
+	unsigned long min_rate;
+	unsigned long max_rate;
 };
 
 struct acpm_clk_driver_data {
@@ -63,6 +80,19 @@
 	.mbox_chan_id = 0,
 };
 
+/* IDs match cal-if/exynos9610/acpm_dvfs_exynos9610.h. */
+static const struct acpm_clk_variant exynos9610_acpm_clks[] = {
+	/* Only the two CPU domains are exposed on this port. */
+	[2] = { "acpm_cpucl0", 0x10900000, 0x140, 0x120, 403000000, 1742000000 },
+	[3] = { "acpm_cpucl1", 0x10800000, 0x120, 0x100, 936000000, 2314000000 },
+};
+
+static const struct acpm_clk_driver_data acpm_clk_exynos9610 = {
+	.clks = exynos9610_acpm_clks,
+	.nr_clks = ARRAY_SIZE(exynos9610_acpm_clks),
+	.mbox_chan_id = 0,
+};
+
 static unsigned long acpm_clk_recalc_rate(struct clk_hw *hw,
 					  unsigned long parent_rate)
 {
@@ -87,6 +117,66 @@
 	.set_rate = acpm_clk_set_rate,
 };
 
+/*
+ * Exynos9610 FVP acknowledges FREQ_GET but returns zero. Like downstream
+ * cal_dfs_get_rate(), read the CPU PLL instead. Firmware retains exclusive
+ * write ownership of the PLL, muxes, dividers and regulator sequencing.
+ * CPUCL0 and CPUCL1 have different PLL offsets; both were checked against
+ * the running firmware's FVMAP PLL headers and downstream CMUCAL registers.
+ */
+static unsigned long exynos9610_cpu_recalc_rate(struct clk_hw *hw,
+					      unsigned long parent_rate)
+{
+	struct acpm_clk *clk = to_acpm_clk(hw);
+	u32 pms, p, m, s;
+
+	if (readl(clk->cpu_cmu + 0x1000) & BIT(0)) {
+		if (!(readl(clk->cpu_cmu + clk->switch_offset) & BIT(4)))
+			return 26000000;
+		return clk_get_rate(clk->switch_clk);
+	}
+
+	pms = readl(clk->cpu_cmu + clk->pll_offset);
+	if (!(pms & BIT(4)))
+		return 26000000;
+	p = FIELD_GET(GENMASK(13, 8), pms);
+	m = FIELD_GET(GENMASK(25, 16), pms);
+	s = FIELD_GET(GENMASK(2, 0), pms);
+	if (!p)
+		return 0;
+
+	return div_u64(26000000ULL * m, p << s);
+}
+
+static int exynos9610_cpu_set_rate(struct clk_hw *hw, unsigned long rate,
+				 unsigned long parent_rate)
+{
+	struct acpm_clk *clk = to_acpm_clk(hw);
+	unsigned long actual;
+	int ret;
+
+	if (rate < clk->min_rate || rate > clk->max_rate)
+		return -EINVAL;
+
+	ret = acpm_clk_set_rate(hw, rate, parent_rate);
+	if (ret)
+		return ret;
+
+	actual = exynos9610_cpu_recalc_rate(hw, parent_rate);
+	if (actual != rate) {
+		pr_err_ratelimited("ACPM CPU%u: requested %lu Hz, read %lu Hz\n",
+				   clk->id - 2, rate, actual);
+		return -EIO;
+	}
+	return 0;
+}
+
+static const struct clk_ops exynos9610_cpu_clk_ops = {
+	.recalc_rate = exynos9610_cpu_recalc_rate,
+	.determine_rate = clk_determine_rate_noop,
+	.set_rate = exynos9610_cpu_set_rate,
+};
+
 static int acpm_clk_register(struct device *dev, struct acpm_clk *aclk,
 			     const char *name)
 {
@@ -94,6 +184,10 @@
 
 	init.name = name;
 	init.ops = &acpm_clk_ops;
+	if (aclk->cpu_cmu) {
+		init.ops = &exynos9610_cpu_clk_ops;
+		init.flags = CLK_GET_RATE_NOCACHE;
+	}
 	aclk->hw.init = &init;
 
 	return devm_clk_hw_register(dev, &aclk->hw);
@@ -101,6 +195,7 @@
 
 static int acpm_clk_probe(struct platform_device *pdev)
 {
+	const struct acpm_clk_driver_data *data;
 	struct acpm_handle *acpm_handle;
 	struct clk_hw_onecell_data *clk_data;
 	struct clk_hw **hws;
@@ -109,13 +204,32 @@
 	unsigned int mbox_chan_id;
 	int i, err, count;
 
+	/* Refuse CPU scaling until calibrated thermal monitoring is bound. */
+	if (platform_get_device_id(pdev)->driver_data ==
+	    (kernel_ulong_t)&acpm_clk_exynos9610) {
+		struct device_node *np;
+		struct platform_device *tmu;
+		bool ready;
+
+		np = of_parse_phandle(dev->parent->of_node, "samsung,thermal", 0);
+		if (!np)
+			return -EINVAL;
+		tmu = of_find_device_by_node(np);
+		of_node_put(np);
+		ready = tmu && platform_get_drvdata(tmu);
+		platform_device_put(tmu);
+		if (!ready)
+			return -EPROBE_DEFER;
+	}
+
 	acpm_handle = devm_acpm_get_by_node(dev, dev->parent->of_node);
 	if (IS_ERR(acpm_handle))
 		return dev_err_probe(dev, PTR_ERR(acpm_handle),
 				     "Failed to get acpm handle\n");
 
-	count = acpm_clk_gs101.nr_clks;
-	mbox_chan_id = acpm_clk_gs101.mbox_chan_id;
+	data = (const void *)platform_get_device_id(pdev)->driver_data;
+	count = data->nr_clks;
+	mbox_chan_id = data->mbox_chan_id;
 
 	clk_data = devm_kzalloc(dev, struct_size(clk_data, hws, count),
 				GFP_KERNEL);
@@ -131,6 +245,27 @@
 
 	for (i = 0; i < count; i++) {
 		struct acpm_clk *aclk = &aclks[i];
+		const struct acpm_clk_variant *variant = &data->clks[i];
+
+		if (!variant->name) {
+			hws[i] = ERR_PTR(-ENOENT);
+			continue;
+		}
+
+		if (variant->cmu_base) {
+			aclk->cpu_cmu = devm_ioremap(dev, variant->cmu_base, SZ_8K);
+			if (!aclk->cpu_cmu)
+				return -ENOMEM;
+			aclk->switch_clk = devm_clk_get(dev->parent,
+						 i == 2 ? "cpucl0-switch" : "cpucl1-switch");
+			if (IS_ERR(aclk->switch_clk))
+				return dev_err_probe(dev, PTR_ERR(aclk->switch_clk),
+						     "Failed to get CPU switch clock\n");
+			aclk->pll_offset = variant->pll_offset;
+			aclk->switch_offset = variant->switch_offset;
+			aclk->min_rate = variant->min_rate;
+			aclk->max_rate = variant->max_rate;
+		}
 
 		/*
 		 * The code assumes the clock IDs start from zero,
@@ -143,7 +278,7 @@
 		hws[i] = &aclk->hw;
 
 		err = acpm_clk_register(dev, aclk,
-					acpm_clk_gs101.clks[i].name);
+					data->clks[i].name);
 		if (err)
 			return dev_err_probe(dev, err,
 					     "Failed to register clock\n");
@@ -154,7 +289,10 @@
 }
 
 static const struct platform_device_id acpm_clk_id[] = {
-	{ .name = "gs101-acpm-clk" },
+	{ .name = "gs101-acpm-clk",
+	  .driver_data = (kernel_ulong_t)&acpm_clk_gs101 },
+	{ .name = "exynos9610-acpm-clk",
+	  .driver_data = (kernel_ulong_t)&acpm_clk_exynos9610 },
 	{ }
 };
 MODULE_DEVICE_TABLE(platform, acpm_clk_id);
diff --git a/drivers/firmware/samsung/exynos-acpm-dvfs.c b/drivers/firmware/samsung/exynos-acpm-dvfs.c
--- a/drivers/firmware/samsung/exynos-acpm-dvfs.c
