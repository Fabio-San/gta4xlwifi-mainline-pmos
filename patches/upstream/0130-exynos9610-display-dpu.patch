+#include "hx83102e_seq.h"
+
+/* DSIM register offsets (Exynos 9610 layout). */
+#define DSIM_SWRST			0x0004
+#define DSIM_SWRST_RESET		BIT(0)
+#define DSIM_SWRST_FUNCRST		BIT(8)
+#define DSIM_SWRST_DPHY_RST		BIT(16)
+
+#define DSIM_LINK_STATUS3		0x0014
+#define DSIM_LINK_STATUS3_PLL_STABLE	BIT(0)
+
+#define DSIM_DPHY_STATUS		0x001c
+#define DSIM_DPHY_STATUS_TX_READY_HS_CLK	BIT(10)
+
+#define DSIM_CLK_CTRL			0x0020
+#define DSIM_CLK_CTRL_CLOCK_SEL		BIT(26)
+#define DSIM_CLK_CTRL_CLKLANE_ONOFF	BIT(24)
+#define DSIM_CLK_CTRL_TX_REQUEST_HSCLK	BIT(20)
+#define DSIM_CLK_CTRL_WORDCLK_EN	BIT(17)
+#define DSIM_CLK_CTRL_ESCCLK_EN		BIT(16)
+#define DSIM_CLK_CTRL_LANE_ESCCLK_EN(_v)	(((_v) & 0x1f) << 8)
+#define DSIM_CLK_CTRL_LANE_ESCCLK_MASK	(0x1f << 8)
+#define DSIM_CLK_CTRL_ESC_PRESCALER(_v)	((_v) << 0)
+#define DSIM_CLK_CTRL_ESC_PRESCALER_MASK	(0xff << 0)
+
+#define DSIM_TIMEOUT			0x0028
+#define DSIM_TIMEOUT_BTA(_v)		((_v) << 16)
+#define DSIM_TIMEOUT_LPDR(_v)		((_v) << 0)
+
+#define DSIM_ESCMODE			0x002c
+#define DSIM_ESCMODE_STOP_STATE_CNT(_v)	(((_v) & 0x7ff) << 21)
+
+#define DSIM_NUM_OF_TRANSFER		0x0030
+
+#define DSIM_THRESHOLD			0x0038
+
+#define DSIM_RESOL			0x003c
+#define DSIM_RESOL_VRESOL(_v)		(((_v) & 0x1fff) << 16)
+#define DSIM_RESOL_HRESOL(_v)		(((_v) & 0x1fff) << 0)
+
+#define DSIM_VPORCH			0x0040
+#define DSIM_VPORCH_VFP_CMD_ALLOW(_v)	(((_v) & 0xff) << 24)
+#define DSIM_VPORCH_STABLE_VFP(_v)	(((_v) & 0xff) << 16)
+#define DSIM_VPORCH_VFP(_v)		(((_v) & 0xff) << 8)
+#define DSIM_VPORCH_VBP(_v)		(((_v) & 0xff) << 0)
+
+#define DSIM_HPORCH			0x0044
+#define DSIM_HPORCH_HFP(_v)		(((_v) & 0xffff) << 16)
+#define DSIM_HPORCH_HBP(_v)		(((_v) & 0xffff) << 0)
+
+#define DSIM_SYNC			0x0048
+#define DSIM_SYNC_VSA(_v)		(((_v) & 0xff) << 16)
+#define DSIM_SYNC_HSA(_v)		(((_v) & 0xffff) << 0)
+
+#define DSIM_CONFIG			0x004c
+#define DSIM_CONFIG_SYNC_INFORM		BIT(27)
+#define DSIM_CONFIG_BURST_MODE		BIT(26)
+#define DSIM_CONFIG_HSE_DISABLE		BIT(23)
+#define DSIM_CONFIG_HFP_DISABLE		BIT(22)
+#define DSIM_CONFIG_HBP_DISABLE		BIT(21)
+#define DSIM_CONFIG_HSA_DISABLE		BIT(20)
+#define DSIM_CONFIG_VIDEO_MODE		BIT(18)
+#define DSIM_CONFIG_VC_ID(_v)		(((_v) & 0x3) << 15)
+#define DSIM_CONFIG_PIXEL_FORMAT(_v)	(((_v) & 0x3f) << 9)
+#define DSIM_CONFIG_PER_FRAME_READ	BIT(8)
+#define DSIM_CONFIG_EOTP_EN		BIT(7)
+#define DSIM_CONFIG_NUM_LANES(_v)	(((_v) & 0x3) << 5)
+#define DSIM_CONFIG_LANES_EN(_v)	(((_v) & 0x1f) << 0)
+
+#define DSIM_INTSRC			0x0050
+#define DSIM_INTMSK			0x0054
+#define DSIM_INTSRC_PLL_STABLE		BIT(31)
+#define DSIM_INTSRC_SFR_PH_FIFO_EMPTY	BIT(28)
+#define DSIM_INTSRC_FRAME_DONE		BIT(24)
+#define DSIM_INTSRC_UNDER_RUN		BIT(19)
+
+#define DSIM_PKTHDR			0x0058
+#define DSIM_PKTHDR_BTA(_v)		(((_v) & 0x1) << 24)
+#define DSIM_PKTHDR_DATA1(_v)		(((_v) & 0xff) << 16)
+#define DSIM_PKTHDR_DATA0(_v)		(((_v) & 0xff) << 8)
+#define DSIM_PKTHDR_ID(_v)		(((_v) & 0x3f) << 0)
+
+#define DSIM_PAYLOAD			0x005c
+
+#define DSIM_SFR_CTRL			0x0064
+#define DSIM_SFR_CTRL_SHADOW_READ_EN	BIT(1)
+#define DSIM_SFR_CTRL_SHADOW_EN		BIT(0)
+
+#define DSIM_FIFOCTRL			0x0068
+#define DSIM_FIFOCTRL_EMPTY_PH		BIT(10)
+#define DSIM_FIFOCTRL_EMPTY_PL		BIT(8)
+
+#define DSIM_PLLCTRL			0x00a0
+#define DSIM_PLLCTRL_PLL_EN		BIT(23)
+#define DSIM_PLLCTRL_PMS(_p, _m, _s) \
+	((((_p) & 0x3f) << 13) | (((_m) & 0x3ff) << 3) | ((_s) & 0x7))
+#define DSIM_PLL_CTRL1			0x00a4
+#define DSIM_PLL_CTRL2			0x00a8
+#define DSIM_PLLTMR			0x00ac
+
+#define DSIM_PHYCTRL_B1			0x00b0
+#define DSIM_PHYCTRL_B2			0x00b4
+#define DSIM_PHYCTRL_B3			0x00b8
+#define DSIM_PHYCTRL_B4			0x00bc
+#define DSIM_PHYCTRL_M1			0x00c0
+#define DSIM_PHYCTRL_M2			0x00c4
+#define DSIM_PHYCTRL_M3			0x00c8
+#define DSIM_PHYCTRL_M4			0x00cc
+
+#define DSIM_PHY_TIMING			0x00d0
+#define DSIM_PHY_TIMING_LPX(_v)		(((_v) & 0xff) << 8)
+#define DSIM_PHY_TIMING_HSEXIT(_v)	((_v) & 0xff)
+#define DSIM_PHY_TIMING1		0x00d4
+#define DSIM_PHY_TIMING1_CLKPREP(_v)	(((_v) & 0xff) << 24)
+#define DSIM_PHY_TIMING1_CLKZERO(_v)	(((_v) & 0xff) << 16)
+#define DSIM_PHY_TIMING1_CLKPOST(_v)	(((_v) & 0xff) << 8)
+#define DSIM_PHY_TIMING1_CLKTRAIL(_v)	((_v) & 0xff)
+#define DSIM_PHY_TIMING2		0x00d8
+#define DSIM_PHY_TIMING2_HSPREP(_v)	(((_v) & 0xff) << 16)
+#define DSIM_PHY_TIMING2_HSZERO(_v)	(((_v) & 0xff) << 8)
+#define DSIM_PHY_TIMING2_HSTRAIL(_v)	((_v) & 0xff)
+
+/* SYSREG_DISPAUD MIPI PHY control (DISP_DPU_MIPI_PHY_CON). */
+#define SYSREG_MIPI_PHY_CON		0x0008
+#define SYSREG_SEL_RESET_DPHY(_v)	BIT(4 + (_v))
+#define SYSREG_RESETN_M4S4_TOP		BIT(0)
+
+#define DSIM_LANES			4
+#define DSIM_ESC_CLK_MHZ		16
+#define DSIM_HS_CLK_MHZ			1030
+#define DSIM_PMS_P			2
+#define DSIM_PMS_M			317
+#define DSIM_PMS_S			2
+#define DSIM_PLL_TIMER			0x13880
+
+static inline void dsim_writel(struct exynos9610_drm *priv, u32 reg, u32 val)
+{
+	writel(val, priv->dsim + reg);
+}
+
+static inline u32 dsim_readl(struct exynos9610_drm *priv, u32 reg)
+{
+	return readl(priv->dsim + reg);
+}
+
+static inline void dsim_update(struct exynos9610_drm *priv, u32 reg, u32 val,
+			       u32 mask)
+{
+	u32 old = dsim_readl(priv, reg);
+
+	dsim_writel(priv, reg, (old & ~mask) | (val & mask));
+}
+
+static inline void sysreg_update(struct exynos9610_drm *priv, u32 reg, u32 val,
+				 u32 mask)
+{
+	u32 old = readl(priv->sysreg + reg);
+
+	writel((old & ~mask) | (val & mask), priv->sysreg + reg);
+}
+
+static int dsim_wait_pll_stable(struct exynos9610_drm *priv)
+{
+	u32 val;
+
+	return readl_poll_timeout(priv->dsim + DSIM_LINK_STATUS3, val,
+				  val & DSIM_LINK_STATUS3_PLL_STABLE,
+				  10, 10000);
+}
+
+static int dsim_wait_hs_clock(struct exynos9610_drm *priv)
+{
+	u32 val;
+
+	return readl_poll_timeout(priv->dsim + DSIM_DPHY_STATUS, val,
+				  val & DSIM_DPHY_STATUS_TX_READY_HS_CLK,
+				  10, 10000);
+}
+
+static void dsim_sw_reset(struct exynos9610_drm *priv)
+{
+	u32 val;
+
+	dsim_update(priv, DSIM_SWRST, DSIM_SWRST_RESET, DSIM_SWRST_RESET);
+	if (readl_poll_timeout(priv->dsim + DSIM_SWRST, val,
+			       !(val & DSIM_SWRST_RESET), 10, 10000))
+		dev_err(priv->drm.dev, "DSIM software reset timed out\n");
+}
+
+static void dsim_set_pll(struct exynos9610_drm *priv, bool enable)
+{
+	if (enable) {
+		dsim_writel(priv, DSIM_INTSRC, DSIM_INTSRC_PLL_STABLE);
+		dsim_update(priv, DSIM_PLLCTRL, DSIM_PLLCTRL_PLL_EN,
+			    DSIM_PLLCTRL_PLL_EN);
+		if (dsim_wait_pll_stable(priv))
+			dev_err(priv->drm.dev, "DSIM PLL did not lock\n");
+	} else {
+		dsim_update(priv, DSIM_PLLCTRL, 0, DSIM_PLLCTRL_PLL_EN);
+	}
+}
+
+/*
+ * Program the D-PHY timing. The values below are the panel-specific timing
+ * table entries for 1030 Mbps used by the downstream driver.
+ */
+static void dsim_set_dphy_timing(struct exynos9610_drm *priv)
+{
+	/* clk_prepare=10 clk_zero=16 clk_post=7 clk_trail=6
+	 * hs_prepare=9 hs_zero=6 hs_trail=10 lpx=6 hs_exit=6
+	 */
+	dsim_writel(priv, DSIM_PHY_TIMING,
+		    DSIM_PHY_TIMING_LPX(6) | DSIM_PHY_TIMING_HSEXIT(6));
+	dsim_writel(priv, DSIM_PHY_TIMING1,
+		    DSIM_PHY_TIMING1_CLKPREP(10) |
+		    DSIM_PHY_TIMING1_CLKZERO(16) |
+		    DSIM_PHY_TIMING1_CLKPOST(7) |
+		    DSIM_PHY_TIMING1_CLKTRAIL(6));
+	dsim_writel(priv, DSIM_PHY_TIMING2,
+		    DSIM_PHY_TIMING2_HSPREP(9) |
+		    DSIM_PHY_TIMING2_HSZERO(6) |
+		    DSIM_PHY_TIMING2_HSTRAIL(10));
+
+	/* b_dphyctl for a 16 MHz escape clock. */
+	dsim_writel(priv, DSIM_PHYCTRL_B1, 0x190);
+}
+
+static void dsim_set_config(struct exynos9610_drm *priv,
+			    const struct drm_display_mode *mode)
+{
+	u32 hbp = mode->htotal - mode->hsync_end;
+	u32 hfp = mode->hsync_start - mode->hdisplay;
+	u32 hsa = mode->hsync_end - mode->hsync_start;
+	u32 vbp = mode->vtotal - mode->vsync_end;
+	u32 vfp = mode->vsync_start - mode->vdisplay;
+	u32 vsa = mode->vsync_end - mode->vsync_start;
+	u32 num_transfer = mode->hdisplay * mode->vdisplay / mode->hdisplay;
+
+	/* Use raw porch values; this matches the panel's DTS timing. */
+	dsim_writel(priv, DSIM_VPORCH,
+		    DSIM_VPORCH_VFP_CMD_ALLOW(4) |
+		    DSIM_VPORCH_STABLE_VFP(2) |
+		    DSIM_VPORCH_VFP(vfp) | DSIM_VPORCH_VBP(vbp));
+	dsim_writel(priv, DSIM_HPORCH,
+		    DSIM_HPORCH_HFP(hfp) | DSIM_HPORCH_HBP(hbp));
+	dsim_writel(priv, DSIM_SYNC,
+		    DSIM_SYNC_VSA(vsa) | DSIM_SYNC_HSA(hsa));
+
+	dsim_update(priv, DSIM_SFR_CTRL, DSIM_SFR_CTRL_SHADOW_READ_EN,
+		    DSIM_SFR_CTRL_SHADOW_READ_EN);
+	dsim_writel(priv, DSIM_TIMEOUT,
+		    DSIM_TIMEOUT_BTA(0xff) | DSIM_TIMEOUT_LPDR(0xffff));
+	dsim_update(priv, DSIM_ESCMODE,
+		    DSIM_ESCMODE_STOP_STATE_CNT(0xa),
+		    DSIM_ESCMODE_STOP_STATE_CNT(0x7ff));
+	dsim_writel(priv, DSIM_THRESHOLD, mode->hdisplay);
+	dsim_writel(priv, DSIM_RESOL,
+		    DSIM_RESOL_VRESOL(mode->vdisplay) |
+		    DSIM_RESOL_HRESOL(mode->hdisplay));
+	dsim_writel(priv, DSIM_NUM_OF_TRANSFER, num_transfer);
+
+	dsim_update(priv, DSIM_CONFIG, DSIM_CONFIG_NUM_LANES(DSIM_LANES - 1),
+		    DSIM_CONFIG_NUM_LANES(0x3));
+	dsim_update(priv, DSIM_CONFIG,
+		    DSIM_CONFIG_EOTP_EN | DSIM_CONFIG_PIXEL_FORMAT(0x3e) |
+		    DSIM_CONFIG_VC_ID(0),
+		    DSIM_CONFIG_EOTP_EN | DSIM_CONFIG_PIXEL_FORMAT(0x3f) |
+		    DSIM_CONFIG_VC_ID(0x3));
+	dsim_update(priv, DSIM_CONFIG, 0, DSIM_CONFIG_PER_FRAME_READ);
+
+	/* Video mode: no HSA/HBP/HSE suppression, HFP suppressed, burst on. */
+	dsim_update(priv, DSIM_CONFIG, 0,
+		    DSIM_CONFIG_HSA_DISABLE | DSIM_CONFIG_HBP_DISABLE |
+		    DSIM_CONFIG_HSE_DISABLE | DSIM_CONFIG_SYNC_INFORM);
+	dsim_update(priv, DSIM_CONFIG, DSIM_CONFIG_HFP_DISABLE,
+		    DSIM_CONFIG_HFP_DISABLE);
+	dsim_update(priv, DSIM_CONFIG, DSIM_CONFIG_BURST_MODE,
+		    DSIM_CONFIG_BURST_MODE);
+
+	/*
+	 * Enable video mode directly. The downstream driver does this under
+	 * the shadow register, which only works because its DSIM is already
+	 * running video timing. After a panel power cycle there is no frame
+	 * boundary to apply the shadow update, so write it immediately.
+	 */
+	dsim_update(priv, DSIM_CONFIG, DSIM_CONFIG_VIDEO_MODE,
+		    DSIM_CONFIG_VIDEO_MODE);
+	dsim_update(priv, DSIM_CLK_CTRL, DSIM_CLK_CTRL_CLKLANE_ONOFF,
+		    DSIM_CLK_CTRL_CLKLANE_ONOFF);
+
+	/* Two-byte PPI, as used by the downstream DSIM setup. */
+	dsim_update(priv, 0x009c, 0, BIT(9));
+}
+
+static void dsim_enable_lanes(struct exynos9610_drm *priv, bool enable)
+{
+	dsim_update(priv, DSIM_CONFIG,
+		    enable ? DSIM_CONFIG_LANES_EN(0x1f) : 0,
+		    DSIM_CONFIG_LANES_EN(0x1f));
+}
+
+int exynos9610_dsi_init(struct exynos9610_drm *priv,
+			const struct drm_display_mode *mode)
+{
+	u32 esc_div = DSIM_HS_CLK_MHZ / 16 / DSIM_ESC_CLK_MHZ;
+
+	if (priv->pmu) {
+		/* Release the MIPI PHY isolation. */
+		regmap_update_bits(priv->pmu, 0x70c, BIT(0), BIT(0));
+	}
+
+	/* Route D-PHY reset control to DSIM and assert the reset. */
+	sysreg_update(priv, SYSREG_MIPI_PHY_CON, 0,
+		      SYSREG_SEL_RESET_DPHY(0) | SYSREG_RESETN_M4S4_TOP);
+	dsim_update(priv, DSIM_SWRST, 0, DSIM_SWRST_DPHY_RST);
+
+	dsim_sw_reset(priv);
+
+	/* Select OSC clock while configuring the PHY. */
+	dsim_update(priv, DSIM_CLK_CTRL, 0, DSIM_CLK_CTRL_CLOCK_SEL);
+
+	dsim_update(priv, DSIM_CLK_CTRL,
+		    DSIM_CLK_CTRL_ESCCLK_EN |
+		    DSIM_CLK_CTRL_ESC_PRESCALER(esc_div),
+		    DSIM_CLK_CTRL_ESCCLK_EN |
+		    DSIM_CLK_CTRL_ESC_PRESCALER_MASK);
+	dsim_set_dphy_timing(priv);
+
+	dsim_writel(priv, DSIM_PLL_CTRL1, 0);
+	dsim_writel(priv, DSIM_PLL_CTRL2, 0);
+	dsim_writel(priv, DSIM_PHYCTRL_B2, 0x800);
+	dsim_writel(priv, DSIM_PHYCTRL_B3, 0);
+	dsim_writel(priv, DSIM_PHYCTRL_B4, 0x40);
+	dsim_writel(priv, DSIM_PHYCTRL_M1, 0);
+	dsim_writel(priv, DSIM_PHYCTRL_M2, 0);
+	dsim_writel(priv, DSIM_PHYCTRL_M3, 0);
+	dsim_writel(priv, DSIM_PHYCTRL_M4, 0);
+
+	/* Force a fresh lock even if the bootloader left the PLL running. */
+	dsim_set_pll(priv, false);
+	udelay(100);
+	dsim_writel(priv, DSIM_PLLCTRL,
+		    DSIM_PLLCTRL_PMS(DSIM_PMS_P, DSIM_PMS_M, DSIM_PMS_S));
+	dsim_writel(priv, DSIM_PLLTMR, DSIM_PLL_TIMER);
+	dsim_set_pll(priv, true);
+
+	dsim_enable_lanes(priv, true);
+	usleep_range(400, 500);
+
+	/* Release the D-PHY reset and switch to the word clock. */
+	sysreg_update(priv, SYSREG_MIPI_PHY_CON, SYSREG_RESETN_M4S4_TOP,
+		      SYSREG_RESETN_M4S4_TOP);
+	dsim_update(priv, DSIM_CLK_CTRL, DSIM_CLK_CTRL_CLOCK_SEL,
+		    DSIM_CLK_CTRL_CLOCK_SEL);
+	/* Match the bootloader: escape clock on the clock and all data lanes. */
+	dsim_update(priv, DSIM_CLK_CTRL,
+		    DSIM_CLK_CTRL_LANE_ESCCLK_EN(0x1f),
+		    DSIM_CLK_CTRL_LANE_ESCCLK_MASK);
+	dsim_update(priv, DSIM_CLK_CTRL, DSIM_CLK_CTRL_WORDCLK_EN,
+		    DSIM_CLK_CTRL_WORDCLK_EN);
+
+	dsim_set_config(priv, mode);
+
+	return 0;
+}
+
+void exynos9610_dsi_start(struct exynos9610_drm *priv)
+{
+	dsim_update(priv, DSIM_CLK_CTRL, DSIM_CLK_CTRL_TX_REQUEST_HSCLK,
+		    DSIM_CLK_CTRL_TX_REQUEST_HSCLK);
+	if (dsim_wait_hs_clock(priv))
+		dev_warn(priv->drm.dev, "DSIM HS clock not ready\n");
+
+	dsim_writel(priv, DSIM_INTSRC, 0xffffffff);
+	dsim_writel(priv, DSIM_INTMSK, 0xffffffff);
+}
+
+void exynos9610_dsi_stop(struct exynos9610_drm *priv)
+{
+	dsim_update(priv, DSIM_CLK_CTRL, 0, DSIM_CLK_CTRL_TX_REQUEST_HSCLK);
+	dsim_update(priv, DSIM_CLK_CTRL, 0, DSIM_CLK_CTRL_CLOCK_SEL);
+	dsim_enable_lanes(priv, false);
+	dsim_set_pll(priv, false);
+}
+
+int exynos9610_dsi_dcs_write(struct exynos9610_drm *priv, const u8 *data,
+			     size_t len)
+{
+	u32 val;
+	size_t i;
+
+	if (!len)
+		return 0;
+
+	/* Long packet: payload first, then the packet header. */
+	for (i = 0; i < len; i += 4) {
+		u32 payload = data[i];
+
+		if (i + 1 < len)
+			payload |= data[i + 1] << 8;
+		if (i + 2 < len)
+			payload |= data[i + 2] << 16;
+		if (i + 3 < len)
+			payload |= data[i + 3] << 24;
+		dsim_writel(priv, DSIM_PAYLOAD, payload);
+	}
+
+	dsim_writel(priv, DSIM_PKTHDR,
+		    DSIM_PKTHDR_BTA(0) |
+		    DSIM_PKTHDR_DATA1((len >> 8) & 0xff) |
+		    DSIM_PKTHDR_DATA0(len & 0xff) |
+		    DSIM_PKTHDR_ID(MIPI_DSI_DCS_LONG_WRITE));
+
+	if (readl_poll_timeout(priv->dsim + DSIM_FIFOCTRL, val,
+			       val & DSIM_FIFOCTRL_EMPTY_PH, 10, 50000)) {
+		dev_err(priv->drm.dev, "DSIM command FIFO timed out\n");
+		return -ETIMEDOUT;
+	}
+
+	return 0;
+}
+
+static int panel_write(struct exynos9610_drm *priv, const u8 *cmd, size_t len)
+{
+	return exynos9610_dsi_dcs_write(priv, cmd, len);
+}
+
+int exynos9610_panel_power_on(struct exynos9610_drm *priv)
+{
+	if (priv->ldo_en)
+		gpiod_set_value_cansleep(priv->ldo_en, 1);
+	usleep_range(5000, 6000);
+	if (priv->buck_en)
+		gpiod_set_value_cansleep(priv->buck_en, 1);
+	usleep_range(5000, 6000);
+	if (priv->panel_reset)
+		gpiod_set_value_cansleep(priv->panel_reset, 1);
+	usleep_range(5000, 6000);
+
+	return 0;
+}
+
+void exynos9610_panel_power_off(struct exynos9610_drm *priv)
+{
+	msleep(40);
+	if (priv->panel_reset)
+		gpiod_set_value_cansleep(priv->panel_reset, 0);
+	usleep_range(5000, 6000);
+	if (priv->buck_en)
+		gpiod_set_value_cansleep(priv->buck_en, 0);
+	usleep_range(5000, 6000);
+	if (priv->ldo_en)
+		gpiod_set_value_cansleep(priv->ldo_en, 0);
+}
+
+void exynos9610_panel_reset(struct exynos9610_drm *priv)
+{
+	if (!priv->panel_reset)
+		return;
+
+	gpiod_set_value_cansleep(priv->panel_reset, 1);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(priv->panel_reset, 0);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(priv->panel_reset, 1);
+	msleep(60);
+}
+
+int exynos9610_panel_init(struct exynos9610_drm *priv)
+{
+	int ret;
+
+	dsim_writel(priv, DSIM_PHYCTRL_M3, 0x50400);
+	usleep_range(1000, 2000);
+
+	/* Enable vendor command access. */
+	ret = panel_write(priv, SEQ_SET_B9_PW, ARRAY_SIZE(SEQ_SET_B9_PW));
+	if (ret)
+		return ret;
+
+	panel_write(priv, SEQ_SET_E9_OTP_SETTING, ARRAY_SIZE(SEQ_SET_E9_OTP_SETTING));
+	panel_write(priv, SEQ_SET_BB_OTP_SETTING, ARRAY_SIZE(SEQ_SET_BB_OTP_SETTING));
+	panel_write(priv, SEQ_SET_E9_OTP_SETTING2, ARRAY_SIZE(SEQ_SET_E9_OTP_SETTING2));
+	panel_write(priv, SEQ_SET_BA_REGISTER, ARRAY_SIZE(SEQ_SET_BA_REGISTER));
+	panel_write(priv, SEQ_HX83102E_BL, ARRAY_SIZE(SEQ_HX83102E_BL));
+	panel_write(priv, SEQ_HX83102E_BLON, ARRAY_SIZE(SEQ_HX83102E_BLON));
+	panel_write(priv, SEQ_HX83102E_BL_PWM_PREQ, ARRAY_SIZE(SEQ_HX83102E_BL_PWM_PREQ));
+	panel_write(priv, SEQ_SET_CABC_PRIORITY_SETTING, ARRAY_SIZE(SEQ_SET_CABC_PRIORITY_SETTING));
+	panel_write(priv, SEQ_SET_D2_VOP, ARRAY_SIZE(SEQ_SET_D2_VOP));
+	panel_write(priv, SEQ_HX83102E_BL_PAD, ARRAY_SIZE(SEQ_HX83102E_BL_PAD));
+	panel_write(priv, SEQ_SET_D5_GIP_FORWARD, ARRAY_SIZE(SEQ_SET_D5_GIP_FORWARD));
+	panel_write(priv, SEQ_SET_D6_GIP_BACKWARD, ARRAY_SIZE(SEQ_SET_D6_GIP_BACKWARD));
+	panel_write(priv, SEQ_SET_B4_TIMING, ARRAY_SIZE(SEQ_SET_B4_TIMING));
+	panel_write(priv, SEQ_SET_D3_GIP0, ARRAY_SIZE(SEQ_SET_D3_GIP0));
+	panel_write(priv, SEQ_SET_D1_TP_CTRL, ARRAY_SIZE(SEQ_SET_D1_TP_CTRL));
+	panel_write(priv, SEQ_SET_B1_POWER, ARRAY_SIZE(SEQ_SET_B1_POWER));
+	panel_write(priv, SEQ_SET_B2_RESOLUTION, ARRAY_SIZE(SEQ_SET_B2_RESOLUTION));
+	panel_write(priv, SEQ_SET_E0_ANALOG_GAMMA, ARRAY_SIZE(SEQ_SET_E0_ANALOG_GAMMA));
+	panel_write(priv, SEQ_SET_C0_GAMMA_OPT, ARRAY_SIZE(SEQ_SET_C0_GAMMA_OPT));
+	panel_write(priv, SEQ_SET_CC_NORMALLY_BLACK, ARRAY_SIZE(SEQ_SET_CC_NORMALLY_BLACK));
+	panel_write(priv, SEQ_SET_C8_CP, ARRAY_SIZE(SEQ_SET_C8_CP));
+	panel_write(priv, SEQ_SET_BF_GAS, ARRAY_SIZE(SEQ_SET_BF_GAS));
+	panel_write(priv, SEQ_SET_D0_CASCADE, ARRAY_SIZE(SEQ_SET_D0_CASCADE));
+	panel_write(priv, SEQ_SET_BD_BANK01, ARRAY_SIZE(SEQ_SET_BD_BANK01));
+	panel_write(priv, SEQ_SET_D3_GIP1, ARRAY_SIZE(SEQ_SET_D3_GIP1));
+	panel_write(priv, SEQ_SET_BD_BANK02, ARRAY_SIZE(SEQ_SET_BD_BANK02));
+	panel_write(priv, SEQ_SET_B4_GAMMA_BIAS, ARRAY_SIZE(SEQ_SET_B4_GAMMA_BIAS));
+	panel_write(priv, SEQ_SET_BF_VCOM, ARRAY_SIZE(SEQ_SET_BF_VCOM));
+	panel_write(priv, SEQ_SET_D8_GIP, ARRAY_SIZE(SEQ_SET_D8_GIP));
+	panel_write(priv, SEQ_SET_BD_BANK00, ARRAY_SIZE(SEQ_SET_BD_BANK00));
+	panel_write(priv, SEQ_SET_E7_TOUCH_BANK0, ARRAY_SIZE(SEQ_SET_E7_TOUCH_BANK0));
+	panel_write(priv, SEQ_SET_BD_BANK01, ARRAY_SIZE(SEQ_SET_BD_BANK01));
