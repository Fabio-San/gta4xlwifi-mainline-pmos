+static struct drm_display_mode exynos9610_default_mode = {
+	.clock = 171708,
+	.hdisplay = 1200,
+	.hsync_start = 1210,
+	.hsync_end = 1220,
+	.htotal = 1230,
+	.vdisplay = 2000,
+	.vsync_start = 2018,
+	.vsync_end = 2022,
+	.vtotal = 2082,
+	.width_mm = 135,
+	.height_mm = 226,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int exynos9610_parse_mode(struct exynos9610_drm *priv,
+				 struct device_node *np)
+{
+	struct drm_display_mode *mode = &priv->mode;
+	struct device_node *timing;
+	u32 val;
+
+	*mode = exynos9610_default_mode;
+
+	timing = of_get_child_by_name(np, "panel-timing");
+	if (!timing)
+		return 0;
+
+	if (!of_property_read_u32(timing, "clock-frequency", &val))
+		mode->clock = val / 1000;
+	if (!of_property_read_u32(timing, "hactive", &val))
+		mode->hdisplay = val;
+	if (!of_property_read_u32(timing, "hfront-porch", &val))
+		mode->hsync_start = mode->hdisplay + val;
+	if (!of_property_read_u32(timing, "hsync-len", &val))
+		mode->hsync_end = mode->hsync_start + val;
+	if (!of_property_read_u32(timing, "hback-porch", &val))
+		mode->htotal = mode->hsync_end + val;
+	if (!of_property_read_u32(timing, "vactive", &val))
+		mode->vdisplay = val;
+	if (!of_property_read_u32(timing, "vfront-porch", &val))
+		mode->vsync_start = mode->vdisplay + val;
+	if (!of_property_read_u32(timing, "vsync-len", &val))
+		mode->vsync_end = mode->vsync_start + val;
+	if (!of_property_read_u32(timing, "vback-porch", &val))
+		mode->vtotal = mode->vsync_end + val;
+	if (!of_property_read_u32(timing, "hsync-active", &val))
+		mode->flags |= val ? DRM_MODE_FLAG_PHSYNC : DRM_MODE_FLAG_NHSYNC;
+	if (!of_property_read_u32(timing, "vsync-active", &val))
+		mode->flags |= val ? DRM_MODE_FLAG_PVSYNC : DRM_MODE_FLAG_NVSYNC;
+
+	of_node_put(timing);
+	return 0;
+}
