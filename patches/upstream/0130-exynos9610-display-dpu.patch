+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Exynos 9610 (gta4xl) DECON + DSIM + HX83102E AMOLED display driver.
+ *
+ * The register-level sequences are derived from Samsung's downstream
+ * "dpu20" driver for the SM-P615 kernel (GPL-2.0).
+ */
+
+#ifndef __EXYNOS9610_DRM_H__
+#define __EXYNOS9610_DRM_H__
+
+#include <linux/io.h>
+#include <linux/gpio/consumer.h>
+#include <linux/regmap.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_device.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_simple_kms_helper.h>
+
+struct exynos9610_drm;
+
+/* DECON register offsets (relative to the DECON block). */
+#define DECON_GLOBAL_CONTROL		0x0000
+#define DECON_GLOBAL_CONTROL_SRESET	BIT(28)
+#define DECON_GLOBAL_CONTROL_OP_CMD	BIT(8)
+#define DECON_GLOBAL_CONTROL_RUN	BIT(4)
+#define DECON_GLOBAL_CONTROL_DECON_EN	BIT(1)
+#define DECON_GLOBAL_CONTROL_EN_F	BIT(0)
+
+#define DECON_SRAM_SHARE_ENABLE		0x0030
+#define DECON_SRAM0_SHARE		BIT(12)
+#define DECON_SRAM1_SHARE		BIT(16)
+
+#define DECON_INTERRUPT_ENABLE		0x0040
+#define DECON_INT_FRAME_START		BIT(12)
+#define DECON_INT_FRAME_DONE		BIT(13)
+#define DECON_INT_EXTRA			BIT(4)
+#define DECON_INT_EN			BIT(0)
+
+#define DECON_INTERRUPT_PENDING		0x004c
+#define DECON_EXTRA_INT_ENABLE		0x0044
+#define DECON_EXTRA_INT_PENDING		0x0050
+
+#define DECON_SHADOW_UPDATE_REQ		0x0060
+#define DECON_SHADOW_UPDATE_GLOBAL	BIT(31)
+
+#define DECON_HW_SW_TRIG_CONTROL	0x0070
+
+#define DECON_SCALED_SIZE_0		0x00a0
+#define DECON_OUTFIFO_SIZE_0		0x0120
+#define DECON_OUTFIFO_TH_0		0x012c
+#define DECON_BLENDER_BG_SIZE_0		0x0200
+#define DECON_BLENDER_BG_COLOR_0	0x0208
+#define DECON_BLENDER_BG_COLOR_1	0x020c
+#define DECON_DATA_PATH_CONTROL_0	0x0214
+#define DECON_DATA_PATH_CONTROL_1	0x0218
+#define DECON_DSIM_CONNECTION_CONTROL	0x0250
+#define DECON_DATA_PATH_CONTROL_2	0x0230
+#define DECON_OUTFIFO_DATA_ORDER	0x0130
+#define DECON_CLOCK_CONTROL_0		0x00f0
+
+#define DECON_WIN_CONTROL_0(_w)		(0x1000 + ((_w) * 0x30))
+#define DECON_WIN_CONTROL_1(_w)		(DECON_WIN_CONTROL_0(_w) + 0x04)
+#define DECON_WIN_START_POS(_w)		(DECON_WIN_CONTROL_0(_w) + 0x08)
+#define DECON_WIN_END_POS(_w)		(DECON_WIN_CONTROL_0(_w) + 0x0c)
+#define DECON_WIN_START_TIME(_w)	(DECON_WIN_CONTROL_0(_w) + 0x18)
+
+#define DECON_WIN_EN(_w)		BIT(4 * (_w))
+#define DECON_WIN_CHMAP(_w, _ch)	(((_ch) & 0x7) << (4 * (_w)))
+/* PD_FUNC_COPY (1) + ALPHA_MULT_SRC_SEL_AF (2), as used by the bootloader. */
+#define DECON_WIN_COPY			(BIT(8) | 2)
+
+#define DECON_OUTFIFO_TH_1H		0x5
+
+/* DPP / IDMA offsets. idma and dpp are separate 4 KiB register windows. */
+#define IDMA_ENABLE			0x0000
+#define IDMA_IRQ			0x0004
+#define IDMA_IN_CON			0x0008
+#define IDMA_OUT_CON			0x000c
+#define IDMA_SRC_SIZE			0x0010
+#define IDMA_SRC_OFFSET			0x0014
+#define IDMA_IMG_SIZE			0x0018
+#define IDMA_IN_BASE_ADDR_Y		0x0040
+#define IDMA_IN_BASE_ADDR_C		0x0044
+
+#define IDMA_IMG_FORMAT_MASK		(0x3f << 11)
+#define IDMA_IMG_FORMAT_ARGB8888	(0 << 11)
+#define IDMA_ROTATION_MASK		(0x7 << 8)
+#define IDMA_AFBC_EN			BIT(7)
+#define IDMA_BLOCK_EN			BIT(3)
+#define IDMA_OUT_FRAME_ALPHA		0xff
+#define IDMA_OUT_FRAME_ALPHA_MASK	(0xff << 24)
+
+#define DPP_ENABLE			0x0000
+#define DPP_IRQ				0x0004
+#define DPP_IN_CON			0x0008
+#define DPP_IMG_SIZE			0x0018
+
+#define DPP_IMG_FORMAT_MASK		0x7
+#define DPP_IMG_FORMAT_ARGB8888		0
+#define DPP_ALPHA_SEL_MASK		BIT(3)
+#define DPP_ALPHA_SEL_PER_PIXEL		BIT(3)
+#define DPP_ALPHA_SEL_PER_FRAME		0
+
+/* DPP channel used by DECON window 0 on Exynos 9610 (IDMA_G0 -> channel 2). */
+#define DECON_WIN0_DPP_CHANNEL		2
+
+struct exynos9610_drm {
+	struct drm_device drm;
+	struct drm_simple_display_pipe pipe;
+	struct drm_connector connector;
+	struct drm_display_mode mode;
+
+	void __iomem *decon;
+	void __iomem *idma;
+	void __iomem *dpp;
+	void __iomem *dma_com;
+	void __iomem *dsim;
+	void __iomem *sysreg;
+
+	struct regmap *pmu;
+	int decon_irq;
+	int dsim_irq;
+
+	struct gpio_desc *ldo_en;
+	struct gpio_desc *buck_en;
+	struct gpio_desc *panel_reset;
+
+	void __iomem *scanout;
+	phys_addr_t scanout_phys;
+	size_t scanout_size;
+
+	struct backlight_device *backlight;
+
+	bool panel_on;
+	bool vblank_enabled;
+	bool vblank_ready;
+	spinlock_t irq_lock;
+};
+
+int exynos9610_dsi_init(struct exynos9610_drm *priv,
+			const struct drm_display_mode *mode);
+void exynos9610_dsi_start(struct exynos9610_drm *priv);
+void exynos9610_dsi_stop(struct exynos9610_drm *priv);
+int exynos9610_dsi_dcs_write(struct exynos9610_drm *priv, const u8 *data,
+			     size_t len);
+
+int exynos9610_panel_power_on(struct exynos9610_drm *priv);
+void exynos9610_panel_power_off(struct exynos9610_drm *priv);
+void exynos9610_panel_reset(struct exynos9610_drm *priv);
+int exynos9610_panel_init(struct exynos9610_drm *priv);
+int exynos9610_panel_display_on(struct exynos9610_drm *priv);
+void exynos9610_panel_suspend(struct exynos9610_drm *priv);
+int exynos9610_panel_set_brightness(struct exynos9610_drm *priv, int level);
+
+extern int exynos9610_brightness;
+
+#endif /* __EXYNOS9610_DRM_H__ */
--- /dev/null
+++ b/drivers/gpu/drm/exynos9610/exynos9610_drm.c
@@ -0,0 +1,759 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos 9610 (gta4xl) DECON + DPP + DSIM DRM/KMS driver.
+ *
+ * This driver exposes the single display pipeline used by the Galaxy Tab S6
+ * Lite (SM-P615): DECON0 with window 0 fed by DPP G0, and DSIM0 connected to
+ * the 1200x2000 HX83102E AMOLED panel.
+ *
+ * The bootloader leaves this pipeline running with a splash framebuffer, so
+ * the default "takeover" mode keeps the DSIM/panel state set up by firmware
+ * and only takes ownership of the DECON scanout path. Passing full_init=1
+ * additionally powers the panel, programs DSIM video timing and replays the
+ * vendor init sequence.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_print.h>
+#include <drm/drm_gem_shmem_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+#include <drm/drm_vblank.h>
+
+#include "exynos9610_drm.h"
+
+static bool takeover = true;
+module_param(takeover, bool, 0444);
+MODULE_PARM_DESC(takeover,
+		 "Keep the bootloader-initialized DSIM/panel state (default)");
+
+static bool full_init;
+module_param(full_init, bool, 0444);
+MODULE_PARM_DESC(full_init,
+		 "Power-cycle the panel and replay DSIM/panel initialization");
+
+static bool panel_reinit = true;
+module_param(panel_reinit, bool, 0444);
+MODULE_PARM_DESC(panel_reinit,
+		 "Replay the panel power/reset/init sequence but keep firmware DSIM state");
+
+static bool enable_backlight = true;
+module_param(enable_backlight, bool, 0444);
+MODULE_PARM_DESC(enable_backlight, "Register a backlight for the panel");
+
+int exynos9610_brightness = 128;
+module_param_named(brightness, exynos9610_brightness, int, 0644);
+MODULE_PARM_DESC(brightness, "Default panel brightness (0-306)");
+
+static inline struct exynos9610_drm *pipe_to_priv(struct drm_simple_display_pipe *pipe)
+{
+	return container_of(pipe, struct exynos9610_drm, pipe);
+}
+
+static inline void decon_writel(struct exynos9610_drm *priv, u32 reg, u32 val)
+{
+	writel(val, priv->decon + reg);
+}
+
+static inline u32 decon_readl(struct exynos9610_drm *priv, u32 reg)
+{
+	return readl(priv->decon + reg);
+}
+
+static inline void idma_writel(struct exynos9610_drm *priv, u32 reg, u32 val)
+{
+	writel(val, priv->idma + reg);
+}
+
+static inline void dpp_writel(struct exynos9610_drm *priv, u32 reg, u32 val)
+{
+	writel(val, priv->dpp + reg);
+}
+
+static inline void idma_update(struct exynos9610_drm *priv, u32 reg, u32 val,
+			       u32 mask)
+{
+	u32 old = readl(priv->idma + reg);
+
+	writel((old & ~mask) | (val & mask), priv->idma + reg);
+}
+
+static inline void decon_update(struct exynos9610_drm *priv, u32 reg, u32 val,
+				u32 mask)
+{
+	u32 old = decon_readl(priv, reg);
+
+	decon_writel(priv, reg, (old & ~mask) | (val & mask));
+}
+
+static int exynos9610_wait_shadow_done(struct exynos9610_drm *priv)
+{
+	unsigned int i;
+
+	for (i = 0; i < 2000; i++) {
+		if (!(decon_readl(priv, DECON_SHADOW_UPDATE_REQ) &
+		      DECON_SHADOW_UPDATE_GLOBAL))
+			return 0;
+		usleep_range(50, 100);
+	}
+
+	dev_err(priv->drm.dev, "DECON shadow update timed out\n");
+	return -ETIMEDOUT;
+}
+
+static void exynos9610_decon_commit(struct exynos9610_drm *priv)
+{
+	decon_writel(priv, DECON_SHADOW_UPDATE_REQ, DECON_SHADOW_UPDATE_GLOBAL);
+	exynos9610_wait_shadow_done(priv);
+}
+
+/*
+ * Configure DECON for a video-mode DSI output. Exynos 9610's DECON does not
+ * carry pixel timing registers: DSIM generates the video timing, while DECON
+ * only needs the resolution and the data path/window setup.
+ */
+static void exynos9610_decon_configure(struct exynos9610_drm *priv,
+				       const struct drm_display_mode *mode)
+{
+	u32 w = mode->hdisplay;
+	u32 h = mode->vdisplay;
+	u32 size = (h << 16) | w;
+
+	decon_update(priv, DECON_GLOBAL_CONTROL, 0,
+		     DECON_GLOBAL_CONTROL_OP_CMD);
+	decon_writel(priv, DECON_SRAM_SHARE_ENABLE,
+		     DECON_SRAM0_SHARE | DECON_SRAM1_SHARE);
+	decon_writel(priv, DECON_SCALED_SIZE_0, size);
+	decon_writel(priv, DECON_BLENDER_BG_SIZE_0, size);
+	decon_writel(priv, DECON_BLENDER_BG_COLOR_0, 0);
+	decon_writel(priv, DECON_BLENDER_BG_COLOR_1, 0);
+	decon_writel(priv, DECON_OUTFIFO_SIZE_0, size);
+	decon_writel(priv, DECON_OUTFIFO_TH_0, DECON_OUTFIFO_TH_1H);
+	decon_writel(priv, DECON_CLOCK_CONTROL_0, 0);
+	/* No DSC through OUTFIFO0 to DSIMIF0. */
+	decon_writel(priv, DECON_DATA_PATH_CONTROL_2, 0x1);
+	/* DSIM output uses BGR pixel order for RGB888 panels. */
+	decon_writel(priv, DECON_OUTFIFO_DATA_ORDER, 0x40);
+
+	/* DECON0 -> DSIMIF0 -> DSIM0, no DSC, no dual-DSI splitter. */
+	decon_update(priv, DECON_DSIM_CONNECTION_CONTROL, 0, 0x7);
+
+	/* Window 0 comes from DPP channel 2 (G0). */
+	decon_update(priv, DECON_DATA_PATH_CONTROL_1,
+		     DECON_WIN_CHMAP(0, DECON_WIN0_DPP_CHANNEL),
+		     DECON_WIN_CHMAP(0, 0x7));
+	decon_writel(priv, DECON_WIN_CONTROL_0(0), DECON_WIN_COPY);
+	decon_writel(priv, DECON_WIN_CONTROL_1(0), 0);
+	decon_writel(priv, DECON_WIN_START_POS(0), 0);
+	decon_writel(priv, DECON_WIN_END_POS(0),
+		     ((h - 1) << 16) | (w - 1));
+	decon_writel(priv, DECON_WIN_START_TIME(0), 0);
+}
+
+static void exynos9610_dpp_configure(struct exynos9610_drm *priv,
+				     const struct drm_display_mode *mode,
+				     dma_addr_t addr)
+{
+	u32 w = mode->hdisplay;
+	u32 h = mode->vdisplay;
+
+	idma_writel(priv, IDMA_IN_CON, IDMA_IMG_FORMAT_ARGB8888);
+	idma_writel(priv, IDMA_SRC_OFFSET, 0);
+	idma_writel(priv, IDMA_SRC_SIZE, (h << 16) | w);
+	idma_writel(priv, IDMA_IMG_SIZE, (h << 16) | w);
+	idma_writel(priv, IDMA_IN_BASE_ADDR_Y, lower_32_bits(addr));
+	idma_writel(priv, IDMA_IN_BASE_ADDR_C, 0);
+	idma_update(priv, IDMA_OUT_CON,
+		    IDMA_OUT_FRAME_ALPHA << 24,
+		    IDMA_OUT_FRAME_ALPHA_MASK);
+
+	dpp_writel(priv, DPP_IN_CON, DPP_IMG_FORMAT_ARGB8888 |
+		   DPP_ALPHA_SEL_PER_FRAME);
+	dpp_writel(priv, DPP_IMG_SIZE, (h << 16) | w);
+}
+
+static void exynos9610_plane_commit(struct exynos9610_drm *priv,
+				    struct drm_plane_state *state)
+{
+	struct drm_framebuffer *fb = state->fb;
+	struct iosys_map map;
+	void *vaddr;
+	size_t size;
+	int ret;
+
+	if (!fb) {
+		/* Blank the window; DSIM keeps its timing. */
+		decon_update(priv, DECON_DATA_PATH_CONTROL_0, 0, DECON_WIN_EN(0));
+		exynos9610_decon_commit(priv);
+		return;
+	}
+
+	ret = drm_gem_vmap(fb->obj[0], &map);
+	if (ret) {
+		dev_err(priv->drm.dev, "failed to map framebuffer: %d\n", ret);
+		return;
+	}
+	vaddr = map.vaddr;
+
+	size = min_t(size_t, priv->scanout_size,
+		     (size_t)fb->pitches[0] * fb->height);
+	memcpy_toio(priv->scanout, vaddr + fb->offsets[0], size);
+	drm_gem_vunmap(fb->obj[0], &map);
+	wmb();
+
+	exynos9610_dpp_configure(priv, &priv->mode, priv->scanout_phys);
+
+	decon_update(priv, DECON_DATA_PATH_CONTROL_0, DECON_WIN_EN(0),
+		     DECON_WIN_EN(0));
+	exynos9610_decon_commit(priv);
+}
+
+static int exynos9610_pipe_check(struct drm_simple_display_pipe *pipe,
+				 struct drm_plane_state *plane_state,
+				 struct drm_crtc_state *crtc_state)
+{
+	struct drm_framebuffer *fb = plane_state->fb;
+
+	if (!fb)
+		return 0;
+
+	if (fb->pitches[0] != fb->width * 4) {
+		DRM_DEBUG_KMS("unsupported stride %u for %ux%u\n",
+			      fb->pitches[0], fb->width, fb->height);
+		return -EINVAL;
+	}
+
+	if (fb->width != crtc_state->mode.hdisplay ||
+	    fb->height != crtc_state->mode.vdisplay) {
+		DRM_DEBUG_KMS("only full-screen scanout is supported\n");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static void exynos9610_pipe_enable(struct drm_simple_display_pipe *pipe,
+				   struct drm_crtc_state *crtc_state,
+				   struct drm_plane_state *plane_state)
+{
+	struct exynos9610_drm *priv = pipe_to_priv(pipe);
+	int ret;
+
+	drm_mode_copy(&priv->mode, &crtc_state->mode);
+
+	if (panel_reinit && !full_init) {
+		ret = exynos9610_panel_power_on(priv);
+		if (ret)
+			dev_err(priv->drm.dev, "panel power-on failed: %d\n", ret);
+
+		exynos9610_panel_reset(priv);
+		ret = exynos9610_panel_init(priv);
+		if (ret)
+			dev_err(priv->drm.dev, "panel init failed: %d\n", ret);
+		ret = exynos9610_panel_display_on(priv);
+		if (ret)
+			dev_err(priv->drm.dev, "panel display-on failed: %d\n",
+				ret);
+		priv->panel_on = true;
+	}
+
+	if (full_init && !takeover) {
+		ret = exynos9610_panel_power_on(priv);
+		if (ret) {
+			dev_err(priv->drm.dev, "panel power-on failed: %d\n", ret);
+			return;
+		}
+
+		ret = exynos9610_dsi_init(priv, &priv->mode);
+		if (ret) {
+			dev_err(priv->drm.dev, "DSIM init failed: %d\n", ret);
+			return;
+		}
+
+		exynos9610_panel_reset(priv);
+		exynos9610_dsi_start(priv);
+
+		ret = exynos9610_panel_init(priv);
+		if (ret)
+			dev_err(priv->drm.dev, "panel init failed: %d\n", ret);
+
+		ret = exynos9610_panel_display_on(priv);
+		if (ret)
+			dev_err(priv->drm.dev, "panel display-on failed: %d\n",
+				ret);
+
+		priv->panel_on = true;
+	}
+
+	exynos9610_decon_configure(priv, &priv->mode);
+
+	/* Enable the DECON and wait for the pipeline to report running. */
+	decon_update(priv, DECON_GLOBAL_CONTROL,
+		     DECON_GLOBAL_CONTROL_DECON_EN |
+		     DECON_GLOBAL_CONTROL_EN_F,
+		     DECON_GLOBAL_CONTROL_DECON_EN |
+		     DECON_GLOBAL_CONTROL_EN_F);
+
+	decon_writel(priv, DECON_INTERRUPT_PENDING,
+		     DECON_INT_FRAME_START | DECON_INT_FRAME_DONE);
+	decon_update(priv, DECON_INTERRUPT_ENABLE,
+		     DECON_INT_EN | DECON_INT_FRAME_START |
+		     DECON_INT_FRAME_DONE | DECON_INT_EXTRA,
+		     DECON_INT_EN | DECON_INT_FRAME_START |
+		     DECON_INT_FRAME_DONE | DECON_INT_EXTRA);
+
+	exynos9610_decon_commit(priv);
+
+	exynos9610_plane_commit(priv, plane_state);
+
+	drm_crtc_vblank_on(&pipe->crtc);
+}
+
+static void exynos9610_pipe_disable(struct drm_simple_display_pipe *pipe)
+{
+	struct exynos9610_drm *priv = pipe_to_priv(pipe);
+
+	drm_crtc_vblank_off(&pipe->crtc);
+	decon_update(priv, DECON_DATA_PATH_CONTROL_0, 0, DECON_WIN_EN(0));
+	exynos9610_decon_commit(priv);
+}
+
+static void exynos9610_pipe_update(struct drm_simple_display_pipe *pipe,
+				   struct drm_plane_state *old_state)
+{
+	struct exynos9610_drm *priv = pipe_to_priv(pipe);
+
+	if (pipe->plane.state->fb)
+		exynos9610_plane_commit(priv, pipe->plane.state);
+}
+
+static int exynos9610_pipe_enable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct exynos9610_drm *priv = pipe_to_priv(pipe);
+	unsigned long flags;
+
+	spin_lock_irqsave(&priv->irq_lock, flags);
+	decon_writel(priv, DECON_INTERRUPT_PENDING,
+		     DECON_INT_FRAME_START | DECON_INT_FRAME_DONE);
+	decon_update(priv, DECON_INTERRUPT_ENABLE,
+		     DECON_INT_FRAME_START | DECON_INT_FRAME_DONE |
+		     DECON_INT_EN,
+		     DECON_INT_FRAME_START | DECON_INT_FRAME_DONE |
+		     DECON_INT_EN);
+	priv->vblank_enabled = true;
+	spin_unlock_irqrestore(&priv->irq_lock, flags);
+
+	return 0;
+}
+
+static void exynos9610_pipe_disable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct exynos9610_drm *priv = pipe_to_priv(pipe);
+	unsigned long flags;
+
+	/*
+	 * Keep the frame interrupts enabled. The DECON pending register is
+	 * write-one-to-clear and re-arming it from the vblank put path races
+	 * with the display engine, so this driver gates vblanks in the DRM
+	 * core rather than in hardware.
+	 */
+	spin_lock_irqsave(&priv->irq_lock, flags);
+	priv->vblank_enabled = false;
+	spin_unlock_irqrestore(&priv->irq_lock, flags);
+}
+
+static enum drm_mode_status
+exynos9610_pipe_mode_valid(struct drm_simple_display_pipe *pipe,
+			   const struct drm_display_mode *mode)
+{
+	struct exynos9610_drm *priv = pipe_to_priv(pipe);
+
+	return drm_crtc_helper_mode_valid_fixed(&pipe->crtc, mode,
+						&priv->mode);
+}
+
+static const struct drm_simple_display_pipe_funcs exynos9610_pipe_funcs = {
+	.mode_valid = exynos9610_pipe_mode_valid,
+	.enable = exynos9610_pipe_enable,
+	.disable = exynos9610_pipe_disable,
+	.check = exynos9610_pipe_check,
+	.update = exynos9610_pipe_update,
+	.enable_vblank = exynos9610_pipe_enable_vblank,
+	.disable_vblank = exynos9610_pipe_disable_vblank,
+};
+
+static irqreturn_t exynos9610_decon_irq(int irq, void *data)
+{
+	struct exynos9610_drm *priv = data;
+	u32 pending;
+	bool vblank = false;
+
+	spin_lock(&priv->irq_lock);
+
+	pending = decon_readl(priv, DECON_INTERRUPT_PENDING);
+	if (pending) {
+		decon_writel(priv, DECON_INTERRUPT_PENDING, pending);
+		if (pending & (DECON_INT_FRAME_START |
+			       DECON_INT_FRAME_DONE))
+			vblank = true;
+	}
+
+	pending = decon_readl(priv, DECON_EXTRA_INT_PENDING);
+	if (pending)
+		decon_writel(priv, DECON_EXTRA_INT_PENDING, pending);
+
+	spin_unlock(&priv->irq_lock);
+
+	if (vblank && priv->vblank_ready) {
+		struct drm_crtc *crtc = &priv->pipe.crtc;
+		unsigned long flags;
+
+		drm_crtc_handle_vblank(crtc);
+
+		spin_lock_irqsave(&crtc->dev->event_lock, flags);
+		if (crtc->state->event) {
+			drm_crtc_send_vblank_event(crtc, crtc->state->event);
+			crtc->state->event = NULL;
+		}
+		spin_unlock_irqrestore(&crtc->dev->event_lock, flags);
+	}
+
+	return IRQ_HANDLED;
+}
