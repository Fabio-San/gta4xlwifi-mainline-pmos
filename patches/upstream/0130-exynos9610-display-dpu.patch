+
+int exynos9610_panel_display_on(struct exynos9610_drm *priv)
+{
+	panel_write(priv, SEQ_SET_B9_PW, ARRAY_SIZE(SEQ_SET_B9_PW));
+	panel_write(priv, SEQ_DISPLAY_ON, ARRAY_SIZE(SEQ_DISPLAY_ON));
+	panel_write(priv, SEQ_SET_B9_CLOSE_PW, ARRAY_SIZE(SEQ_SET_B9_CLOSE_PW));
+	msleep(30);
+
+	return exynos9610_panel_set_brightness(priv, exynos9610_brightness);
+}
+
+void exynos9610_panel_suspend(struct exynos9610_drm *priv)
+{
+	panel_write(priv, SEQ_SET_B9_PW, ARRAY_SIZE(SEQ_SET_B9_PW));
+	panel_write(priv, SEQ_DISPLAY_OFF, ARRAY_SIZE(SEQ_DISPLAY_OFF));
+	panel_write(priv, SEQ_SET_E9_VSOM_SOFT1, ARRAY_SIZE(SEQ_SET_E9_VSOM_SOFT1));
+	panel_write(priv, SEQ_SET_BF_VSOM_SOFT, ARRAY_SIZE(SEQ_SET_BF_VSOM_SOFT));
+	panel_write(priv, SEQ_SET_E9_VSOM_SOFT2, ARRAY_SIZE(SEQ_SET_E9_VSOM_SOFT2));
+	panel_write(priv, SEQ_SLEEP_IN, ARRAY_SIZE(SEQ_SLEEP_IN));
+	panel_write(priv, SEQ_SET_B9_CLOSE_PW, ARRAY_SIZE(SEQ_SET_B9_CLOSE_PW));
+}
+
+int exynos9610_panel_set_brightness(struct exynos9610_drm *priv, int level)
+{
+	u8 bl[3];
+
+	level = clamp(level, 0, EXTEND_BRIGHTNESS);
+	bl[0] = 0x51;
+	bl[1] = (brightness_table[level] >> 8) & 0xf;
+	bl[2] = brightness_table[level] & 0xff;
+
+	return panel_write(priv, bl, sizeof(bl));
+}
