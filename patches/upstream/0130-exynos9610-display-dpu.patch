+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos 9610 DSIM0 and HX83102E AMOLED panel support for gta4xl.
+ *
+ * Register sequences and panel init data are ported from Samsung's downstream
+ * dpu20 driver (drivers/video/fbdev/exynos/dpu20) for the SM-P615 kernel.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+
