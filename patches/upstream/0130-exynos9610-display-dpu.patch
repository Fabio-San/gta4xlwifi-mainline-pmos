+static int exynos9610_drm_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct exynos9610_drm *priv;
+	struct drm_device *drm;
+	struct resource *res;
+	u32 scanout_phys, scanout_size;
+	int ret;
+
+	priv = devm_drm_dev_alloc(dev, &exynos9610_drm_driver,
+				  struct exynos9610_drm, drm);
+	if (IS_ERR(priv))
+		return PTR_ERR(priv);
+	drm = &priv->drm;
+	platform_set_drvdata(pdev, priv);
+	spin_lock_init(&priv->irq_lock);
+
+	priv->decon = devm_platform_ioremap_resource_byname(pdev, "decon");
+	if (IS_ERR(priv->decon))
+		return PTR_ERR(priv->decon);
+
+	priv->idma = devm_platform_ioremap_resource_byname(pdev, "idma");
+	if (IS_ERR(priv->idma))
+		return PTR_ERR(priv->idma);
+
+	priv->dpp = devm_platform_ioremap_resource_byname(pdev, "dpp");
+	if (IS_ERR(priv->dpp))
+		return PTR_ERR(priv->dpp);
+
+	priv->dsim = devm_platform_ioremap_resource_byname(pdev, "dsim");
+	if (IS_ERR(priv->dsim))
+		return PTR_ERR(priv->dsim);
+
+	priv->sysreg = devm_platform_ioremap_resource_byname(pdev, "sysreg");
+	if (IS_ERR(priv->sysreg))
+		return PTR_ERR(priv->sysreg);
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dma-common");
+	if (res) {
+		priv->dma_com = devm_ioremap_resource(dev, res);
+		if (IS_ERR(priv->dma_com))
+			return PTR_ERR(priv->dma_com);
+	}
+
+	ret = of_property_read_u32_index(dev->of_node, "samsung,scanout", 0,
+					 &scanout_phys);
+	if (ret) {
+		/* Fall back to the bootloader splash framebuffer. */
+		scanout_phys = 0xca000000;
+		scanout_size = 0x960000;
+	} else {
+		of_property_read_u32_index(dev->of_node, "samsung,scanout", 1,
+					   &scanout_size);
+	}
+	priv->scanout_phys = scanout_phys;
+	priv->scanout_size = scanout_size;
+	priv->scanout = devm_ioremap_wc(dev, scanout_phys, scanout_size);
+	if (!priv->scanout)
+		return -ENOMEM;
+
+	priv->pmu = syscon_regmap_lookup_by_phandle(dev->of_node,
+						   "samsung,pmu-syscon");
+	if (IS_ERR(priv->pmu)) {
+		dev_warn(dev, "no PMU syscon, DSIM PHY isolation is not managed\n");
+		priv->pmu = NULL;
+	}
+
+	priv->ldo_en = devm_gpiod_get_optional(dev, "ldo-en", GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->ldo_en))
+		return dev_err_probe(dev, PTR_ERR(priv->ldo_en),
+				     "failed to get panel LDO enable\n");
+
+	priv->buck_en = devm_gpiod_get_optional(dev, "buck-en", GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->buck_en))
+		return dev_err_probe(dev, PTR_ERR(priv->buck_en),
+				     "failed to get panel buck enable\n");
+
+	priv->panel_reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->panel_reset))
+		return dev_err_probe(dev, PTR_ERR(priv->panel_reset),
+				     "failed to get panel reset\n");
+
+	priv->decon_irq = platform_get_irq(pdev, 0);
+	if (priv->decon_irq < 0)
+		return priv->decon_irq;
+
+	priv->dsim_irq = platform_get_irq(pdev, 1);
+
+	ret = exynos9610_parse_mode(priv, dev->of_node);
+	if (ret)
+		return ret;
+
+	drm->mode_config.min_width = priv->mode.hdisplay;
+	drm->mode_config.max_width = priv->mode.hdisplay;
+	drm->mode_config.min_height = priv->mode.vdisplay;
+	drm->mode_config.max_height = priv->mode.vdisplay;
+	drm->mode_config.preferred_depth = 24;
+	drm->mode_config.funcs = &exynos9610_mode_config_funcs;
+
+	ret = drm_mode_config_init(drm);
+	if (ret)
+		return ret;
+
+	ret = drm_connector_init(drm, &priv->connector,
+				 &exynos9610_connector_funcs,
+				 DRM_MODE_CONNECTOR_DSI);
+	if (ret)
+		return ret;
+	drm_connector_helper_add(&priv->connector,
+				 &exynos9610_connector_helpers);
+	priv->connector.display_info.width_mm = priv->mode.width_mm;
+	priv->connector.display_info.height_mm = priv->mode.height_mm;
+
+	ret = drm_simple_display_pipe_init(drm, &priv->pipe,
+					   &exynos9610_pipe_funcs,
+					   exynos9610_formats,
+					   ARRAY_SIZE(exynos9610_formats),
+					   NULL, &priv->connector);
+	if (ret)
+		return ret;
+
+	drm_mode_config_reset(drm);
+
+	ret = devm_request_irq(dev, priv->decon_irq, exynos9610_decon_irq,
+			       IRQF_SHARED, "exynos9610-decon", priv);
+	if (ret) {
+		dev_warn(dev, "DECON IRQ unavailable (%d), vblank disabled\n",
+			 ret);
+		priv->decon_irq = -1;
+	}
+
+	ret = drm_vblank_init(drm, drm->mode_config.num_crtc);
+	if (ret)
+		return ret;
+	priv->vblank_ready = true;
+
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		return ret;
+
+	drm_kms_helper_poll_init(drm);
+
+	if (enable_backlight) {
+		struct backlight_properties props = {
+			.type = BACKLIGHT_RAW,
+			.max_brightness = 306,
+			.brightness = clamp(exynos9610_brightness, 0, 306),
+		};
+
+		priv->backlight = devm_backlight_device_register(dev, "panel",
+								 dev, priv,
+								 &exynos9610_backlight_ops,
+								 &props);
+		if (IS_ERR(priv->backlight)) {
+			ret = PTR_ERR(priv->backlight);
+			priv->backlight = NULL;
+			dev_warn(dev, "backlight registration failed: %d\n", ret);
+		}
+	}
+
+	dev_info(dev, "Exynos 9610 display ready: %ux%u%s\n",
+		 priv->mode.hdisplay, priv->mode.vdisplay,
+		 (full_init && !takeover) ? " (full panel init)" :
+		 panel_reinit ? " (panel reinit)" : " (takeover)");
+
+	return 0;
+}
+
+static void exynos9610_drm_remove(struct platform_device *pdev)
+{
+	struct exynos9610_drm *priv = platform_get_drvdata(pdev);
+
+	drm_kms_helper_poll_fini(&priv->drm);
+	drm_atomic_helper_shutdown(&priv->drm);
+	drm_dev_unregister(&priv->drm);
+}
