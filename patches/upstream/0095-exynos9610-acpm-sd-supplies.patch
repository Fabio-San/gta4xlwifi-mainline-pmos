+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/firmware/samsung,exynos9610-acpm-ipc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9610 ACPM firmware interface
+
+maintainers:
+  - linux-samsung-soc@vger.kernel.org
+
+description: |
+  ACPM firmware exposes a PMIC protocol through mailbox doorbells and SRAM
+  queues. The Exynos9610 channel table starts at SRAM offset 0x6f00.
+
+properties:
+  compatible:
+    const: samsung,exynos9610-acpm-ipc
+
+  mboxes:
+    maxItems: 1
+
+  shmem:
+    maxItems: 1
+
+  pmic:
+    $ref: /schemas/regulator/samsung,s2mpu09.yaml#
+
+required:
+  - compatible
+  - mboxes
+  - shmem
+
+additionalProperties: false
