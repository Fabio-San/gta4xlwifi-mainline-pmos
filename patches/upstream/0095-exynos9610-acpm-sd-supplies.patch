+$id: http://devicetree.org/schemas/regulator/samsung,s2mpu09.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MPU09 microSD power supplies
+
+maintainers:
+  - linux-samsung-soc@vger.kernel.org
+
+description: |
+  Initial support for LDO2 and LDO35 through ACPM channel 2, Speedy channel 0.
+  Other PMIC functions are left under firmware control.
+
+properties:
+  compatible:
+    const: samsung,s2mpu09-pmic
+
+  regulators:
+    type: object
+    additionalProperties: false
+    properties:
+      ldo2:
+        $ref: regulator.yaml#
+        unevaluatedProperties: false
+      ldo35:
+        $ref: regulator.yaml#
+        unevaluatedProperties: false
+    required:
+      - ldo2
+      - ldo35
+
+required:
+  - compatible
+  - regulators
+
+additionalProperties: false
