--- /dev/null
+++ b/drivers/regulator/s2mpu09-acpm.c
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * S2MPU09 microSD supplies, transported through the ACPM PMIC protocol.
+ * Register definitions and voltage tables from Samsung's 2016 S2MPU09 driver.
+ */
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+
+#define S2MPU09_ACPM_CHANNEL	2
+#define S2MPU09_PMIC_BANK		1
+#define S2MPU09_SPEEDY_CHANNEL	0
+#define S2MPU09_LDO2_CTRL		0x3a
+#define S2MPU09_LDO35_CTRL		0x5c
+#define S2MPU09_ENABLE_MASK	GENMASK(7, 6)
+#define S2MPU09_VSEL_MASK		GENMASK(5, 0)
+
+static int s2mpu09_read(void *context, unsigned int reg, unsigned int *val)
+{
+	struct acpm_handle *acpm = context;
+	u8 data;
+	int ret;
+
+	ret = acpm->ops->pmic.read_reg(acpm, S2MPU09_ACPM_CHANNEL,
+		S2MPU09_PMIC_BANK, reg, S2MPU09_SPEEDY_CHANNEL, &data);
+	if (!ret)
+		*val = data;
+	return ret;
+}
+
+static int s2mpu09_write(void *context, unsigned int reg, unsigned int val)
+{
+	struct acpm_handle *acpm = context;
+
+	return acpm->ops->pmic.write_reg(acpm, S2MPU09_ACPM_CHANNEL,
+		S2MPU09_PMIC_BANK, reg, S2MPU09_SPEEDY_CHANNEL, val);
+}
+
+static int s2mpu09_update(void *context, unsigned int reg,
+			  unsigned int mask, unsigned int val)
+{
+	struct acpm_handle *acpm = context;
+
+	return acpm->ops->pmic.update_reg(acpm, S2MPU09_ACPM_CHANNEL,
+		S2MPU09_PMIC_BANK, reg, S2MPU09_SPEEDY_CHANNEL, val, mask);
+}
+
+static const struct regmap_bus s2mpu09_bus = {
+	.reg_read = s2mpu09_read,
+	.reg_write = s2mpu09_write,
+	.reg_update_bits = s2mpu09_update,
+};
+
+static bool s2mpu09_accessible_reg(struct device *dev, unsigned int reg)
+{
+	return reg == S2MPU09_LDO2_CTRL || reg == S2MPU09_LDO35_CTRL;
+}
+
+static const struct regmap_config s2mpu09_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = S2MPU09_LDO35_CTRL,
+	.readable_reg = s2mpu09_accessible_reg,
+	.writeable_reg = s2mpu09_accessible_reg,
+};
+
+static const struct regulator_ops s2mpu09_ldo_ops = {
+	.list_voltage = regulator_list_voltage_linear,
+	.map_voltage = regulator_map_voltage_linear,
+	.get_voltage_sel = regulator_get_voltage_sel_regmap,
+	.set_voltage_sel = regulator_set_voltage_sel_regmap,
+	.is_enabled = regulator_is_enabled_regmap,
+	.enable = regulator_enable_regmap,
+	.disable = regulator_disable_regmap,
+};
+
+#define S2MPU09_LDO(_id, _reg) { \
+	.name = "LDO" #_id, \
+	.of_match = "ldo" #_id, \
+	.regulators_node = "regulators", \
+	.id = _id, \
+	.ops = &s2mpu09_ldo_ops, \
+	.type = REGULATOR_VOLTAGE, \
+	.owner = THIS_MODULE, \
+	.min_uV = 1800000, \
+	.uV_step = 25000, \
+	.n_voltages = 64, \
+	.vsel_reg = _reg, \
+	.vsel_mask = S2MPU09_VSEL_MASK, \
+	.enable_reg = _reg, \
+	.enable_mask = S2MPU09_ENABLE_MASK, \
+	.enable_time = 128, \
+}
+
+static const struct regulator_desc s2mpu09_regulators[] = {
+	S2MPU09_LDO(2, S2MPU09_LDO2_CTRL),
+	S2MPU09_LDO(35, S2MPU09_LDO35_CTRL),
+};
+
+static int s2mpu09_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct regulator_config config = { .dev = dev };
+	struct acpm_handle *acpm;
+	struct regulator_dev *rdev;
+	int i, ret;
+	u8 chip_id;
+
+	acpm = devm_acpm_get_by_node(dev, dev->parent->of_node);
+	if (IS_ERR(acpm))
+		return dev_err_probe(dev, PTR_ERR(acpm), "ACPM unavailable\n");
+
+	ret = acpm->ops->pmic.read_reg(acpm, S2MPU09_ACPM_CHANNEL, 0, 0,
+				     S2MPU09_SPEEDY_CHANNEL, &chip_id);
+	if (ret)
+		return dev_err_probe(dev, ret, "PMIC identification failed\n");
+
+	config.regmap = devm_regmap_init(dev, &s2mpu09_bus, acpm,
+					&s2mpu09_regmap_config);
+	if (IS_ERR(config.regmap))
+		return PTR_ERR(config.regmap);
+
+	for (i = 0; i < ARRAY_SIZE(s2mpu09_regulators); i++) {
+		rdev = devm_regulator_register(dev, &s2mpu09_regulators[i], &config);
+		if (IS_ERR(rdev))
+			return dev_err_probe(dev, PTR_ERR(rdev),
+					     "LDO registration failed\n");
+	}
+	dev_info(dev, "S2MPU09 revision %#x, SD supplies registered\n", chip_id);
+	return 0;
+}
+
+static const struct of_device_id s2mpu09_of_match[] = {
+	{ .compatible = "samsung,s2mpu09-pmic" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s2mpu09_of_match);
+
+static struct platform_driver s2mpu09_driver = {
+	.probe = s2mpu09_probe,
+	.driver = {
+		.name = "s2mpu09-acpm-regulator",
+		.of_match_table = s2mpu09_of_match,
+	},
+};
+module_platform_driver(s2mpu09_driver);
+
+MODULE_DESCRIPTION("Samsung S2MPU09 microSD supplies over ACPM");
+MODULE_LICENSE("GPL");
